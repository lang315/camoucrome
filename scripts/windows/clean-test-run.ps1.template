# Runs inside Windows Sandbox. C:\in is read-only: the README blocks (install-N[-name].ps1,
# quickstart.py) and assets\ (the release files the Mac staged). C:\out is writable.
# Nothing here is improvised: it runs only README blocks, each under $ErrorActionPreference='Stop'.
$T = 'C:\out\transcript.txt'
$sw = [Diagnostics.Stopwatch]::StartNew()
function Log($s) { $s | Out-File -FilePath $T -Append -Encoding ascii }
function Step($name, [scriptblock]$body) {
  Log "=== BEGIN $name"
  $global:LASTEXITCODE = 0
  $rc = 0
  try {
    $ErrorActionPreference = 'Stop'
    $o = & $body 2>&1 | Out-String
    if ($global:LASTEXITCODE -ne 0) { $rc = $global:LASTEXITCODE }
  } catch { $o = "EXCEPTION: $_"; $rc = 1 }
  $ErrorActionPreference = 'Continue'
  Log $o.TrimEnd()
  Log "=== END $name rc=$rc"
}
function RefreshPath { $env:Path = [Environment]::GetEnvironmentVariable('Path','Machine') + ';' + [Environment]::GetEnvironmentVariable('Path','User') }
New-Item -ItemType Directory -Force -Path 'C:\work' | Out-Null
Set-Location 'C:\work'
$ProgressPreference = 'SilentlyContinue'
if (Test-Path 'C:\in\assets') { Copy-Item 'C:\in\assets\*' 'C:\work' }  # the staged download

$blocks = Get-ChildItem 'C:\in' -Filter 'install-*.ps1' | Sort-Object { [int](($_.BaseName -split '-')[1]) }
foreach ($f in $blocks) {
  $p = $f.FullName
  Step $f.BaseName { . $p }
  RefreshPath
}

# README Quickstart: save the block as quickstart.py and run it as the README says.
Step 'quickstart' {
  Copy-Item 'C:\in\quickstart.py' .
  .venv\Scripts\python quickstart.py
}
Log "RUN_DONE elapsed=$([int]$sw.Elapsed.TotalSeconds)"
