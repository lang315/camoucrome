# Camoucrome required GN build args
#
# The arguments a Camoucrome build MUST set beyond Chromium's defaults for
# behavioural parity with the Chrome the fork claims. NOT a full args.gn — a
# developer adds their own dev conveniences (is_component_build, symbol_level,
# out dir, etc.). Consumed manually today: append these to your
# out/<dir>/args.gn and re-run `gn gen`. The SP6 build/packaging pipeline will
# consume this file directly once built.

# --- SP7: codec parity ---
# RESOLVED 2026-08-27 (docs/superpowers/specs/00-conventions.md, SP7 D2);
# APPLIED + VERIFIED 2026-09-02 (scripts/verify_sp7_codecs.py: C1 canPlayType
# H.264/AAC -> "probably", C2 MSE.isTypeSupported -> true, C3 functional H.264
# decode of bear.mp4 (videoWidth 320), C4 no regression -- all PASS).
#
# A fork claiming Chrome that cannot decode H.264/AAC is caught by any page that
# LOADS the media rather than merely asks about it. Stock Chromium ships
# ffmpeg_branding="Chromium" (no proprietary decoders); these two args build the
# real decoders so canPlayType/isTypeSupported/decodingInfo AND actual playback
# match Chrome -- coherently, not as a Blink lie (a lie diverges on real
# playback, a worse tell).
proprietary_codecs = true
ffmpeg_branding = "Chrome"

# --- DISTRIBUTION LICENSING: OPEN, deliberately (SP7 D2 part 2) ---
# Enabling proprietary_codecs for a LOCAL build is settled. DISTRIBUTING the
# resulting binaries carries H.264/AAC patent-pool obligations that Google's
# Chrome licence does NOT extend to third-party builds. That is a legal/business
# decision -- not a technical one -- to settle before SP6 ships anything. This
# file does not resolve it.

# --- Widevine: stays absent + honest (do NOT enable) ---
# enable_widevine is a GN arg, but the CDM is a binary distributed separately;
# no flag produces a working one. requestMediaKeySystemAccess must remain real
# (SP4 was scoped to leave it alone). Do NOT set enable_widevine=true expecting
# a working CDM -- that would be a spoof the build cannot honour.

# --- SP7: field-trial testing config (SP7 §4.2 / D3, resolved 2026-08-27) ---
# An unbranded build applies testing/variations/fieldtrial_testing_config.json at
# startup; real Chrome does not. That puts the fork's feature state at a third
# position matching neither seeded nor default Chrome, and the testing config is
# a public per-milestone file. Compile it out (FIELDTRIAL_TESTING_ENABLED=0,
# components/variations/service/BUILD.gn) so the position is a property of the
# binary, not of whether a driver remembered --disable-field-trial-config.
# content_shell applies the config too (content/test/setup_field_trials.cc,
# linked via //content/test:test_support), so this is verified on the dev
# target: scripts/verify_sp7_fieldtrial.py (F1 VLOG count 0, F2 exit code 1 on
# --enable-field-trial-config). Measurement:
# docs/superpowers/measurements/2026-09-09-sp7-fieldtrial-config.md.
# The seed fetch needs no arg: IsFetchingEnabled() is false in a non-branded
# build unless --variations-server-url is passed -- a driver must never pass it
# (it would also flip the testing-config answer back on in a build that still
# has it).
disable_fieldtrial_testing_config = true
