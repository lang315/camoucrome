+namespace {
+// SP2d: one cursor per tab, shared by every DevTools session on it and kept
+// across navigation and reconnection (spec section 3). In screen space, the
+// space of blink::WebMouseEvent::PositionInScreen() for CDP-created events
+// (Task 1 spike: CURSOR_SPACE=screen).
+struct CamouCursorState : public base::SupportsUserData::Data {
+  gfx::PointF position;
+};
+const void* const kCamouCursorStateKey = &kCamouCursorStateKey;
+}  // namespace
+
+gfx::RectF InputHandler::CursorBounds() {
+  RenderWidgetHostViewBase* root = GetRootView();
+  if (!root) {
+    return gfx::RectF();
+  }
+  // CURSOR_SPACE=screen (Task 1 spike): the root view's bounds in screen space.
+  return gfx::RectF(root->GetViewBounds());
+}
+
+gfx::PointF InputHandler::CursorPathStart(const blink::WebMouseEvent& e) {
+  const gfx::Vector2dF offset = e.PositionInScreen() - e.PositionInWidget();
+  const gfx::RectF bounds = CursorBounds();
+  auto* state = static_cast<CamouCursorState*>(
+      web_contents_->GetUserData(kCamouCursorStateKey));
+  gfx::PointF p;
+  if (state) {
+    p = state->position;
+    if (!bounds.IsEmpty()) {
+      p.SetToMax(bounds.origin());
+      p.SetToMin(bounds.bottom_right() - gfx::Vector2dF(1, 1));
+    }
+  } else {
+    p = bounds.origin() +
+        camoucfg::EdgeEntryPoint(bounds.width(), bounds.height(),
+                                 base::RandDouble(), base::RandDouble(),
+                                 base::RandDouble())
+            .OffsetFromOrigin();
+  }
+  return p - offset;
+}
+
+void InputHandler::RecordCursor(const blink::WebMouseEvent& e) {
+  auto* state = static_cast<CamouCursorState*>(
+      web_contents_->GetUserData(kCamouCursorStateKey));
+  if (!state) {
+    auto owned = std::make_unique<CamouCursorState>();
+    state = owned.get();
+    web_contents_->SetUserData(kCamouCursorStateKey, std::move(owned));
+  }
+  state->position = e.PositionInScreen();
+}
+
 }  // namespace content::protocol
