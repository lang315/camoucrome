+// Answers the wrapped command, then tells the InputHandler its move is done.
+// Also runs `done` if destroyed unanswered, so the queue can never wait on it.
+class HumanizedMoveAck : public Input::Backend::DispatchMouseEventCallback {
+ public:
+  HumanizedMoveAck(
+      std::unique_ptr<Input::Backend::DispatchMouseEventCallback> inner,
+      base::OnceClosure done)
+      : inner_(std::move(inner)), done_(std::move(done)) {}
+  ~HumanizedMoveAck() override { Done(); }
+  void sendSuccess() override {
+    inner_->sendSuccess();
+    Done();
+  }
+  void sendFailure(const DispatchResponse& response) override {
+    inner_->sendFailure(response);
+    Done();
+  }
+  void fallThrough() override {
+    inner_->fallThrough();
+    Done();
+  }
+
+ private:
+  void Done() {
+    if (done_) {
+      std::move(done_).Run();
+    }
+  }
+  std::unique_ptr<Input::Backend::DispatchMouseEventCallback> inner_;
+  base::OnceClosure done_;
+};
+
+}  // namespace
+
+InputHandler::HumanizedMouseEvent::HumanizedMouseEvent() = default;
+InputHandler::HumanizedMouseEvent::~HumanizedMouseEvent() = default;
+
+void InputHandler::EnqueueHumanizedMouseEvent(
+    std::unique_ptr<blink::WebMouseEvent> event,
+    bool stamp_on_fire,
+    std::unique_ptr<DispatchMouseEventCallback> callback) {
+  auto item = std::make_unique<HumanizedMouseEvent>();
+  item->event = std::move(event);
+  item->stamp_on_fire = stamp_on_fire;
+  item->callback = std::move(callback);
+  humanized_mouse_queue_.push_back(std::move(item));
+  if (!humanized_drain_posted_) {
+    DrainHumanizedMouseQueue();
+  }
+}
+
+base::TimeTicks InputHandler::HumanizedReadyAt(const blink::WebMouseEvent& e) {
+  using Type = blink::WebInputEvent::Type;
+  const std::optional<uint32_t> seed = camoucfg::GetUint32(
+      camoucfg::GlobalScope(), camoucfg::keys::kHumanizeSeed);
+  if (e.GetType() == Type::kMouseDown && last_humanized_type_ == Type::kMouseMove &&
+      !last_move_forwarded_at_.is_null()) {
+    const double ms = std::min(
+        camoucfg::SampleKnots(camoucfg::kDwellMsKnots, base::RandDouble()) *
+            camoucfg::ProfileScale(seed, camoucfg::ProfileSalt::kDwell),
+        camoucfg::kMaxDwellMs);
+    return last_move_forwarded_at_ + base::Milliseconds(ms);
+  }
+  if (e.GetType() == Type::kMouseUp) {
+    auto it = press_forwarded_at_.find(static_cast<int>(e.button));
+    if (it != press_forwarded_at_.end()) {
+      const double ms = std::min(
+          camoucfg::SampleKnots(camoucfg::kHoldMsKnots, base::RandDouble()) *
+              camoucfg::ProfileScale(seed, camoucfg::ProfileSalt::kHold),
+          camoucfg::kMaxHoldMs);
+      return it->second + base::Milliseconds(ms);
+    }
+  }
+  return base::TimeTicks();  // ready now
+}
+
+void InputHandler::DrainHumanizedMouseQueue() {
+  using Type = blink::WebInputEvent::Type;
+  humanized_drain_posted_ = false;
+  while (!humanized_mouse_queue_.empty()) {
+    if (humanized_move_pending_) {
+      return;  // OnHumanizedMoveDone resumes
+    }
+    HumanizedMouseEvent& front = *humanized_mouse_queue_.front();
+    if (!front.ready_at) {
+      front.ready_at = HumanizedReadyAt(*front.event);  // drawn once per event
+    }
+    const base::TimeTicks now = base::TimeTicks::Now();
+    if (*front.ready_at > now) {
+      humanized_drain_posted_ = true;
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+          FROM_HERE,
+          base::BindOnce(&InputHandler::DrainHumanizedMouseQueue,
+                         weak_factory_.GetWeakPtr()),
+          *front.ready_at - now);
+      return;
+    }
+    std::unique_ptr<HumanizedMouseEvent> item =
+        std::move(humanized_mouse_queue_.front());
+    humanized_mouse_queue_.pop_front();
+    if (item->stamp_on_fire) {
+      item->event->SetTimeStamp(now);
+    }
+    const Type type = item->event->GetType();
+    const int button = static_cast<int>(item->event->button);
+    if (type == Type::kMouseDown) {
+      press_forwarded_at_[button] = now;
+    } else if (type == Type::kMouseUp) {
+      press_forwarded_at_.erase(button);
+    }
+    last_humanized_type_ = type;
+    if (type == Type::kMouseMove) {
+      // A move whose final step is never forwarded (a drag takes it, the
+      // widget is gone) is still answered or dropped, which releases the gate;
+      // the timer bounds anything else so input cannot stall.
+      constexpr base::TimeDelta kMoveGateFallback = base::Seconds(2);
+      humanized_move_pending_ = true;
+      const uint64_t gen = ++humanized_move_gen_;
+      item->callback = std::make_unique<HumanizedMoveAck>(
+          std::move(item->callback),
+          base::BindOnce(&InputHandler::ReleaseHumanizedMove,
+                         weak_factory_.GetWeakPtr(), gen));
+      base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+          FROM_HERE,
+          base::BindOnce(&InputHandler::ReleaseHumanizedMove,
+                         weak_factory_.GetWeakPtr(), gen),
+          kMoveGateFallback);
+    }
+    HandleMouseEvent(std::move(item->event), std::move(item->callback));
+  }
+}
+
+void InputHandler::ReleaseHumanizedMove(uint64_t gen) {
+  if (!humanized_move_pending_ || gen != humanized_move_gen_) {
+    return;
+  }
+  humanized_move_pending_ = false;
+  // Posted: this runs inside InputInjector::Cleanup's loop over its pending
+  // callbacks and inside ForwardMouseEventNow, and a drain there would
+  // dispatch into the injector that is being iterated.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&InputHandler::DrainHumanizedMouseQueue,
+                                weak_factory_.GetWeakPtr()));
+}
+
+void InputHandler::FailHumanizedMouseQueue() {
+  humanized_move_pending_ = false;
+  ++humanized_move_gen_;
+  while (!humanized_mouse_queue_.empty()) {
+    humanized_mouse_queue_.front()->callback->sendFailure(
+        Response::InternalError());
+    humanized_mouse_queue_.pop_front();
+  }
+}
