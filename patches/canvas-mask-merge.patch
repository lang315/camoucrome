+void Canvas2DRecorderContext::CamouOverdrawn() {
+  // Camoucrome overdraw elision (R3-v2): nothing queued without canvas:seed.
+  const size_t jobs =
+      camou_mask_.pending_events() + camou_mask_.parked_events();
+  if (jobs == 0) {
+    return;
+  }
+  TRACE_EVENT_INSTANT1("blink", "CamouElided", TRACE_EVENT_SCOPE_THREAD,
+                       "jobs", static_cast<int>(jobs));
+  camou_mask_.Reset();
+}
