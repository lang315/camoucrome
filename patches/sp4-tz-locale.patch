 #include "third_party/blink/public/platform/platform.h"
 #include "third_party/blink/public/web/blink.h"
 #include "third_party/blink/renderer/bindings/core/v8/binding_security.h"
@@ -48,6 +53,7 @@
 #include "third_party/blink/renderer/core/html_names.h"
 #include "third_party/blink/renderer/core/html_tokenizer_names.h"
 #include "third_party/blink/renderer/core/input_type_names.h"
+#include "third_party/blink/renderer/core/inspector/locale_controller.h"
 #include "third_party/blink/renderer/core/keywords.h"
 #include "third_party/blink/renderer/core/lcp_critical_path_predictor/element_locator.h"
 #include "third_party/blink/renderer/core/mathml_names.h"
@@ -172,6 +178,64 @@ void CoreInitializer::Initialize() {
 
   TimeZoneController::Init();
 
+  // SP4-timezone/locale: drive the native timezone/locale overrides from
+  // CAMOU_CONFIG so a standalone (non-CDP) launch is coherent, incl. workers.
+  {
+    const camoucfg::ConfigScope& camou_scope = camoucfg::ScopeFor(nullptr);
+    if (std::optional<std::string> tz =
+            camoucfg::GetString(camou_scope, camoucfg::keys::kTimezoneId);
+        tz && !tz->empty()) {
+      auto result =
+          TimeZoneController::SetTimeZoneOverride(String::FromUtf8(*tz));
+      if (result.status ==
+          TimeZoneController::TimeZoneOverrideStatus::kInvalidTimezone) {
+        // Fail closed: a configured zone exists because the host's must not
+        // show, so a broken one becomes UTC rather than the real zone.
+        LOG(WARNING) << "camoucfg: timezone:id '" << *tz
+                     << "' invalid; falling back to UTC";
+        result = TimeZoneController::SetTimeZoneOverride(String("UTC"));
+      }
+      // Keep the RAII handle alive for the whole process (never clear).
+      static base::NoDestructor<
+          std::unique_ptr<TimeZoneController::TimeZoneOverride>>
+          kTimeZoneHandle(std::move(result.handle));
+    }
+    // Candidates in priority order; navigator.language is languages[0] when
+    // only the list is set, and Intl must follow the same head.
+    std::vector<std::pair<const char*, std::string>> candidates;
+    if (std::optional<std::string> l =
+            camoucfg::GetString(camou_scope, camoucfg::keys::kLocaleTag);
+        l && !l->empty()) {
+      candidates.emplace_back("locale:tag", *l);
+    }
+    if (std::optional<std::string> nl = camoucfg::GetString(
+            camou_scope, camoucfg::keys::kNavigatorLanguage);
+        nl && !nl->empty()) {
+      candidates.emplace_back("navigator.language", *nl);
+    }
+    if (std::vector<std::string> langs = camoucfg::GetStringList(
+            camou_scope, camoucfg::keys::kNavigatorLanguages);
+        !langs.empty()) {
+      candidates.emplace_back("navigator.languages[0]", langs.front());
+    }
+    bool accepted = false;
+    for (const auto& [key, locale] : candidates) {
+      String locale_error = LocaleController::instance().SetLocaleOverride(
+          String::FromUtf8(locale), /*is_claiming_override=*/true);
+      if (locale_error.empty()) {
+        accepted = true;
+        break;
+      }
+      LOG(WARNING) << "camoucfg: " << key << " '" << locale
+                   << "' rejected: " << locale_error.Utf8().c_str();
+    }
+    if (!candidates.empty() && !accepted) {
+      LOG(WARNING) << "camoucfg: no locale accepted; falling back to en-US";
+      LocaleController::instance().SetLocaleOverride(
+          String("en-US"), /*is_claiming_override=*/true);
+    }
+  }
+
   FontGlobalContext::Init();
 
   CSSDefaultStyleSheets::Init();
