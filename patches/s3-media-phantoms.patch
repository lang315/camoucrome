+// camoucrome S3: the identity's claimed media devices that the host lacks.
+// Never written to current_snapshot_, so getUserMedia and the picker keep the
+// real list; the enumerate reply, devicechange and output authorization
+// (S3b) apply this same function. Phantoms go in before translation, so
+// Chrome's own permission gating, deviceId HMAC and per-document groupId salt
+// apply to them. A kind gets one phantom device when its raw list is empty
+// and its count is above 0. Inactive mediaDevices (not enabled, or no seed)
+// leaves the enumeration untouched (rule 5).
+MediaDeviceEnumeration CamouWithPhantoms(const MediaDeviceEnumeration& real) {
+  MediaDeviceEnumeration out = real;
+  const camoucfg::ConfigScope& scope = camoucfg::GlobalScope();
+  if (camoucfg::ActiveMediaDevicesSeed(scope) == 0) {
+    return out;
+  }
+  struct Kind {
+    MediaDeviceType type;
+    const char* name;
+    const char* count_key;
+    uint32_t count_default;
+    const char* label_key;
+    const char* label_default;
+  };
+  // Label defaults are shared with sp4-media and media-ii-track.
+  static constexpr Kind kKinds[] = {
+      {MediaDeviceType::kMediaAudioInput, "audioinput",
+       camoucfg::keys::kMediaDevicesMicros, 3,
+       camoucfg::keys::kMediaDevicesMicrophoneLabel,
+       camoucfg::kDefaultMicrophoneLabel},
+      {MediaDeviceType::kMediaVideoInput, "videoinput",
+       camoucfg::keys::kMediaDevicesWebcams, 1,
+       camoucfg::keys::kMediaDevicesCameraLabel,
+       camoucfg::kDefaultCameraLabel},
+      {MediaDeviceType::kMediaAudioOutput, "audiooutput",
+       camoucfg::keys::kMediaDevicesSpeakers, 1,
+       camoucfg::keys::kMediaDevicesSpeakerLabel,
+       camoucfg::kDefaultSpeakerLabel},
+  };
+#if BUILDFLAG(IS_WIN)
+  constexpr bool kWindows = true;
+  const std::string communications =
+      media::AudioDeviceDescription::GetCommunicationsDeviceName();
+#else
+  constexpr bool kWindows = false;
+  const std::string communications;
+#endif
+  for (const Kind& kind : kKinds) {
+    blink::WebMediaDeviceInfoArray& list =
+        out[static_cast<size_t>(kind.type)];
+    if (!list.empty() ||
+        camoucfg::GetUint32(scope, kind.count_key)
+                .value_or(kind.count_default) == 0) {
+      continue;
+    }
+    const std::string label =
+        camoucfg::GetString(scope, kind.label_key).value_or(kind.label_default);
+    for (const camoucfg::PhantomDevice& p : camoucfg::PhantomDevicesFor(
+             kind.name, label, kWindows,
+             media::AudioDeviceDescription::GetDefaultDeviceName(),
+             communications)) {
+      list.emplace_back(p.device_id, p.label, p.group_id);
+    }
+  }
+  return out;
+}
