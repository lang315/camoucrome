diff --git a/services/data_decoder/public/mojom/camou_observe_decoder.mojom b/services/data_decoder/public/mojom/camou_observe_decoder.mojom
new file mode 100644
index 0000000000..cce22f4879
--- /dev/null
+++ b/services/data_decoder/public/mojom/camou_observe_decoder.mojom
@@ -0,0 +1,22 @@
+// Copyright 2026 The Camoucrome Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+module data_decoder.mojom;
+
+import "mojo/public/mojom/base/big_buffer.mojom";
+
+// The tracking observer's decoder (docs/observer/README.md). The trace holds
+// bytes a page sent: untrusted, so it is parsed only here.
+// Every document the recorded tab committed while recording
+// (components/camoucfg/observe_tables.h TabKey).
+struct CamouObserveTabKey {
+  array<string> top_sites;
+  array<string> top_frame_ids;
+};
+
+interface CamouObserveDecoder {
+  // tables_json is the JSON described in components/camoucfg/observe_tables.h.
+  Decode(mojo_base.mojom.BigBuffer trace, mojo_base.mojom.BigBuffer trace_stats,
+         string truth_json, CamouObserveTabKey tab) => (string tables_json);
+};
