+// Copyright 2026 The Camoucrome Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "services/data_decoder/camou_observe_decoder_impl.h"
+
+#include <utility>
+
+#include "base/containers/span.h"
+#include "components/camoucfg/observe_tables.h"
+
+namespace data_decoder {
+
+void CamouObserveDecoderImpl::Decode(mojo_base::BigBuffer trace,
+                                     mojo_base::BigBuffer trace_stats,
+                                     const std::string& truth_json,
+                                     mojom::CamouObserveTabKeyPtr tab,
+                                     DecodeCallback callback) {
+  std::move(callback).Run(camoucfg::observe::DecodeTables(
+      base::span(trace), base::span(trace_stats), truth_json,
+      {std::move(tab->top_sites), std::move(tab->top_frame_ids)}));
+}
+
+}  // namespace data_decoder
