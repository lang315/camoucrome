+// A WebSocket message. origin, site and script derive exactly as in
+// EmitListener. The kept bytes are copied from what Blink already holds.
+void EmitWebSocketSend(ExecutionContext* context,
+                       const KURL& url,
+                       bool binary,
+                       base::span<const uint8_t> data) {
+  if (!context) {
+    return;
+  }
+  constexpr size_t kMaxBytes = 256 * 1024;
+  std::string origin;
+  std::string site;
+  if (const SecurityOrigin* security_origin = context->GetSecurityOrigin()) {
+    origin = security_origin->ToString().Utf8();
+  }
+  if (auto* window = DynamicTo<LocalDOMWindow>(context)) {
+    site = window->GetStorageKey().GetTopLevelSite().Serialize().Utf8();
+  }
+  v8::Isolate* isolate = context->GetIsolate();
+  v8::HandleScope handle_scope(isolate);
+  std::string script;
+  v8::Local<v8::String> v8_script =
+      v8::StackTrace::CurrentScriptNameOrSourceURL(isolate);
+  if (!v8_script.IsEmpty()) {
+    script.resize(v8_script->Utf8LengthV2(isolate));
+    v8_script->WriteUtf8V2(isolate, script.data(), script.size());
+  }
+  std::string endpoint = url.Host().ToString().Utf8();
+  if (url.HasPort()) {
+    endpoint += ":" + std::to_string(url.Port());
+  }
+  endpoint += url.GetPath().ToString().Utf8();
+  const bool cut = data.size() > kMaxBytes;
+  TRACE_EVENT_INSTANT(
+      TRACE_DISABLED_BY_DEFAULT("camou.observe.send"), "camou.send.ws",
+      "endpoint", endpoint, "site", site, "origin", origin, "script", script,
+      "opcode", binary ? "2" : "1", "size", std::to_string(data.size()), "b64",
+      base::Base64Encode(data.first(std::min(data.size(), kMaxBytes))), "cut",
+      cut ? "1" : "");
+}
