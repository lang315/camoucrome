-  // WebGL: opaque pixels only, no coverage mask: as CamouNoised() on a WebGL
-  // context.
-  sk_sp<SkImage> noised = camoucfg::NoisedCanvasImage(
-      *sk_image, scope, /*min_alpha=*/255, camoucfg::NoiseMask(),
-      image->Orientation() == ImageOrientationEnum::kOriginBottomLeft,
-      camoucfg::NoiseDomain::kWebGl);
+  // As CamouNoised() does on the context that made the pixels.
+  return camoucfg::NoisedCanvasImage(
+      *sk_image, scope, min_alpha, mask,
+      image->Orientation() == ImageOrientationEnum::kOriginBottomLeft, domain);
+}
