+
+scoped_refptr<const CamouFrameNoise>
+CanvasRenderingContext::CamouMakeFrameNoise() {
+  if (!Host() ||
+      !camoucfg::CanvasSeed(
+          camoucfg::ScopeFor(Host()->GetTopExecutionContext()))) {
+    camou_frame_noise_ = nullptr;
+    return nullptr;
+  }
+  if (CamouFrameIsPendingWebGl()) {
+    // The frame copies raw WebGL pixels: the WebGL field, opaque pixels, no mask.
+    if (!camou_pending_noise_) {
+      auto pending = base::MakeRefCounted<CamouFrameNoise>();
+      pending->domain = camoucfg::NoiseDomain::kWebGl;
+      pending->min_alpha = 255;
+      camou_pending_noise_ = std::move(pending);
+    }
+    return camou_pending_noise_;
+  }
+  const uint64_t revision = CamouNoiseRevision();
+  if (camou_frame_noise_ && camou_frame_noise_revision_ == revision) {
+    return camou_frame_noise_;
+  }
+  // A frame is committed at the rate the page draws: the queued recordings of a
+  // 2D mask are not walked here (the walk is the cost of a heavy scene), the
+  // frame carries a copy of them and the page's read walks them.
+  scoped_refptr<const camoucfg::DeferredMask> deferred;
+  const auto status = CamouDeferNoiseMask(camou_mask_snapshot_.get(), &deferred);
+  const char* status_name = "none";
+  switch (status) {
+    case camoucfg::LazyCanvasNoiseMask::DeferStatus::kNone:
+      break;
+    case camoucfg::LazyCanvasNoiseMask::DeferStatus::kDeferred:
+      status_name = "deferred";
+      break;
+    case camoucfg::LazyCanvasNoiseMask::DeferStatus::kOverCap:
+      status_name = "over_cap";
+      break;
+    case camoucfg::LazyCanvasNoiseMask::DeferStatus::kNotClonable:
+      status_name = "not_clonable";
+      break;
+  }
+  TRACE_EVENT_INSTANT2("blink", "CamouFrameNoise", TRACE_EVENT_SCOPE_THREAD,
+                       "defer", status_name, "jobs",
+                       deferred ? static_cast<int>(deferred->jobs()) : 0);
+  {
+    const camoucfg::LazyCanvasNoiseMask::Counters counters =
+        CamouNoiseCounters();
+    TRACE_EVENT_INSTANT2("blink", "CamouParked", TRACE_EVENT_SCOPE_THREAD,
+                         "parked", static_cast<int>(counters.parked_total),
+                         "evicted", static_cast<int>(counters.parked_evicted));
+  }
+  auto noise = base::MakeRefCounted<CamouFrameNoise>();
+  noise->domain = CamouNoiseDomain();
+  noise->min_alpha = CamouNoiseMinAlpha();
+  if (deferred) {
+    noise->deferred = std::move(deferred);
+    if (noise->deferred->base()) {
+      camou_mask_snapshot_ = noise->deferred->base();
+    }
+  } else {
+    if (!CamouNoiseEligible()) {
+      camou_frame_noise_ = nullptr;
+      return nullptr;
+    }
+    noise->mask = CamouNoiseMaskSnapshot(camou_mask_snapshot_.get());
+    camou_mask_snapshot_ = noise->mask;
+  }
+  camou_frame_noise_ = noise;
+  camou_frame_noise_revision_ = revision;
+  return noise;
+}
+
+// static
+sk_sp<SkImage> CanvasRenderingContext::CamouNoisedFrame(
+    scoped_refptr<StaticBitmapImage> image,
+    const CamouFrameNoise& noise,
+    CamouReplayMemo* memo) {
+  if (noise.deferred) {
+    // The queue the worker left unapplied, walked now, here: nothing in the walk
+    // belongs to the worker's thread. A frame that continues the last one's walk
+    // (same canvas, nothing walked past it) walks only its new recordings, on the
+    // memo's mask. A mask with no aa cell is the mask of a context that is not
+    // eligible, which commits no record: the frame as it is.
+    std::unique_ptr<camoucfg::CanvasNoiseMask> local;
+    const camoucfg::CanvasNoiseMask* mask = nullptr;
+    const char* mode = "full";
+    size_t stepped = noise.deferred->jobs();
+    {
+      TRACE_EVENT1("blink", "CamouDeferredReplay", "jobs",
+                   static_cast<int>(noise.deferred->jobs()));
+      if (memo && memo->mask &&
+          noise.deferred->Continue(*memo->mask, memo->epoch, memo->id,
+                                   &stepped)) {
+        mode = "continue";
+        mask = memo->mask.get();
+      } else if (memo) {
+        memo->mask = noise.deferred->Replay();
+        mask = memo->mask.get();
+      } else {
+        local = noise.deferred->Replay();
+        mask = local.get();
+      }
+    }
+    if (!mask) {
+      // A recording that cannot be copied again (Defer() copied it once: not
+      // expected). No mask is guessed and nothing is CHECKed: the frame is read
+      // as it is.
+      if (memo) {
+        memo->mask.reset();
+      }
+      return nullptr;
+    }
+    if (memo) {
+      memo->epoch = noise.deferred->epoch();
+      memo->id = noise.deferred->last_id();
+    }
+    TRACE_EVENT_INSTANT2("blink", "CamouReplayMode", TRACE_EVENT_SCOPE_THREAD,
+                         "mode", mode, "stepped", static_cast<int>(stepped));
+    if (!mask->has_aa()) {
+      return nullptr;
+    }
+    return CamouNoisedSkImage(std::move(image), noise.min_alpha, mask->view(),
+                              noise.domain);
+  }
+  // The page reads this frame: the chunks as one contiguous mask, once.
+  std::vector<uint8_t> cells;
+  camoucfg::NoiseMask mask;
+  if (noise.mask) {
+    cells = noise.mask->Flatten();
+    mask = noise.mask->ViewOf(cells);
+  }
+  return CamouNoisedSkImage(std::move(image), noise.min_alpha, mask,
+                            noise.domain);
+}
+
+void CanvasRenderingContext::CamouFrameRead(uint64_t id) {
+  CamouNoteSeen(id);
+  const camoucfg::LazyCanvasNoiseMask::Counters counters =
+      CamouNoiseCounters();
+  TRACE_EVENT_INSTANT2("blink", "CamouFrameRead", TRACE_EVENT_SCOPE_THREAD,
+                       "id", static_cast<int>(id), "signals",
+                       static_cast<int>(counters.signals));
+  TRACE_EVENT_INSTANT2("blink", "CamouParkedWalk", TRACE_EVENT_SCOPE_THREAD,
+                       "walked", static_cast<int>(counters.parked_walked),
+                       "seen", static_cast<int>(counters.seen_walked));
+}
