+scoped_refptr<StaticBitmapImage> HTMLCanvasElement::CamouPlaceholderBitmap()
+    const {
+  ExportedCanvasResource* frame = OffscreenCanvasFrame();
+  if (!frame) {
+    return nullptr;
+  }
+  const CamouFrameNoise* noise = frame->CamouNoise();
+  // The noised pixels are made once per frame; every read wraps them anew. A
+  // frame the noise found nothing to change in is not tried again.
+  if (noise) {
+    if (sk_sp<SkImage> cached = CamouCachedNoisedFrame()) {
+      return UnacceleratedStaticBitmapImage::Create(
+          std::move(cached), CamouCachedOrientation());
+    }
+    if (CamouFrameIsRaw()) {
+      return frame->Bitmap();
+    }
+  }
+  scoped_refptr<StaticBitmapImage> image = frame->Bitmap();
+  if (!noise || !image) {
+    return image;
+  }
+  if (noise->deferred) {
+    // The page is reading these recordings: the worker walks, not drops, them
+    // from now on. Told before the replay, which can take the main thread long
+    // enough for the worker to shed a window's worth of them.
+    CamouSignalFrameRead(noise->deferred->last_id());
+  }
+  sk_sp<SkImage> noised =
+      CanvasRenderingContext::CamouNoisedFrame(image, *noise, &CamouMemo());
+  if (!noised) {
+    SetCamouFrameRaw();
+    return image;
+  }
+  SetCamouCachedNoisedFrame(noised, image->Orientation());
+  return UnacceleratedStaticBitmapImage::Create(std::move(noised),
+                                                image->Orientation());
+}
