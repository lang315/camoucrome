+  scoped_refptr<StaticBitmapImage> image = frame->Bitmap();
+  if (!noise || !image) {
+    return image;
+  }
+  sk_sp<SkImage> noised = CanvasRenderingContext::CamouNoisedFrame(image, *noise);
+  if (!noised) {
+    return image;
+  }
+  SetCamouCachedNoisedFrame(noised, image->Orientation());
+  return UnacceleratedStaticBitmapImage::Create(std::move(noised),
+                                                image->Orientation());
+}
