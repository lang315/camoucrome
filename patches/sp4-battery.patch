 bool BatteryManager::charging() {
+  if (std::optional<bool> v = camoucfg::GetBool(
+          camoucfg::ScopeFor(GetExecutionContext()),
+          camoucfg::keys::kBatteryCharging)) {
+    return *v;
+  }
   return battery_status_.Charging();
 }
 
 double BatteryManager::chargingTime() {
+  if (std::optional<double> v = camoucfg::GetDouble(
+          camoucfg::ScopeFor(GetExecutionContext()),
+          camoucfg::keys::kBatteryChargingTime)) {
+    return *v;
+  }
+  // Derived, not configured: a battery that is not charging reports
+  // chargingTime Infinity (spec), which JSON config cannot express. Without
+  // this a configured charging:false kept the host's 0 -- "not charging, full
+  // in 0 s", a combination no real battery reports.
+  if (camoucfg::GetBool(camoucfg::ScopeFor(GetExecutionContext()),
+                        camoucfg::keys::kBatteryCharging) == false) {
+    return std::numeric_limits<double>::infinity();
+  }
   return battery_status_.charging_time().InSecondsF();
 }
 
 double BatteryManager::dischargingTime() {
+  if (std::optional<double> v = camoucfg::GetDouble(
+          camoucfg::ScopeFor(GetExecutionContext()),
+          camoucfg::keys::kBatteryDischargingTime)) {
+    return *v;
+  }
+  // Derived: a charging battery reports dischargingTime Infinity (spec).
+  if (camoucfg::GetBool(camoucfg::ScopeFor(GetExecutionContext()),
+                        camoucfg::keys::kBatteryCharging) == true) {
+    return std::numeric_limits<double>::infinity();
+  }
   return battery_status_.discharging_time().InSecondsF();
 }
 
 double BatteryManager::level() {
+  if (std::optional<double> v = camoucfg::GetDouble(
+          camoucfg::ScopeFor(GetExecutionContext()),
+          camoucfg::keys::kBatteryLevel)) {
+    return *v;
+  }
   return battery_status_.Level();
 }
 
