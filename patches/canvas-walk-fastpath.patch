+// The exact device area of a fill of a pixel-aligned rect, when the coverage
+// raster is known without running it: the rect is drawn plainly (no stroke,
+// path effect, colour filter, image filter or looper), the matrix
+// scales and translates, the mapped edges are whole pixels, and the clip is a
+// plain rect. The raster then covers exactly that area at 255 and nothing
+// else, so marking the area directly gives the cells Merge() of that raster
+// gives (CanvasNoiseMaskTest.ExactAreaMarkEqualsMergeOfFullCoverage). False
+// whenever any of this is unsure: the op is then rastered as before.
+bool CamouAlignedRectArea(const cc::PaintOp& op,
+                          const cc::PaintFlags& flags,
+                          const SkCanvas& canvas,
+                          SkIRect* area) {
+  SkRect local;
+  if (op.GetType() == cc::PaintOpType::kDrawRect) {
+    local = static_cast<const cc::DrawRectOp&>(op).rect;
+  } else if (op.GetType() == cc::PaintOpType::kDrawIRect) {
+    local = SkRect::Make(static_cast<const cc::DrawIRectOp&>(op).rect);
+  } else {
+    return false;
+  }
+  if (flags.getStyle() != cc::PaintFlags::kFill_Style || flags.getPathEffect() ||
+      flags.getColorFilter() || flags.getImageFilter() ||
+      flags.getLooper() || !local.isSorted() || !canvas.isClipRect()) {
+    return false;
+  }
+  const SkMatrix matrix = canvas.getTotalMatrix();
+  if (!matrix.isScaleTranslate()) {
+    return false;
+  }
+  const SkRect device = matrix.mapRect(local);
+  // Skia draws a rect past its fixed-point range as a path: leave those to the raster.
+  constexpr SkScalar kLimit = 32767;
+  auto whole = [](SkScalar v) {
+    return v == SkScalarFloorToScalar(v) && v > -kLimit && v < kLimit;
+  };
+  if (!whole(device.left()) || !whole(device.top()) || !whole(device.right()) ||
+      !whole(device.bottom())) {
+    return false;
+  }
+  SkIRect r = device.roundOut();
+  *area = r.intersect(canvas.getDeviceClipBounds()) ? r : SkIRect::MakeEmpty();
+  return true;
+}
