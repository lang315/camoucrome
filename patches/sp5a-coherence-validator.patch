+// Whether `key` -- a member of camoucfg::keys::kUaMetadataKeys -- has a
+// value this build can actually read, not merely whether the key is
+// present. camoucfg::HasKey() is type-blind: {"ua:wow64":"no"} makes
+// HasKey() true even though GetBool() rejects the string and camoucfg falls
+// back to the real value, so a presence check built on HasKey() would warn
+// about a configuration that changed nothing -- or, for a key that expects a
+// string, wrongly suppress a warning that should have fired. Dispatches by
+// key type exactly as ConfigPresentsUserAgentIdentity does in
+// user_agent_utils.cc: kUaMobile and kUaWow64 are the two booleans, every
+// other ua: key is a string.
+bool UaMetadataKeyHasValue(std::string_view key) {
+  if (key == camoucfg::keys::kUaMobile || key == camoucfg::keys::kUaWow64) {
+    return camoucfg::GetBool(camoucfg::GlobalScope(), key).has_value();
+  }
+  return camoucfg::GetString(camoucfg::GlobalScope(), key).has_value();
+}
