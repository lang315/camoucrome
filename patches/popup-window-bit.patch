@@ -0,0 +1,45 @@
+// Copyright 2026 The Camoucrome Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/core/page/camou_popup.h"
+
+#include "third_party/blink/public/web/camou_popup.h"
+#include "third_party/blink/renderer/core/exported/web_view_impl.h"
+#include "third_party/blink/renderer/core/page/page.h"
+#include "third_party/blink/renderer/platform/heap/garbage_collected.h"
+#include "third_party/blink/renderer/platform/supplementable.h"
+
+namespace blink {
+
+namespace {
+
+class CamouPopupMarker final : public GarbageCollected<CamouPopupMarker>,
+                               public Supplement<Page> {
+ public:
+  static const char kSupplementName[];
+
+  explicit CamouPopupMarker(Page& page) : Supplement<Page>(page) {}
+
+  void Trace(Visitor* visitor) const override {
+    Supplement<Page>::Trace(visitor);
+  }
+};
+
+const char CamouPopupMarker::kSupplementName[] = "CamouPopupMarker";
+
+}  // namespace
+
+bool IsCamouPopupPage(const Page& page) {
+  return Supplement<Page>::From<CamouPopupMarker>(page) != nullptr;
+}
+
+void CamouMarkPopupView(WebView* view) {
+  Page* page = To<WebViewImpl>(view)->GetPage();
+  if (page && !IsCamouPopupPage(*page)) {
+    Supplement<Page>::ProvideTo(*page,
+                                MakeGarbageCollected<CamouPopupMarker>(*page));
+  }
+}
+
+}  // namespace blink
