+// Copyright 2026 The Camoucrome Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_PUBLIC_WEB_CAMOU_POPUP_H_
+#define THIRD_PARTY_BLINK_PUBLIC_WEB_CAMOU_POPUP_H_
+
+#include "third_party/blink/public/platform/web_common.h"
+
+namespace blink {
+
+class WebView;
+
+// Marks the view's page as belonging to a WebContents opened as a popup. The
+// browser sends the bit in CreateViewParams to every view of that WebContents,
+// so a popup in a new process (noopener, a cross-site navigation, a cross-site
+// iframe) knows what the opener's renderer knew from its window features.
+// Deliberately separate from Page::SetWindowFeatures: BarProp
+// (window.menubar.visible) reads those and must stay as stock.
+BLINK_EXPORT void CamouMarkPopupView(WebView* view);
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_PUBLIC_WEB_CAMOU_POPUP_H_
