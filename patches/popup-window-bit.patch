+
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_PAGE_CAMOU_POPUP_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_PAGE_CAMOU_POPUP_H_
+
+#include "third_party/blink/renderer/core/core_export.h"
+
+namespace blink {
+
+class Page;
+
+// True when the browser marked this page's WebContents as a popup
+// (CamouMarkPopupView). Independent of Page::GetWindowFeatures().
+CORE_EXPORT bool IsCamouPopupPage(const Page& page);
+
+}  // namespace blink
