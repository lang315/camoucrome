diff --git a/third_party/blink/renderer/core/execution_context/camou_observe.cc b/third_party/blink/renderer/core/execution_context/camou_observe.cc
new file mode 100644
index 0000000000..58e30e2648
--- /dev/null
+++ b/third_party/blink/renderer/core/execution_context/camou_observe.cc
@@ -0,0 +1,61 @@
+// Copyright 2026 The Camoucrome Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/core/execution_context/camou_observe.h"
+
+#include <string>
+
+#include "third_party/blink/renderer/core/execution_context/execution_context.h"
+#include "third_party/blink/renderer/core/frame/local_dom_window.h"
+#include "third_party/blink/renderer/platform/weborigin/security_origin.h"
+#include "v8/include/v8-context.h"
+#include "v8/include/v8-debug.h"
+#include "v8/include/v8-isolate.h"
+#include "v8/include/v8-local-handle.h"
+#include "v8/include/v8-primitive.h"
+
+#if BUILDFLAG(CAMOU_OBSERVE)
+
+namespace blink::camou_observe {
+
+// Runs from both slow and fast ([NoAllocDirectCall]) callbacks. Only reached
+// with the category enabled, so the context lookup and the string
+// work below never run in an ordinary session. `site` is the top-level site for
+// a window; worker scopes have no StorageKey accessor at this pin, so it stays
+// empty and the report groups worker reads by origin (a dedicated worker's is
+// its creator's). `script` is the URL of the script at the top of the stack
+// (an inline script reports its document's URL; no script, or eval without a
+// sourceURL, reports an empty string).
+void Emit(const char* name, v8::Isolate* isolate) {
+  // A [NoAllocDirectCall] fast callback may have no HandleScope open.
+  v8::HandleScope handle_scope(isolate);
+  v8::Local<v8::Context> v8_context = isolate->GetCurrentContext();
+  ExecutionContext* context =
+      v8_context.IsEmpty() ? nullptr : ExecutionContext::From(v8_context);
+  std::string origin;
+  std::string site;
+  if (context) {
+    if (const SecurityOrigin* security_origin = context->GetSecurityOrigin()) {
+      origin = security_origin->ToString().Utf8();
+    }
+    if (auto* window = DynamicTo<LocalDOMWindow>(context)) {
+      site = window->GetStorageKey().GetTopLevelSite().Serialize().Utf8();
+    }
+  }
+  // Copied without ToCoreString, which may externalize the V8 string: Emit
+  // also runs inside fast API calls, where the V8 heap must not change.
+  std::string script;
+  v8::Local<v8::String> v8_script =
+      v8::StackTrace::CurrentScriptNameOrSourceURL(isolate);
+  if (!v8_script.IsEmpty()) {
+    script.resize(v8_script->Utf8LengthV2(isolate));
+    v8_script->WriteUtf8V2(isolate, script.data(), script.size());
+  }
+  TRACE_EVENT_INSTANT(CAMOU_OBSERVE_CATEGORY, perfetto::StaticString(name),
+                      "origin", origin, "site", site, "script", script);
+}
+
+}  // namespace blink::camou_observe
+
+#endif  // BUILDFLAG(CAMOU_OBSERVE)
diff --git a/third_party/blink/renderer/core/execution_context/camou_observe.h b/third_party/blink/renderer/core/execution_context/camou_observe.h
new file mode 100644
index 0000000000..7e55ad8668
--- /dev/null
+++ b/third_party/blink/renderer/core/execution_context/camou_observe.h
@@ -0,0 +1,45 @@
+// Copyright 2026 The Camoucrome Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_EXECUTION_CONTEXT_CAMOU_OBSERVE_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_EXECUTION_CONTEXT_CAMOU_OBSERVE_H_
+
+#include "third_party/blink/renderer/core/core_export.h"
+#include "third_party/blink/renderer/platform/bindings/buildflags.h"
+#include "third_party/blink/renderer/platform/instrumentation/tracing/trace_event.h"
+
+namespace v8 {
+class Isolate;
+}  // namespace v8
+
+// Tracking observer (docs/observer/README.md). Generated bindings call
+// Record() with the current isolate at the entry of every allow-listed Web IDL
+// member. It emits one trace event only when the build sets camou_observe =
+// true AND a trace has enabled this disabled-by-default category; otherwise it
+// is one category check (flag on) or nothing at all (flag off). The execution
+// context is resolved inside Emit() only, so a callback gains no context lookup
+// it would not make in a stock build. Nothing page-visible changes.
+#define CAMOU_OBSERVE_CATEGORY TRACE_DISABLED_BY_DEFAULT("camou.observe")
+
+namespace blink {
+namespace camou_observe {
+
+#if BUILDFLAG(CAMOU_OBSERVE)
+CORE_EXPORT void Emit(const char* name, v8::Isolate* isolate);
+
+inline void Record(const char* name, v8::Isolate* isolate) {
+  bool enabled = false;
+  TRACE_EVENT_CATEGORY_GROUP_ENABLED(CAMOU_OBSERVE_CATEGORY, &enabled);
+  if (enabled) [[unlikely]] {
+    Emit(name, isolate);
+  }
+}
+#else
+inline void Record(const char*, v8::Isolate*) {}
+#endif
+
+}  // namespace camou_observe
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_EXECUTION_CONTEXT_CAMOU_OBSERVE_H_
