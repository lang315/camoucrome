 #include "third_party/blink/renderer/core/execution_context/execution_context.h"
 #include "third_party/blink/renderer/core/frame/local_dom_window.h"
@@ -56,6 +57,58 @@ void Emit(const char* name, v8::Isolate* isolate) {
                       "origin", origin, "site", site, "script", script);
 }
 
+// The registering context is the target's own, not the isolate's current one, so a
+// registration made from C++ (no script on the stack) still has an origin and site.
+// A null context (a target with none) emits nothing.
+void EmitListener(const char* name,
+                  ExecutionContext* context,
+                  const AtomicString& type,
+                  const AtomicString& target,
+                  bool passive,
+                  bool capture,
+                  bool once) {
+  if (!context) {
+    return;
+  }
+  std::string origin;
+  std::string site;
+  if (const SecurityOrigin* security_origin = context->GetSecurityOrigin()) {
+    origin = security_origin->ToString().Utf8();
+  }
+  if (auto* window = DynamicTo<LocalDOMWindow>(context)) {
+    site = window->GetStorageKey().GetTopLevelSite().Serialize().Utf8();
+  }
+  v8::Isolate* isolate = context->GetIsolate();
+  v8::HandleScope handle_scope(isolate);
+  std::string script;
+  v8::Local<v8::String> v8_script =
+      v8::StackTrace::CurrentScriptNameOrSourceURL(isolate);
+  if (!v8_script.IsEmpty()) {
+    script.resize(v8_script->Utf8LengthV2(isolate));
+    v8_script->WriteUtf8V2(isolate, script.data(), script.size());
+  }
+  // A page can register any string: keep 48 printable ASCII characters, so a
+  // long or non-ASCII type can neither bloat the trace nor break its JSON.
+  std::string type_text;
+  for (unsigned i = 0; i < type.length() && type_text.size() < 48; ++i) {
+    UChar c = type[i];
+    type_text.push_back(c >= 0x20 && c < 0x7f ? static_cast<char>(c) : '?');
+  }
+  std::string opts;
+  for (auto [on, label] : {std::pair{passive, "passive"},
+                           std::pair{capture, "capture"},
+                           std::pair{once, "once"}}) {
+    if (on) {
+      opts += (opts.empty() ? "" : ",");
+      opts += label;
+    }
+  }
+  TRACE_EVENT_INSTANT(CAMOU_OBSERVE_CATEGORY, perfetto::StaticString(name),
+                      "origin", origin, "site", site, "script", script,
+                      "type", type_text, "target", target.Utf8(), "opts",
+                      opts);
+}
+
 }  // namespace blink::camou_observe
 
 #endif  // BUILDFLAG(CAMOU_OBSERVE)
