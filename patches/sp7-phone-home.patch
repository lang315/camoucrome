     GCMClient::StartMode start_mode) {
   DCHECK(ui_thread_->RunsTasksInCurrentSequence());
 
+  // camoucrome (SP7): never start the GCM client. Checkin carries a
+  // persistent android id and register3 follows it on every fresh profile.
+  // Callers already handle GCM_DISABLED (it is what policy-disabled GCM
+  // returns), and gcm_started_ can never become true, so the rest of this
+  // function is dead at runtime without being dead to the compiler.
+  if (!gcm_started_)
+    return GCMClient::GCM_DISABLED;
+
   if (gcm_started_)
     return GCMClient::SUCCESS;
 
