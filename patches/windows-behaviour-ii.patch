+}
+
+// windows-behaviour-ii: the rate the audio service reports for an output
+// device is what every renderer's AudioContext.sampleRate / baseLatency
+// derive from. audio:sampleRate replaces it when present; the stream itself is
+// still opened at the device's own rate through AudioOutputResampler, exactly
+// as when a page asks for a rate the device lacks. Absent -> the real value.
+AudioParameters AudioManagerBase::CamouOutputParameters(
+    AudioParameters params) {
+  std::optional<int32_t> rate = camoucfg::GetInt32(
+      camoucfg::GlobalScope(), camoucfg::keys::kAudioSampleRate);
+  if (rate && params.IsValid()) {
+    params.set_sample_rate(std::clamp(*rate, 8000, 192000));
+  }
+  std::optional<int32_t> frames = camoucfg::GetInt32(
+      camoucfg::GlobalScope(), camoucfg::keys::kAudioBufferFrames);
+  if (frames && params.IsValid()) {
+    // baseLatency = frames / rate: a claimed host's latency needs its frame
+    // count too (WASAPI 480 at 48000; the box's PulseAudio 512).
+    params.set_frames_per_buffer(std::clamp(*frames, 64, 16384));
+  }
+  return params;
 }
 
