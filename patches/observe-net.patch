diff --git a/services/network/camou_observe_net.cc b/services/network/camou_observe_net.cc
new file mode 100644
index 0000000000..6a04bfb0b6
--- /dev/null
+++ b/services/network/camou_observe_net.cc
@@ -0,0 +1,112 @@
+#include "services/network/camou_observe_net.h"
+
+#if BUILDFLAG(CAMOU_OBSERVE)
+
+#include <algorithm>
+#include <atomic>
+#include <string>
+
+#include "base/base64.h"
+#include "net/base/isolation_info.h"
+#include "net/base/schemeful_site.h"
+#include "net/http/http_request_headers.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/resource_request_body.h"
+#include "url/gurl.h"
+
+namespace network::camou_observe {
+
+uint64_t NextLoaderId() {
+  static std::atomic<uint64_t> next{1};
+  return next.fetch_add(1);
+}
+
+void EmitBody(uint64_t loader,
+              uint32_t element,
+              uint64_t offset,
+              base::span<const uint8_t> bytes) {
+  if (offset >= kMaxBodyBytes) {
+    // A streamed element read past the cap: one terminal fragment marks the
+    // cut (readers send it once). An empty chunk past the cap hides nothing.
+    if (!bytes.empty()) {
+      TRACE_EVENT_INSTANT(TRACE_DISABLED_BY_DEFAULT("camou.observe.send"),
+                          "camou.send.body", "loader", loader, "element",
+                          element, "offset", uint64_t{kMaxBodyBytes}, "b64", "",
+                          "cut", "1");
+    }
+    return;
+  }
+  const bool cut = offset + bytes.size() > kMaxBodyBytes;
+  bytes = bytes.first(std::min<size_t>(bytes.size(), kMaxBodyBytes - offset));
+  if (bytes.empty()) {
+    TRACE_EVENT_INSTANT(TRACE_DISABLED_BY_DEFAULT("camou.observe.send"),
+                        "camou.send.body", "loader", loader, "element", element,
+                        "offset", offset, "b64", "", "cut", "");
+    return;
+  }
+  for (size_t at = 0; at < bytes.size(); at += kFragmentBytes) {
+    const auto part =
+        bytes.subspan(at, std::min(kFragmentBytes, bytes.size() - at));
+    const bool last = at + part.size() == bytes.size();
+    TRACE_EVENT_INSTANT(TRACE_DISABLED_BY_DEFAULT("camou.observe.send"),
+                        "camou.send.body", "loader", loader, "element", element,
+                        "offset", offset + at, "b64", base::Base64Encode(part),
+                        "cut", (cut && last) ? "1" : "");
+  }
+}
+
+void EmitRequest(uint64_t loader,
+                 const ResourceRequest& request,
+                 const net::IsolationInfo& isolation,
+                 const std::optional<base::UnguessableToken>& top_frame_id) {
+  const GURL& url = request.url;
+  std::string endpoint(url.host());
+  if (url.has_port()) {
+    endpoint += ":";
+    endpoint += url.port();
+  }
+  endpoint += url.path();
+  std::string top_site;
+  if (isolation.top_frame_origin()) {
+    top_site = net::SchemefulSite(*isolation.top_frame_origin()).Serialize();
+  }
+  const std::string top_frame = top_frame_id ? top_frame_id->ToString() : "";
+  const std::string content_type =
+      request.headers.GetHeader(net::HttpRequestHeaders::kContentType)
+          .value_or("");
+  const auto& elements = *request.request_body->elements();
+  TRACE_EVENT_INSTANT(TRACE_DISABLED_BY_DEFAULT("camou.observe.send"),
+                      "camou.send.http", "loader", loader, "endpoint", endpoint,
+                      "method", request.method, "top_site", top_site,
+                      "top_frame", top_frame, "content_type", content_type,
+                      "elements", static_cast<uint64_t>(elements.size()));
+  uint32_t i = 0;
+  for (const auto& element : elements) {
+    if (element.type() == mojom::DataElementDataView::Tag::kBytes) {
+      EmitBody(loader, i, 0, element.As<DataElementBytes>().bytes());
+    } else if (element.type() == mojom::DataElementDataView::Tag::kFile) {
+      TRACE_EVENT_INSTANT(TRACE_DISABLED_BY_DEFAULT("camou.observe.send"),
+                          "camou.send.file", "loader", loader, "element", i,
+                          "size", element.As<DataElementFile>().length());
+    }
+    // Data pipes emit from their readers as the upload reads them.
+    ++i;
+  }
+}
+
+}  // namespace network::camou_observe
+
+#else  // !BUILDFLAG(CAMOU_OBSERVE)
+
+namespace network::camou_observe {
+uint64_t NextLoaderId() {
+  return 0;
+}
+void EmitRequest(uint64_t,
+                 const ResourceRequest&,
+                 const net::IsolationInfo&,
+                 const std::optional<base::UnguessableToken>&) {}
+void EmitBody(uint64_t, uint32_t, uint64_t, base::span<const uint8_t>) {}
+}  // namespace network::camou_observe
+
+#endif
diff --git a/services/network/camou_observe_net.h b/services/network/camou_observe_net.h
new file mode 100644
index 0000000000..058f1a4c4b
--- /dev/null
+++ b/services/network/camou_observe_net.h
@@ -0,0 +1,57 @@
+// Camoucrome tracking observer: request-body send events. Contract in
+// components/camoucfg/observe_tables.h. Everything is a no-op unless
+// camou_observe is on and the .send category is recording.
+#ifndef SERVICES_NETWORK_CAMOU_OBSERVE_NET_H_
+#define SERVICES_NETWORK_CAMOU_OBSERVE_NET_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <optional>
+
+#include "base/containers/span.h"
+#include "base/trace_event/trace_event.h"
+#include "base/unguessable_token.h"
+#include "services/network/camou_observe_buildflags.h"
+
+namespace net {
+class IsolationInfo;
+}
+
+namespace network {
+
+struct ResourceRequest;
+
+namespace camou_observe {
+
+inline constexpr size_t kMaxBodyBytes = 256 * 1024;  // per body element
+inline constexpr size_t kFragmentBytes = 16 * 1024;
+
+inline bool Enabled() {
+#if BUILDFLAG(CAMOU_OBSERVE)
+  bool enabled = false;
+  TRACE_EVENT_CATEGORY_GROUP_ENABLED(
+      TRACE_DISABLED_BY_DEFAULT("camou.observe.send"), &enabled);
+  return enabled;
+#else
+  return false;
+#endif
+}
+
+uint64_t NextLoaderId();
+
+void EmitRequest(uint64_t loader,
+                 const ResourceRequest& request,
+                 const net::IsolationInfo& isolation,
+                 const std::optional<base::UnguessableToken>& top_frame_id);
+
+// Zero-length `bytes` emits one empty fragment so the element is covered.
+void EmitBody(uint64_t loader,
+              uint32_t element,
+              uint64_t offset,
+              base::span<const uint8_t> bytes);
+
+}  // namespace camou_observe
+}  // namespace network
+
+#endif  // SERVICES_NETWORK_CAMOU_OBSERVE_NET_H_
