+// A move with a button down, or one that names a button (`button` without
+// `buttons`): the drag controller starts a drag on its ack.
+namespace {
+bool NamesAButton(const blink::WebMouseEvent& event) {
+  constexpr int kButtons = blink::WebInputEvent::kLeftButtonDown |
+                           blink::WebInputEvent::kMiddleButtonDown |
+                           blink::WebInputEvent::kRightButtonDown |
+                           blink::WebInputEvent::kBackButtonDown |
+                           blink::WebInputEvent::kForwardButtonDown;
+  return (event.GetModifiers() & kButtons) != 0 ||
+         event.button != blink::WebPointerProperties::Button::kNoButton;
+}
+}  // namespace
+
+// Delivers a humanized path in real time: each interior sample at its own time,
+// then the path's final event, each by a precise timer (DeadlineTimer with
+// DelayPolicy::kPrecise, which on Windows turns on the high-resolution timer)
+// and stamped by the forward itself. Owns itself; it is deleted after the final
+// event, and a timer that never fires (shutdown) leaves it to the process.
+class InputHandler::PreciseSamplePump {
+ public:
+  struct Step {
+    base::TimeTicks at;
+    blink::WebMouseEvent event;
+  };
+
+  PreciseSamplePump(base::WeakPtr<InputHandler> handler,
+                    base::WeakPtr<RenderWidgetHostImpl> widget,
+                    std::vector<Step> steps,
+                    std::unique_ptr<blink::WebMouseEvent> final_event,
+                    base::TimeTicks final_at,
+                    std::unique_ptr<DispatchMouseEventCallback> callback)
+      : handler_(std::move(handler)),
+        widget_(std::move(widget)),
+        steps_(std::move(steps)),
+        final_event_(std::move(final_event)),
+        final_at_(final_at),
+        callback_(std::move(callback)) {}
+
+  void Start() { Arm(); }
+
+ private:
+  void Arm() {
+    // Absolute times: a late timer moves when a sample goes out, never when
+    // the next one does.
+    timer_.Start(
+        FROM_HERE, next_ < steps_.size() ? steps_[next_].at : final_at_,
+        base::BindOnce(&PreciseSamplePump::Fire, base::Unretained(this)),
+        base::subtle::DelayPolicy::kPrecise);
+  }
+
+  void Fire() {
+    if (next_ < steps_.size()) {
+      InputHandler::ForwardSyntheticMouseMove(handler_, widget_,
+                                              steps_[next_++].event);
+      Arm();
+      return;
+    }
+    InputHandler::ForwardHumanizedMouseEventCompletion(
+        handler_, widget_, std::move(final_event_), std::move(callback_), true);
+    base::SingleThreadTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE,
+                                                                  this);
+  }
+
+  base::WeakPtr<InputHandler> handler_;
+  base::WeakPtr<RenderWidgetHostImpl> widget_;
+  std::vector<Step> steps_;
+  size_t next_ = 0;
+  std::unique_ptr<blink::WebMouseEvent> final_event_;
+  base::TimeTicks final_at_;
+  std::unique_ptr<DispatchMouseEventCallback> callback_;
+  base::DeadlineTimer timer_;
+};
