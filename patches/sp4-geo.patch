   const PositionOptions* options =
 #if BUILDFLAG(IS_ANDROID)
       RuntimeEnabledFeatures::ApproximateGeolocationPermissionEnabled()
@@ -674,7 +694,56 @@ void Geolocation::ResetGeolocationConnection() {
   geolocation_service_.reset();
 }
 
+bool Geolocation::HasCamouGeoConfig() const {
+  const camoucfg::ConfigScope& scope =
+      camoucfg::ScopeFor(GetExecutionContext());
+  return camoucfg::GetDouble(scope, camoucfg::keys::kGeolocationLatitude)
+             .has_value() &&
+         camoucfg::GetDouble(scope, camoucfg::keys::kGeolocationLongitude)
+             .has_value();
+}
+
 void Geolocation::QueryNextPosition() {
+  // SP4-geo: synthesize the next position from config rather than querying
+  // the real (mojo-backed) geolocation service, when both latitude and
+  // longitude are configured. Absent config falls through to the original
+  // mojo path unchanged (rule 5: no-op absent config).
+  const camoucfg::ConfigScope& scope =
+      camoucfg::ScopeFor(GetExecutionContext());
+  std::optional<double> latitude =
+      camoucfg::GetDouble(scope, camoucfg::keys::kGeolocationLatitude);
+  std::optional<double> longitude =
+      camoucfg::GetDouble(scope, camoucfg::keys::kGeolocationLongitude);
+  if (latitude.has_value() && longitude.has_value()) {
+    if (camou_geo_delivered_) {
+      // Static config position already delivered; do not re-synthesize on the
+      // watchPosition re-arm (OnPositionUpdated -> UpdateGeolocationState), which
+      // would busy-loop. A stationary position fires once then stays quiet.
+      return;
+    }
+    auto position = device::mojom::blink::Geoposition::New();
+    position->latitude = latitude.value();
+    position->longitude = longitude.value();
+    position->accuracy =
+        camoucfg::GetDouble(scope, camoucfg::keys::kGeolocationAccuracy)
+            .value_or(100.0);
+    position->timestamp = base::Time::Now();
+    // PostTask rather than calling OnPositionUpdated synchronously: the
+    // caller (UpdateGeolocationState) does `QueryNextPosition();
+    // updating_ = true;` immediately after this returns. OnPositionUpdated
+    // sets updating_ = false, so a synchronous call would have the caller's
+    // `updating_ = true` clobber that and wedge the state machine.
+    GetExecutionContext()
+        ->GetTaskRunner(TaskType::kMiscPlatformAPI)
+        ->PostTask(FROM_HERE,
+                   blink::BindOnce(
+                       &Geolocation::OnPositionUpdated,
+                       WrapWeakPersistent(this),
+                       device::mojom::blink::GeopositionResult::NewPosition(
+                           std::move(position))));
+    camou_geo_delivered_ = true;
+    return;
+  }
   geolocation_->QueryNextPosition(
       blink::BindOnce(&Geolocation::OnPositionUpdated, WrapPersistent(this)));
 }
