 }
 
+bool Geolocation::HasCamouGeoConfig() const {
+  const camoucfg::ConfigScope& scope =
+      camoucfg::ScopeFor(GetExecutionContext());
+  return camoucfg::GetDouble(scope, camoucfg::keys::kGeolocationLatitude)
+             .has_value() &&
+         camoucfg::GetDouble(scope, camoucfg::keys::kGeolocationLongitude)
+             .has_value();
+}
+
+namespace {
+// geo-ii: the re-fire delay for the Nth synthesized delivery, mirroring a
+// stationary device's WiFi poll backoff (Chrome wifi_data_provider_chromeos.cc:
+// kDefaultPollingInterval 10s -> kNoChangePollingInterval 2min ->
+// kTwoNoChangePollingInterval 10min). Count 0 is the first fix, delivered
+// promptly (CDP-quality); later counts are the stationary re-arm cadence.
+base::TimeDelta CamouGeoRefireDelay(int delivery_count) {
+  switch (delivery_count) {
+    case 0:
+      return base::TimeDelta();  // first fix: prompt
+    case 1:
+      return base::Seconds(10);
+    case 2:
+      return base::Minutes(2);
+    default:
+      return base::Minutes(10);
+  }
+}
+}  // namespace
+
+void Geolocation::DeliverSynthesizedGeoposition() {
+  // Runs from the delayed re-fire task. StopUpdating() cancels this on
+  // ContextDestroyed, but guard defensively: deliver nothing to a torn-down
+  // context (OnPositionUpdated bails on a null context too, but returning here
+  // also avoids re-reading config off a dead frame).
+  if (!GetExecutionContext()) {
+    return;
+  }
+  // Re-read config (a no-op if it was cleared in the meantime) and deliver a
+  // fresh-timestamp position with the configured, unchanged coordinates.
+  const camoucfg::ConfigScope& scope =
+      camoucfg::ScopeFor(GetExecutionContext());
+  std::optional<double> latitude =
+      camoucfg::GetDouble(scope, camoucfg::keys::kGeolocationLatitude);
+  std::optional<double> longitude =
+      camoucfg::GetDouble(scope, camoucfg::keys::kGeolocationLongitude);
+  if (!latitude.has_value() || !longitude.has_value()) {
+    return;
+  }
+  auto position = device::mojom::blink::Geoposition::New();
+  position->latitude = latitude.value();
+  position->longitude = longitude.value();
+  position->accuracy =
+      camoucfg::GetDouble(scope, camoucfg::keys::kGeolocationAccuracy)
+          .value_or(100.0);
+  position->timestamp = base::Time::Now();
+  OnPositionUpdated(device::mojom::blink::GeopositionResult::NewPosition(
+      std::move(position)));
+}
+
 void Geolocation::QueryNextPosition() {
+  // SP4-geo: synthesize the next position from config rather than querying
+  // the real (mojo-backed) geolocation service, when both latitude and
+  // longitude are configured. Absent config falls through to the original
+  // mojo path unchanged (rule 5: no-op absent config).
+  const camoucfg::ConfigScope& scope =
+      camoucfg::ScopeFor(GetExecutionContext());
+  std::optional<double> latitude =
+      camoucfg::GetDouble(scope, camoucfg::keys::kGeolocationLatitude);
+  std::optional<double> longitude =
+      camoucfg::GetDouble(scope, camoucfg::keys::kGeolocationLongitude);
+  if (latitude.has_value() && longitude.has_value()) {
+    // geo-ii: re-deliver the synthesized position on each re-arm at a stationary
+    // WiFi-poll backoff cadence (CamouGeoRefireDelay), each with a fresh
+    // timestamp and identical coordinates (a fixed config position is a
+    // stationary device; coordinate jitter would wrongly imply motion).
+    // PostDelayedTask (never synchronous): the caller (UpdateGeolocationState)
+    // sets updating_ = true right after this returns and OnPositionUpdated sets
+    // it false, so a synchronous delivery would let the caller clobber that and
+    // wedge the state machine. The DELAY additionally breaks the
+    // OnPositionUpdated -> UpdateGeolocationState re-arm busy-loop (a real
+    // stationary device fires at the poll interval, not in a tight loop). A
+    // one-shot getCurrentPosition delivers once (count 0) then does not re-arm;
+    // only watchPosition re-arms and advances the cadence.
+    // Cancel any still-queued re-fire so exactly one chain is ever in flight: a
+    // request entry reset (getCurrentPosition/2nd watchPosition) or StopUpdating
+    // (tab hide / clearWatch / detach) can clear updating_ with a task still
+    // pending, and without this the next re-arm would post a parallel,
+    // self-perpetuating chain that degrades the cadence to N x.
+    camou_geo_refire_task_.Cancel();
+    base::TimeDelta delay = CamouGeoRefireDelay(camou_geo_delivery_count_);
+    ++camou_geo_delivery_count_;
+    camou_geo_refire_task_ = blink::PostDelayedCancellableTask(
+        *GetExecutionContext()->GetTaskRunner(TaskType::kMiscPlatformAPI),
+        FROM_HERE,
+        blink::BindOnce(&Geolocation::DeliverSynthesizedGeoposition,
+                        WrapWeakPersistent(this)),
+        delay);
+    return;
+  }
   geolocation_->QueryNextPosition(
       blink::BindOnce(&Geolocation::OnPositionUpdated, WrapPersistent(this)));
 }
