+scoped_refptr<StaticBitmapImage> CanvasRenderingContext::CamouNoisedPending(
+    scoped_refptr<StaticBitmapImage> image) {
+  if (!image || !image->CamouWebGlPending()) {
+    return image;
+  }
+  // The global config: every scope resolves to it today, and the image may have
+  // left the context (and its thread) that made it.
+  const camoucfg::ConfigScope& scope = camoucfg::ScopeFor(nullptr);
+  if (!camoucfg::CanvasSeed(scope)) {
+    return image;
+  }
+  const SkColorType color_type =
+      image->PaintImageForCurrentFrame().GetColorType();
+  if (color_type != kRGBA_8888_SkColorType &&
+      color_type != kBGRA_8888_SkColorType) {
+    return image;
+  }
+  sk_sp<SkImage> sk_image = image->PaintImageForCurrentFrame().GetSwSkImage();
+  if (!sk_image) {
+    return image;
+  }
+  // WebGL: opaque pixels only, no coverage mask: as CamouNoised() on a WebGL
+  // context.
+  sk_sp<SkImage> noised = camoucfg::NoisedCanvasImage(
+      *sk_image, scope, /*min_alpha=*/255, camoucfg::NoiseMask(),
+      image->Orientation() == ImageOrientationEnum::kOriginBottomLeft,
+      camoucfg::NoiseDomain::kWebGl);
+  if (!noised) {
+    return image;
+  }
+  return UnacceleratedStaticBitmapImage::Create(std::move(noised),
+                                                image->Orientation());
+}
