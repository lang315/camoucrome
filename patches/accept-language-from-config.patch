+// camoucrome: the languages the config claims, in --accept-lang's form, so a
+// launch without the launcher's flag sends the header navigator.languages
+// reports. Empty when it claims none, or when one is not a plain tag: config
+// text must not reach a header.
+std::string CamoucfgLanguages() {
+  const camoucfg::ConfigScope& scope = camoucfg::GlobalScope();
+  std::vector<std::string> languages =
+      camoucfg::GetStringList(scope, camoucfg::keys::kNavigatorLanguages);
+  if (languages.empty()) {
+    std::optional<std::string> tag =
+        camoucfg::GetString(scope, camoucfg::keys::kLocaleTag);
+    if (tag) {
+      languages.push_back(*tag);
+    }
+  }
+  for (const std::string& language : languages) {
+    if (language.empty() || !std::ranges::all_of(language, [](char c) {
+          return base::IsAsciiAlpha(c) || base::IsAsciiDigit(c) || c == '-';
+        })) {
+      return std::string();
+    }
+  }
+  return base::JoinString(languages, ",");
+}
+
+}  // namespace
+
 ChromeCommandLinePrefStore::ChromeCommandLinePrefStore(
     const base::CommandLine* command_line)
     : CommandLinePrefStore(command_line) {
   ApplySimpleSwitches();
+  if (!command_line->HasSwitch(switches::kAcceptLang)) {
+    std::string languages = CamoucfgLanguages();
+    if (!languages.empty()) {
+      SetValue(language::prefs::kSelectedLanguages, base::Value(languages),
+               WriteablePrefStore::DEFAULT_PREF_WRITE_FLAGS);
+    }
+  }
   ApplyProxyMode();
   ValidateProxySwitches();
   ApplySSLSwitches();
