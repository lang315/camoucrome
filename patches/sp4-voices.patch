+              [](SpeechSynthesis* self, SpeechSynthesisUtterance* u) {
+                // FIX A: u may be null (WeakPersistent after GC); without the
+                // `u &&` check, `u == CurrentSpeechUtterance()` is nullptr==nullptr
+                // on an empty queue -> DidStartSpeaking(nullptr) crash.
+                if (self && u && u == self->CurrentSpeechUtterance()) {
+                  self->DidStartSpeaking(u);
