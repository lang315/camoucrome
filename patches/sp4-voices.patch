+bool SpeechSynthesis::IsCamouVoice(SpeechSynthesisUtterance* utterance) const {
+  if (!utterance || !utterance->voice()) {
+    return false;
+  }
+  const String& uri = utterance->voice()->voiceURI();
+  for (const camoucfg::VoiceConfig& v :
+       camoucfg::GetVoices(camoucfg::ScopeFor(nullptr))) {
+    if (String::FromUtf8(v.voice_uri) == uri) {
+      return true;
+    }
+  }
+  return false;
+}
