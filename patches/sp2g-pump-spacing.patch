+// Waits for the deadlines of one humanized path on a thread of its own, and
+// posts a task to the UI thread at each. The UI thread cannot wait that
+// precisely: its wait takes a whole-ms timeout (message_pump_win.cc,
+// GetSleepTimeoutMs rounds up) and returns on the 1 ms system tick, so a
+// delayed task runs 0 to 1.1 ms after its time (median 0.9 ms on the host,
+// 2026-11-23), and a page that reads event.timeStamp against performance.now()
+// in a pointerrawupdate handler sees that lateness. Here a high-resolution
+// waitable timer sleeps until camoucfg::kPacerLeadMicroseconds before a
+// deadline (it fires up to about 1.1 ms late, so never after the deadline), and
+// this thread waits out the rest on the clock, so each sample is posted within
+// about 0.1 ms of its time. The thread exists only while the path does, and
+// sleeps in the timer wait between samples (no CPU); it spins for about 1 ms in
+// 8 only on its own thread, never on the UI thread. Its type is kPresentation,
+// THREAD_PRIORITY_ABOVE_NORMAL (base/threading/platform_thread_win.cc): at
+// normal priority the host starved it under a CPU-saturating page.
+class PumpPacer final : public base::PlatformThread::Delegate,
+                        public base::RefCountedThreadSafe<PumpPacer> {
+ public:
+  // Null when the timer cannot be created (Windows before 10 1803): the pump
+  // then arms a DeadlineTimer per sample, as it does off Windows.
+  static scoped_refptr<PumpPacer> Create(
+      std::vector<base::TimeTicks> deadlines,
+      scoped_refptr<base::SingleThreadTaskRunner> runner,
+      base::RepeatingClosure fire) {
+    base::win::ScopedHandle timer(::CreateWaitableTimerExW(
+        nullptr, nullptr, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION,
+        TIMER_ALL_ACCESS));
+    base::win::ScopedHandle cancel(
+        ::CreateEventW(nullptr, /*bManualReset=*/TRUE, FALSE, nullptr));
+    if (!timer.is_valid() || !cancel.is_valid()) {
+      return nullptr;
+    }
+    return scoped_refptr<PumpPacer>(
+        new PumpPacer(std::move(timer), std::move(cancel),
+                      std::move(deadlines), std::move(runner),
+                      std::move(fire)));
+  }
+
+  // False when the thread cannot start; the caller then uses its own timer.
+  bool Start() {
+    AddRef();  // the thread's reference, dropped when it returns
+    if (base::PlatformThread::CreateNonJoinableWithType(
+            0, this, base::ThreadType::kPresentation)) {
+      return true;
+    }
+    Release();
+    return false;
+  }
+
+  // From any thread. The thread stops at its next check and posts no more.
+  void Cancel() {
+    cancelled_.store(true, std::memory_order_relaxed);
+    ::SetEvent(cancel_.get());
+  }
+
+  void ThreadMain() override {
+    base::PlatformThread::SetName("InputPacer");
+    for (const base::TimeTicks deadline : deadlines_) {
+      if (!WaitUntil(deadline)) {
+        break;
+      }
+      runner_->PostTask(FROM_HERE, fire_);
+    }
+    Release();  // may delete this: nothing after it
+  }
+
+ private:
+  friend class base::RefCountedThreadSafe<PumpPacer>;
+
+  PumpPacer(base::win::ScopedHandle timer,
+            base::win::ScopedHandle cancel,
+            std::vector<base::TimeTicks> deadlines,
+            scoped_refptr<base::SingleThreadTaskRunner> runner,
+            base::RepeatingClosure fire)
+      : timer_(std::move(timer)),
+        cancel_(std::move(cancel)),
+        deadlines_(std::move(deadlines)),
+        runner_(std::move(runner)),
+        fire_(std::move(fire)) {}
+  ~PumpPacer() override = default;
+
+  // False when cancelled. A failed wait never drops a sample: it is posted
+  // late, so the command it belongs to always completes.
+  bool WaitUntil(base::TimeTicks deadline) {
+    const std::optional<base::TimeDelta> sleep = camoucfg::PacerSleepBefore(
+        deadline - base::TimeTicks::Now(),
+        base::Microseconds(camoucfg::kPacerLeadMicroseconds));
+    if (sleep) {
+      LARGE_INTEGER due;
+      due.QuadPart = -sleep->InMicroseconds() * 10;  // relative, 100 ns units
+      DWORD result = WAIT_FAILED;
+      if (::SetWaitableTimerEx(timer_.get(), &due, 0, nullptr, nullptr, nullptr,
+                               0)) {
+        const std::array<HANDLE, 2> handles = {timer_.get(), cancel_.get()};
+        result = ::WaitForMultipleObjects(static_cast<DWORD>(handles.size()),
+                                          handles.data(), FALSE, INFINITE);
+        if (result == WAIT_OBJECT_0 + 1) {
+          return false;  // cancelled
+        }
+      }
+      if (result != WAIT_OBJECT_0) {
+        // The timer is unusable (it could not be set, or the wait failed): a
+        // coarse wait in ms, the sample is late, never lost, and no spin.
+        if (::WaitForSingleObject(cancel_.get(),
+                                  static_cast<DWORD>(
+                                      sleep->InMilliseconds())) == WAIT_OBJECT_0) {
+          return false;  // cancelled
+        }
+      }
+    }
+    while (base::TimeTicks::Now() < deadline) {
+      if (cancelled_.load(std::memory_order_relaxed)) {
+        return false;
+      }
+      YieldProcessor();
+    }
+    return !cancelled_.load(std::memory_order_relaxed);
+  }
+
+  base::win::ScopedHandle timer_;
+  base::win::ScopedHandle cancel_;
+  std::atomic<bool> cancelled_{false};
+  const std::vector<base::TimeTicks> deadlines_;
+  const scoped_refptr<base::SingleThreadTaskRunner> runner_;
+  const base::RepeatingClosure fire_;
+};
