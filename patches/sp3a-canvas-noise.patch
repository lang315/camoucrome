+    // the coverage: mark the whole area imported (no noise, never a
+    // clear). Canvas2dLayers is off by default on 154.
+    CamouMarkRect(area, Kind::kImported);
+    return;
+  }
+  MemoryManagedPaintCanvas recorder(gfx::Size(Width(), Height()));
+  RestoreMatrixClipStack(&recorder);
+  cc::PaintFlags coverage = flags;
+  coverage.setColor(SK_ColorWHITE);
