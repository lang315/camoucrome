+}  // namespace
+
+void Canvas2DRecorderContext::CamouMarkRecord(const cc::PaintRecord& record) {
+  const int w = Width();
+  const int h = Height();
+  if (record.empty() || w <= 0 || h <= 0) {
+    return;
+  }
+  CamouEnsureMask();
+  if (camou_coverage_.width() != w || camou_coverage_.height() != h) {
+    camou_coverage_.reset();
+    if (!camou_coverage_.tryAllocPixels(SkImageInfo::MakeA8(w, h))) {
+      camou_coverage_.reset();
+      // No memory for the coverage pass: no noise anywhere (imported, never
+      // a clear). The allocation is retried at the next flush.
+      CamouMarkRect(SkIRect::MakeWH(w, h), CamouKind::kImported);
+      return;
+    }
+  }
+  SkCanvas canvas(camou_coverage_);
+  const cc::PlaybackParams params;
+  CamouLayer layer;
+  CamouWalk(record, canvas, params, layer);
+}
+
+void Canvas2DRecorderContext::CamouWalk(const cc::PaintRecord& record,
+                                        SkCanvas& canvas,
+                                        const cc::PlaybackParams& params,
+                                        CamouLayer& layer) {
+  // Inside a composited draw, the first op that may set pixels marks the
+  // layer's clip imported. Text marks nothing unless its style is a pattern,
+  // as in S2b, so shadowed or filtered text leaves the clip's noise alone.
+  auto mark_layer = [&](const cc::PaintOp& op) {
+    if (layer.marked) {
+      return;
+    }
+    if (op.GetType() == cc::PaintOpType::kDrawTextBlob ||
+        op.GetType() == cc::PaintOpType::kDrawSlug) {
+      if (!CamouIsPattern(static_cast<const cc::PaintOpWithFlags&>(op).flags)) {
+        return;
+      }
+    }
+    CamouMarkRect(layer.clip, CamouKind::kImported);
+    layer.marked = true;
+  };
+  for (const cc::PaintOp& op : record.buffer()) {
+    switch (op.GetType()) {
+      case cc::PaintOpType::kSaveLayer:
+      case cc::PaintOpType::kSaveLayerAlpha:
+      case cc::PaintOpType::kSaveLayerFilters:
+        // A composited draw (a filter, a composited shadow, a full-canvas
+        // composite mode) may set any pixel of its area (CamouLayerArea)
+        // unpredictably and may leave exact pixels as they were: that area is
+        // marked imported (by its first non-text op) and the ops inside are
+        // skipped. A plain save keeps the restores balanced.
+        if (layer.depth == 0) {
+          layer.depth = canvas.getSaveCount() + 1;
+          layer.clip = CamouLayerArea(op, canvas);
+          layer.marked = false;
+        }
+        canvas.save();
+        continue;
+      case cc::PaintOpType::kRestore:
+        canvas.restore();
+        if (layer.depth != 0 && canvas.getSaveCount() < layer.depth) {
+          layer.depth = 0;
+        }
+        continue;
+      case cc::PaintOpType::kDrawRecord:
+        // A Canvas2D layer's side recording: imported over the clip. It is
+        // played for the matrix it may leave behind (local_ctm false); what it
+        // draws into the coverage bitmap is never merged, because every op
+        // clears its own area first.
+        if (layer.depth == 0) {
+          CamouMarkRect(canvas.getDeviceClipBounds(), CamouKind::kImported);
+        } else {
+          mark_layer(op);
+        }
+        op.Raster(&canvas, params);
+        continue;
+      default:
+        break;
+    }
+    if (!op.IsDrawOp()) {
+      op.Raster(&canvas, params);  // save, clip and matrix ops
+    } else if (layer.depth == 0) {
+      CamouMarkOp(op, canvas, params);
+    } else {
+      mark_layer(op);
+    }
+  }
+}
+
+void Canvas2DRecorderContext::CamouMarkOp(const cc::PaintOp& op,
+                                          SkCanvas& canvas,
+                                          const cc::PlaybackParams& params) {
+  // Clears `area` of the coverage bitmap, rasters into it, and merges it.
+  auto merge = [&](const SkIRect& area, CamouKind kind, auto&& raster) {
+    if (area.isEmpty()) {
+      return;
+    }
+    camou_coverage_.erase(SkColors::kTransparent, area);
+    raster();
+    camou_mask_->Merge(camou_coverage_.getAddr8(area.x(), area.y()),
+                       camou_coverage_.rowBytes(), area.x(), area.y(),
+                       static_cast<size_t>(area.width()),
+                       static_cast<size_t>(area.height()), kind);
+  };
+  const cc::PaintFlags* flags =
+      op.IsPaintOpWithFlags()
+          ? &static_cast<const cc::PaintOpWithFlags&>(op).flags
+          : nullptr;
+  // A draw that changes no pixel (transparent, globalAlpha 0) marks none,
+  // whatever it draws: a shape, an image or pattern text.
+  if (flags && flags->nothingToDraw()) {
+    return;
+  }
+  // nothingToDraw() is false while a looper is set. A canvas shadow follows
+  // its draw's alpha, so a draw that paints nothing casts nothing: tested
+  // without the looper, for shapes, images and pattern text alike.
+  if (flags && flags->getLooper()) {
+    cc::PaintFlags unshadowed = *flags;
+    unshadowed.setLooper(nullptr);
+    if (unshadowed.nothingToDraw()) {
+      return;
+    }
+  }
+  // Page-supplied pixels over the op's area. Under a looper (a shadow) a
+  // rect of the op's bounds is rastered with the looper and merged, so the
+  // shadow marks its own pixels, not the clip.
+  auto mark_imported = [&] {
+    SkRect local;
+    if (flags && flags->getLooper() && cc::PaintOp::GetBounds(op, &local)) {
+      const cc::PaintFlags coverage =
+          CamouCoverageFlags(*flags, CamouKind::kImported);
+      merge(CamouOpArea(op, &coverage, canvas), CamouKind::kImported, [&] {
+        coverage.DrawToSk(&canvas, [&](SkCanvas* c, const SkPaint& paint) {
+          // The rect is filled, grown by what a stroke adds to the bounds.
+          SkPaint stroke;
+          stroke.setStyle(paint.getStyle());
+          stroke.setStrokeWidth(paint.getStrokeWidth());
+          stroke.setStrokeMiter(paint.getStrokeMiter());
+          stroke.setStrokeJoin(paint.getStrokeJoin());
+          stroke.setStrokeCap(paint.getStrokeCap());
+          SkPaint fill(paint);
+          fill.setStyle(SkPaint::kFill_Style);
+          fill.setPathEffect(nullptr);
+          fill.setAntiAlias(true);
+          SkRect storage;
+          c->drawRect(stroke.computeFastBounds(local, &storage), fill);
+        });
+      });
+      return;
+    }
+    CamouMarkRect(CamouOpArea(op, flags, canvas), CamouKind::kImported);
+  };
+  switch (op.GetType()) {
+    case cc::PaintOpType::kDrawTextBlob:
+    case cc::PaintOpType::kDrawSlug:
+      // Text marks nothing (its draw-time offset varies it), unless its style
+      // is a pattern: then its pixels are page-supplied.
+      if (CamouIsPattern(*flags)) {
+        mark_imported();
+      }
+      return;
+    case cc::PaintOpType::kDrawImage:
+    case cc::PaintOpType::kDrawImageRect:
+    case cc::PaintOpType::kDrawVertices:
+    case cc::PaintOpType::kDrawSkottie:
+    case cc::PaintOpType::kDrawScrollingContents:
+      // Page-supplied pixels. A texture-backed image cannot be rastered on a
+      // CPU bitmap, and its area contains its coverage.
+      mark_imported();
+      return;
+    case cc::PaintOpType::kDrawColor: {
+      // clear(), the 'copy' pre-clear and drawColor cover the whole clip.
+      const auto& color = static_cast<const cc::DrawColorOp&>(op);
+      const bool exact =
+          color.mode == SkBlendMode::kSrc ||
+          color.mode == SkBlendMode::kClear ||
+          (color.mode == SkBlendMode::kSrcOver && color.color.fA >= 1.0f);
+      if (!exact && color.color.fA <= 0.0f) {
+        return;
+      }
+      SkPaint white;
+      white.setColor(SK_ColorWHITE);
+      merge(canvas.getDeviceClipBounds(),
+            exact ? CamouKind::kClear : CamouKind::kSolid,
+            [&] { canvas.drawPaint(white); });
+      return;
+    }
+    case cc::PaintOpType::kDrawLineLite:
+    case cc::PaintOpType::kDrawArcLite: {
+      const bool line = op.GetType() == cc::PaintOpType::kDrawLineLite;
+      const cc::PaintFlags lite_flags(
+          line ? static_cast<const cc::DrawLineLiteOp&>(op).core_paint_flags
+               : static_cast<const cc::DrawArcLiteOp&>(op).core_paint_flags);
+      if (lite_flags.nothingToDraw()) {
+        return;
+      }
+      const CamouKind kind = CamouKindOf(lite_flags);
+      const cc::CorePaintFlags core =
+          CamouCoverageFlags(lite_flags, kind).ToCorePaintFlags();
+      merge(CamouOpArea(op, &lite_flags, canvas), kind, [&] {
+        if (line) {
+          const auto& l = static_cast<const cc::DrawLineLiteOp&>(op);
+          const cc::DrawLineLiteOp lite(l.x0, l.y0, l.x1, l.y1, core);
+          cc::DrawLineLiteOp::Raster(&lite, &canvas, params);
+        } else {
+          const auto& a = static_cast<const cc::DrawArcLiteOp&>(op);
+          const cc::DrawArcLiteOp lite(a.oval, a.start_angle_degrees,
+                                       a.sweep_angle_degrees, core);
+          cc::DrawArcLiteOp::Raster(&lite, &canvas, params);
+        }
+      });
+      return;
+    }
+    default:
+      break;
+  }
+  if (!flags) {
+    // Any other draw op without flags: its area may hold anything.
+    CamouMarkRect(CamouOpArea(op, nullptr, canvas), CamouKind::kImported);
+    return;
+  }
+  const auto& with_flags = static_cast<const cc::PaintOpWithFlags&>(op);
+  auto raster_with = [&](const cc::PaintFlags& coverage) {
+    with_flags.RasterWithFlags(&canvas, &coverage, params);
+  };
+  if (flags->getLooper()) {
+    cc::PaintFlags shape = *flags;
+    shape.setLooper(nullptr);
+    // The shadow is rasteriser-dependent (aa), over the looper's layers'
+    // bounds; the shape is then marked by its own kind, so an opaque shape's
+    // covered pixels stay exact.
+    const cc::PaintFlags shadow = CamouCoverageFlags(*flags, CamouKind::kAa);
+    merge(CamouOpArea(op, &shadow, canvas), CamouKind::kAa,
+          [&] { raster_with(shadow); });
+    const CamouKind kind = CamouKindOf(shape);
+    const cc::PaintFlags coverage = CamouCoverageFlags(shape, kind);
+    merge(CamouOpArea(op, &coverage, canvas), kind,
+          [&] { raster_with(coverage); });
+    return;
+  }
+  const CamouKind kind = CamouKindOf(*flags);
+  const cc::PaintFlags coverage = CamouCoverageFlags(*flags, kind);
+  merge(CamouOpArea(op, &coverage, canvas), kind,
+        [&] { raster_with(coverage); });
+}
