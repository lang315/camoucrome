+       (read_buffer_of_default_framebuffer_ != GL_NONE &&
+        (GetDrawingBuffer()->StorageFormat() == GL_RGBA8 ||
+         GetDrawingBuffer()->StorageFormat() == GL_RGB8 ||
+         GetDrawingBuffer()->StorageFormat() == GL_SRGB8_ALPHA8)))) {
+    if (auto* ec = Host()->GetTopExecutionContext();
+        ec && camoucfg::CanvasSeed(camoucfg::ScopeFor(ec)) != 0) {
+      CamouNoiseReadPixels(framebuffer, x, y, width, height, data);
+    }
+  }
