+// Camoucrome canvas readback noise (SP3a). Perturbs a COPY of the snapshot
+// pixels leaving the canvas -- never the canvas's own store -- so on-screen
+// output is unchanged. The copy preserves the source SkImageInfo exactly and
+// PerturbRgbaFromConfig is a no-op when canvas:seed is unset/zero, so an
+// unconfigured build is byte-identical to stock (SP3 rule 5).
+scoped_refptr<StaticBitmapImage> PerturbCanvasReadback(
+    scoped_refptr<StaticBitmapImage> image,
+    ExecutionContext* execution_context) {
+  if (!image) {
+    return image;
+  }
+  sk_sp<SkImage> sk_image = image->PaintImageForCurrentFrame().GetSwSkImage();
+  if (!sk_image) {
+    return image;
+  }
+  // 8-bit RGBA/BGRA only. PerturbRgba treats the buffer as 8-bit RGBA (alpha at
+  // byte 3, true for both channel orderings), so N32 -- BGRA on macOS/Windows,
+  // RGBA on Linux -- is fine either way. A float (kRGBA_F16) canvas must be
+  // skipped: its half-float bytes would be corrupted, not noised, and returning
+  // the original image keeps a float readback byte-identical to stock.
+  const SkColorType camou_ct = sk_image->colorType();
+  if (camou_ct != kRGBA_8888_SkColorType &&
+      camou_ct != kBGRA_8888_SkColorType) {
+    return image;
+  }
+  SkBitmap bitmap;
+  if (!bitmap.tryAllocPixels(sk_image->imageInfo()) ||
+      !sk_image->readPixels(bitmap.pixmap(), 0, 0)) {
+    return image;
+  }
+  camoucfg::PerturbRgbaFromConfig(static_cast<uint8_t*>(bitmap.getPixels()),
+                                  bitmap.computeByteSize(),
+                                  camoucfg::ScopeFor(execution_context));
+  bitmap.setImmutable();
+  return UnacceleratedStaticBitmapImage::Create(
+      SkImages::RasterFromBitmap(bitmap), image->Orientation());
+}
