+template <typename DrawFunc>
+void Canvas2DRecorderContext::CamouMark(
+    const DrawFunc& draw_func,
+    const cc::PaintFlags* flags,
+    CanvasRenderingContext2DState::PaintType paint_type,
+    const SkIRect& area,
+    CanvasPerformanceMonitor::DrawType draw_type) {
+  // A draw that changes no pixel (transparent, globalAlpha 0) marks none.
+  if (!CamouMaskActive() || flags->nothingToDraw()) {
+    return;
+  }
+  if (draw_type == CanvasPerformanceMonitor::DrawType::kText) {
+    // Text marks nothing (its draw-time offset varies it), unless its
+    // style is a pattern: then its pixels are page-supplied.
+    if (paint_type != CanvasRenderingContext2DState::kImagePaintType &&
+        GetState().Style(paint_type).GetCanvasPattern()) {
+      CamouMarkRect(area, camoucfg::CanvasNoiseMask::Kind::kImported);
+    }
+    return;
+  }
+  if (paint_type == CanvasRenderingContext2DState::kImagePaintType) {
+    // A texture-backed image cannot be played onto a CPU bitmap; its
+    // dirty rect contains its coverage.
+    CamouMarkRect(area, camoucfg::CanvasNoiseMask::Kind::kImported);
+    return;
+  }
+  if (flags->getLooper()) {
+    // A shadow follows its shape's alpha: a shape that draws nothing casts
+    // nothing (nothingToDraw() is false while a looper is set).
+    cc::PaintFlags shape = *flags;
+    shape.setLooper(nullptr);
+    if (shape.nothingToDraw()) {
