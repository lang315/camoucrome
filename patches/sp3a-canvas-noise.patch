+bool Canvas2DRecorderContext::CamouMaskActive() const {
+  // A context with no canvas host (a CSS paint worklet's) is never read
+  // back, so its recordings are never walked.
+  return GetCanvasRenderingContextHost() != nullptr &&
+         camoucfg::CanvasSeed(camoucfg::ScopeFor(GetTopExecutionContext())) !=
+             0;
+}
+
+void Canvas2DRecorderContext::CamouEnsureMask() {
+  if (!camou_mask_ ||
+      camou_mask_->width() != static_cast<size_t>(Width()) ||
+      camou_mask_->height() != static_cast<size_t>(Height())) {
+    camou_mask_ = std::make_unique<camoucfg::CanvasNoiseMask>(
+        static_cast<size_t>(Width()), static_cast<size_t>(Height()));
+  }
+}
+
+void Canvas2DRecorderContext::CamouMarkRect(
+    const SkIRect& area,
+    camoucfg::CanvasNoiseMask::Kind kind) {
+  CamouEnsureMask();
+  camou_mask_->MarkRect(area.x(), area.y(), area.width(), area.height(),
+                        kind);
+}
