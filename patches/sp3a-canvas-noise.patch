+    }
+    // The shadow is rasteriser-dependent (aa); the shape is then marked by
+    // its own kind, so an opaque shape's covered pixels stay exact.
+    CamouReplay(draw_func, *flags, camoucfg::CanvasNoiseMask::Kind::kAa,
+                area);
+    CamouReplay(draw_func, shape, CamouKindFor(paint_type, shape), area);
+    return;
+  }
+  CamouReplay(draw_func, *flags, CamouKindFor(paint_type, *flags), area);
