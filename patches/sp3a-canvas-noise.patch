+using CamouKind = camoucfg::CanvasNoiseMask::Kind;
+
+// A pattern: the paint's pixels are page-supplied.
+bool CamouIsPattern(const cc::PaintFlags& flags) {
+  const cc::PaintShader* shader = flags.getShader();
+  return shader &&
+         (shader->shader_type() == cc::PaintShader::Type::kImage ||
+          shader->shader_type() == cc::PaintShader::Type::kPaintRecord);
+}
+
+bool CamouIsGradient(const cc::PaintFlags& flags) {
+  const cc::PaintShader* shader = flags.getShader();
+  if (!shader) {
+    return false;
+  }
+  switch (shader->shader_type()) {
+    case cc::PaintShader::Type::kLinearGradient:
+    case cc::PaintShader::Type::kRadialGradient:
+    case cc::PaintShader::Type::kTwoPointConicalGradient:
+    case cc::PaintShader::Type::kSweepGradient:
+      return true;
+    default:
+      return false;
+  }
+}
+
+// S2b's mask kind for a fill or stroke, restated on the recorded flags.
+CamouKind CamouKindOf(const cc::PaintFlags& flags) {
+  if (CamouIsPattern(flags)) {
+    return CamouKind::kImported;
+  }
+  if (CamouIsGradient(flags) || flags.getLooper() || flags.getImageFilter()) {
+    return CamouKind::kAa;
+  }
+  // clearRect, and destination-out with an opaque source: every fully
+  // covered pixel ends transparent, whatever it held (exact).
+  if (flags.getBlendMode() == SkBlendMode::kClear ||
+      (flags.isOpaque() && flags.getBlendMode() == SkBlendMode::kDstOut)) {
+    return CamouKind::kClear;
+  }
+  return flags.isOpaque() && flags.getBlendMode() == SkBlendMode::kSrcOver
+             ? CamouKind::kSolidOpaque
+             : CamouKind::kSolid;
+}
+
+// Coverage flags: opaque white, src-over, shader-free except for kind kAa
+// (a gradient's alpha is its coverage), the looper as recorded.
+cc::PaintFlags CamouCoverageFlags(const cc::PaintFlags& flags, CamouKind kind) {
+  cc::PaintFlags coverage = flags;
+  coverage.setColor(SK_ColorWHITE);
+  if (kind != CamouKind::kAa) {
+    coverage.setShader(nullptr);
+  }
+  coverage.setBlendMode(SkBlendMode::kSrcOver);
+  return coverage;
+}
+
+// The device pixels an op drawn with `flags` may touch: its local bounds
+// grown by the paint's fast bounds (stroke, miter, path effect, filter)
+// before the matrix, then mapped, outset 1 px and clipped. Under a looper
+// (a shadow) each layer is bounded under its own matrix, its blur outset in
+// local and in device space (a canvas shadow ignores the transform). A
+// plain fill needs no paint; otherwise the paint is converted without its
+// shader, which fast bounds never read. The clip bounds when the bounds
+// cannot be computed.
+SkIRect CamouOpArea(const cc::PaintOp& op,
+                    const cc::PaintFlags* flags,
+                    SkCanvas& canvas) {
+  const SkIRect clip = canvas.getDeviceClipBounds();
+  SkRect local;
+  if (!cc::PaintOp::GetBounds(op, &local)) {
+    return clip;
+  }
+  SkRect device = SkRect::MakeEmpty();
+  if (!flags || (!flags->getLooper() && !flags->getPathEffect() &&
+                 !flags->getImageFilter() &&
+                 flags->getStyle() == cc::PaintFlags::kFill_Style)) {
+    device = canvas.getTotalMatrix().mapRect(local);
+  } else {
+    bool bounded = true;
+    bool first = true;
+    auto bound = [&](SkCanvas* c, const SkPaint& paint) {
+      if (!paint.canComputeFastBounds()) {
+        bounded = false;
+        return;
+      }
+      const SkMatrix matrix = c->getTotalMatrix();
+      SkRect storage;
+      SkRect r = matrix.mapRect(paint.computeFastBounds(local, &storage));
+      if (paint.getMaskFilter()) {
+        SkPaint unmasked(paint);
+        unmasked.setMaskFilter(nullptr);
+        SkPaint mask;
+        mask.setMaskFilter(paint.refMaskFilter());
+        r.joinPossiblyEmptyRect(mask.computeFastBounds(
+            matrix.mapRect(unmasked.computeFastBounds(local, &storage)),
+            &storage));
+      }
+      if (first) {
+        device = r;
+        first = false;
+      } else {
+        device.joinPossiblyEmptyRect(r);
+      }
+    };
+    if (flags->getShader()) {
+      cc::PaintFlags shaderless = *flags;
+      shaderless.setShader(nullptr);
+      shaderless.DrawToSk(&canvas, bound);
+    } else {
+      flags->DrawToSk(&canvas, bound);
+    }
+    if (!bounded || first) {
+      return clip;
+    }
+  }
+  if (!device.isFinite()) {
+    return clip;
+  }
+  SkIRect area = device.roundOut().makeOutset(1, 1);
+  return area.intersect(clip) ? area : SkIRect::MakeEmpty();
+}
+
+// The device pixels a composited draw may set: its clip, or for a layer
+// with bounds (drawImage with a filter, or a translucent image's shadow)
+// those bounds grown by the layer's filter, mapped, outset 1 px and
+// clipped.
+SkIRect CamouLayerArea(const cc::PaintOp& op, const SkCanvas& canvas) {
+  const SkIRect clip = canvas.getDeviceClipBounds();
+  SkRect bounds;
+  SkPaint paint;
+  if (op.GetType() == cc::PaintOpType::kSaveLayer) {
+    const auto& save_layer = static_cast<const cc::SaveLayerOp&>(op);
+    bounds = save_layer.bounds;
+    paint = save_layer.flags.ToSkPaint();
+  } else if (op.GetType() == cc::PaintOpType::kSaveLayerAlpha) {
+    bounds = static_cast<const cc::SaveLayerAlphaOp&>(op).bounds;
+  } else {
+    return clip;
+  }
+  // An unset rect (no bounds) is infinite.
+  if (!bounds.isFinite() || !paint.canComputeFastBounds()) {
+    return clip;
+  }
+  SkRect storage;
+  const SkRect device = canvas.getTotalMatrix().mapRect(
+      paint.computeFastBounds(bounds, &storage));
+  if (!device.isFinite()) {
+    return clip;
+  }
+  SkIRect area = device.roundOut().makeOutset(1, 1);
+  return area.intersect(clip) ? area : SkIRect::MakeEmpty();
+}
