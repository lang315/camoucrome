+// Camoucrome canvas readback noise (SP3a). Perturbs a COPY of the snapshot
+// pixels leaving the canvas -- never the canvas's own store -- so on-screen
+// output is unchanged. With canvas:seed unset/zero the image is returned
+// untouched, so an unconfigured build is byte-identical to stock (SP3 rule 5).
+// The noise is keyed by canvas position and canvas state
+// (camoucfg::PerturbCanvasPixels), so this whole-canvas read agrees pixel for
+// pixel with any getImageData of the same state.
+scoped_refptr<StaticBitmapImage> PerturbCanvasReadback(
+    scoped_refptr<StaticBitmapImage> image,
+    ExecutionContext* execution_context) {
+  const camoucfg::ConfigScope& camou_scope =
+      camoucfg::ScopeFor(execution_context);
+  if (!image || !camoucfg::CanvasSeed(camou_scope)) {
+    return image;
+  }
+  sk_sp<SkImage> sk_image = image->PaintImageForCurrentFrame().GetSwSkImage();
+  if (!sk_image) {
+    return image;
+  }
+  // 8-bit canvases only; a float (kRGBA_F16) canvas is left byte-identical to
+  // stock. The copy is RGBA whatever the backing order (BGRA on macOS and
+  // Windows), because the noise is per channel and getImageData reads RGBA.
+  const SkColorType camou_ct = sk_image->colorType();
+  if (camou_ct != kRGBA_8888_SkColorType &&
+      camou_ct != kBGRA_8888_SkColorType) {
+    return image;
+  }
+  SkBitmap bitmap;
+  if (!bitmap.tryAllocPixels(
+          sk_image->imageInfo().makeColorType(kRGBA_8888_SkColorType)) ||
+      !sk_image->readPixels(bitmap.pixmap(), 0, 0)) {
+    return image;
+  }
+  camoucfg::PerturbCanvasPixels(*sk_image,
+                                static_cast<uint8_t*>(bitmap.getPixels()),
+                                bitmap.width(), bitmap.height(),
+                                bitmap.rowBytes(), 0, 0, camou_scope);
+  bitmap.setImmutable();
+  return UnacceleratedStaticBitmapImage::Create(
+      SkImages::RasterFromBitmap(bitmap), image->Orientation());
+}
