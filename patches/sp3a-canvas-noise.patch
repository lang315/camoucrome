+        }
+      }
+      return true;
+    };
+    if (fx0 == ix0 && fy0 == iy0 && fx1 == ix1 && fy1 == iy1) {
+      // No room for a margin on any side (a full read): the page buffer is
+      // noised in place. One row of the rect is read again first and must
+      // equal the page's first row; it stands for the whole read. It catches a
+      // page read GL rejected or dropped after Blink's checks, which leaves the
+      // page's own bytes (stock returns them untouched). It does not catch a
+      // read GL abandoned after its first chunk of rows: the later rows keep
+      // the page's bytes and are noised. That needs a transfer buffer GL
+      // cannot get mid-read, which no page can cause (accepted; measurements
+      // section 13.9).
+      const Scratch probe = read_new(ix0, iy0, static_cast<int64_t>(in_w), 1);
+      if (!probe || !agrees(probe, in_w * 4, 0, 4, 0, 4, in_w)) {
+        return;
+      }
+      camoucfg::PerturbRgbaFromConfig(page.data(), in_w, in_h, row_bytes, scope,
+                                      camoucfg::RgbaFrame());
+      return;
+    }
+    const size_t fw = static_cast<size_t>(fx1 - fx0);
+    const size_t fh = static_cast<size_t>(fy1 - fy0);
+    // ponytail: up to this many pixels the rect plus margin is read again in
+    // one piece; above it, only the margin strips. Each strip is a round trip
+    // (up to four), which costs more than reading a small rect twice; a large
+    // rect read twice costs a second full readback, copy and compare.
+    // Calibrated on SwiftShader (measurements §13), not per GPU.
+    constexpr size_t kOnePieceMaxPixels = size_t{512} * 512;
+    if (fw * fh > kOnePieceMaxPixels) {
+      // Each margin line is read with the rect's line next to it, and that
+      // line must equal the page's (it stands for the page read, as the full
+      // read's probe row does). A strip GL rejected or dropped holds zeros,
+      // which pass only beside an all-zero line of alpha 0; a margin pixel is
+      // a neighbour of that line's pixels alone, so the field is unchanged. As
+      // with the full read's probe row, a page read GL abandoned after its
+      // first chunk of rows is not caught for rows no strip line covers.
+      camoucfg::RgbaFrame frame;
+      frame.side_stride = 8;  // a column strip holds two pixels per row
+      Scratch before(nullptr, &Partitions::BufferAlignedFree);
+      Scratch after(nullptr, &Partitions::BufferAlignedFree);
+      Scratch left(nullptr, &Partitions::BufferAlignedFree);
+      Scratch right(nullptr, &Partitions::BufferAlignedFree);
+      if (fy0 < iy0) {
+        before = read_new(fx0, iy0 - 1, static_cast<int64_t>(fw), 2);
+        if (!before ||
+            !agrees(before, fw * 8, (fw + static_cast<size_t>(ix0 - fx0)) * 4,
+                    4, 0, 4, in_w)) {
+          return;
+        }
+        frame.before = before.get();
+      }
+      if (fy1 > iy1) {
+        after = read_new(fx0, iy1 - 1, static_cast<int64_t>(fw), 2);
+        if (!after || !agrees(after, fw * 8, static_cast<size_t>(ix0 - fx0) * 4,
+                              4, (in_h - 1) * row_bytes, 4, in_w)) {
+          return;
+        }
+        // SAFETY: `after` holds two rows of fw pixels.
+        frame.after = UNSAFE_BUFFERS(after.get() + fw * 4);
+      }
+      if (fx0 < ix0) {
+        left = read_new(ix0 - 1, iy0, 2, static_cast<int64_t>(in_h));
+        if (!left || !agrees(left, in_h * 8, 4, 8, 0, row_bytes, in_h)) {
+          return;
+        }
+        frame.left = left.get();
+      }
+      if (fx1 > ix1) {
+        right = read_new(ix1 - 1, iy0, 2, static_cast<int64_t>(in_h));
+        if (!right ||
+            !agrees(right, in_h * 8, 0, 8, (in_w - 1) * 4, row_bytes, in_h)) {
+          return;
+        }
+        // SAFETY: `right` holds two pixels per row.
+        frame.right = UNSAFE_BUFFERS(right.get() + 4);
+      }
+      camoucfg::PerturbRgbaFromConfig(page.data(), in_w, in_h, row_bytes, scope,
+                                      frame);
+      return;
+    }
+    // Margins, small rect: the framebuffer's part of the expanded rect is
+    // read in one piece and noised, then the rect's part is copied back.
+    const Scratch region =
+        read_new(fx0, fy0, static_cast<int64_t>(fw), static_cast<int64_t>(fh));
+    if (!region) {
+      return;
+    }
+    // SAFETY: the region holds fw * fh * 4 bytes.
+    const base::span<uint8_t> src =
+        UNSAFE_BUFFERS(base::span<uint8_t>(region.get(), fw * fh * 4));
+    const size_t src_rb = fw * 4;
+    // The region must be what the page's own read returned: if GL rejected or
+    // lost this read, the zeroed region would replace the page's pixels.
+    for (size_t r = 0; r < in_h; ++r) {
+      if (!std::ranges::equal(
+              page.subspan(r * row_bytes, in_w * 4),
+              src.subspan(
+                  static_cast<size_t>(iy0 - fy0 + static_cast<int64_t>(r)) *
+                          src_rb +
+                      static_cast<size_t>(ix0 - fx0) * 4,
+                  in_w * 4))) {
+        return;
+      }
+    }
+    camoucfg::PerturbRgbaFromConfig(src.data(), fw, fh, src_rb, scope,
+                                    camoucfg::RgbaFrame());
+    for (size_t r = 0; r < in_h; ++r) {
+      page.subspan(r * row_bytes, in_w * 4)
+          .copy_from(src.subspan(
+              static_cast<size_t>(iy0 - fy0 + static_cast<int64_t>(r)) *
+                      src_rb +
+                  static_cast<size_t>(ix0 - fx0) * 4,
+              in_w * 4));
+    }
+  }();
+  if (shared_copy) {
+    // One copy into the view: the in-framebuffer part of each row.
+    for (size_t r = 0; r < in_h; ++r) {
+      const size_t at = offset + r * row_bytes;
+      // SAFETY: row r's in-framebuffer part ends within `extent`, which both
+      // buffers hold.
+      UNSAFE_BUFFERS(std::memcpy(data + at, shared_copy.get() + at, in_w * 4));
+    }
+  }
+  return true;
+}
