+camoucfg::CanvasNoiseMask::Kind Canvas2DRecorderContext::CamouKindFor(
+    CanvasRenderingContext2DState::PaintType paint_type,
+    const cc::PaintFlags& flags) const {
+  using Kind = camoucfg::CanvasNoiseMask::Kind;
+  const CanvasStyle& style = GetState().Style(paint_type);
+  if (style.GetCanvasPattern()) {
+    return Kind::kImported;
+  }
+  if (style.GetCanvasGradient() || flags.getLooper() ||
+      flags.getImageFilter()) {
+    return Kind::kAa;
+  }
+  // destination-out with an opaque source leaves every fully covered pixel
+  // transparent whatever it held: exact, like clearRect.
+  if (flags.isOpaque() && flags.getBlendMode() == SkBlendMode::kDstOut) {
+    return Kind::kClear;
+  }
+  return flags.isOpaque() && flags.getBlendMode() == SkBlendMode::kSrcOver
+             ? Kind::kSolidOpaque
+             : Kind::kSolid;
+}
