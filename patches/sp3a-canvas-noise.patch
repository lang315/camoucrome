+template <typename DrawFunc>
+void Canvas2DRecorderContext::CamouReplay(
+    const DrawFunc& draw_func,
+    const cc::PaintFlags& flags,
+    camoucfg::CanvasNoiseMask::Kind kind,
+    const SkIRect& area) {
