+using CamouKind = camoucfg::CanvasNoiseMask::Kind;
+
+// A pattern: the paint's pixels are page-supplied.
+bool CamouIsPattern(const cc::PaintFlags& flags) {
+  const cc::PaintShader* shader = flags.getShader();
+  return shader &&
+         (shader->shader_type() == cc::PaintShader::Type::kImage ||
+          shader->shader_type() == cc::PaintShader::Type::kPaintRecord);
+}
+
+bool CamouIsGradient(const cc::PaintFlags& flags) {
+  const cc::PaintShader* shader = flags.getShader();
+  if (!shader) {
+    return false;
+  }
+  switch (shader->shader_type()) {
+    case cc::PaintShader::Type::kLinearGradient:
+    case cc::PaintShader::Type::kRadialGradient:
+    case cc::PaintShader::Type::kTwoPointConicalGradient:
+    case cc::PaintShader::Type::kSweepGradient:
+      return true;
+    default:
+      return false;
+  }
+}
+
+// S2b's mask kind for a fill or stroke, restated on the recorded flags.
+CamouKind CamouKindOf(const cc::PaintFlags& flags) {
+  if (CamouIsPattern(flags)) {
+    return CamouKind::kImported;
+  }
+  if (CamouIsGradient(flags) || flags.getLooper() || flags.getImageFilter()) {
+    return CamouKind::kAa;
+  }
+  // clearRect, and destination-out with an opaque source: every fully
+  // covered pixel ends transparent, whatever it held (exact).
+  if (flags.getBlendMode() == SkBlendMode::kClear ||
+      (flags.isOpaque() && flags.getBlendMode() == SkBlendMode::kDstOut)) {
+    return CamouKind::kClear;
+  }
+  return flags.isOpaque() && flags.getBlendMode() == SkBlendMode::kSrcOver
+             ? CamouKind::kSolidOpaque
+             : CamouKind::kSolid;
+}
+
+// Coverage flags: opaque white, src-over, shader-free except for kind kAa
+// (a gradient's alpha is its coverage), the looper as recorded.
+cc::PaintFlags CamouCoverageFlags(const cc::PaintFlags& flags, CamouKind kind) {
+  cc::PaintFlags coverage = flags;
+  coverage.setColor(SK_ColorWHITE);
+  if (kind != CamouKind::kAa) {
+    coverage.setShader(nullptr);
+  }
+  coverage.setBlendMode(SkBlendMode::kSrcOver);
+  return coverage;
+}
+
+// The device pixels an op drawn with `flags` may touch: its local bounds
+// grown by the paint's fast bounds (stroke, miter, path effect, filter)
+// before the matrix, then mapped, outset 1 px and clipped. Under a looper
+// (a shadow) each layer is bounded under its own matrix, its blur outset in
+// local and in device space (a canvas shadow ignores the transform). A
+// plain fill needs no paint; otherwise the paint is converted without its
+// shader, which fast bounds never read. The clip bounds when the bounds
+// cannot be computed.
+SkIRect CamouOpArea(const cc::PaintOp& op,
+                    const cc::PaintFlags* flags,
+                    SkCanvas& canvas) {
+  const SkIRect clip = canvas.getDeviceClipBounds();
+  SkRect local;
+  if (!cc::PaintOp::GetBounds(op, &local)) {
+    return clip;
+  }
+  SkRect device = SkRect::MakeEmpty();
+  if (!flags || (!flags->getLooper() && !flags->getPathEffect() &&
+                 !flags->getImageFilter() &&
+                 flags->getStyle() == cc::PaintFlags::kFill_Style)) {
+    device = canvas.getTotalMatrix().mapRect(local);
+  } else {
+    bool bounded = true;
+    bool first = true;
+    auto bound = [&](SkCanvas* c, const SkPaint& paint) {
+      if (!paint.canComputeFastBounds()) {
+        bounded = false;
+        return;
+      }
+      const SkMatrix matrix = c->getTotalMatrix();
+      SkRect storage;
+      SkRect r = matrix.mapRect(paint.computeFastBounds(local, &storage));
+      if (paint.getMaskFilter()) {
+        SkPaint unmasked(paint);
+        unmasked.setMaskFilter(nullptr);
+        SkPaint mask;
+        mask.setMaskFilter(paint.refMaskFilter());
+        r.joinPossiblyEmptyRect(mask.computeFastBounds(
+            matrix.mapRect(unmasked.computeFastBounds(local, &storage)),
+            &storage));
+      }
+      if (first) {
+        device = r;
+        first = false;
+      } else {
+        device.joinPossiblyEmptyRect(r);
+      }
+    };
+    if (flags->getShader()) {
+      cc::PaintFlags shaderless = *flags;
+      shaderless.setShader(nullptr);
+      shaderless.DrawToSk(&canvas, bound);
+    } else {
+      flags->DrawToSk(&canvas, bound);
+    }
+    if (!bounded || first) {
+      return clip;
+    }
+  }
+  if (!device.isFinite()) {
+    return clip;
+  }
+  SkIRect area = device.roundOut().makeOutset(1, 1);
+  return area.intersect(clip) ? area : SkIRect::MakeEmpty();
+}
+
+// The device pixels a composited draw may set: its clip, or for a layer
+// with bounds (drawImage with a filter, or a translucent image's shadow)
+// those bounds grown by the layer's filter, mapped, outset 1 px and
+// clipped.
+SkIRect CamouLayerArea(const cc::PaintOp& op, const SkCanvas& canvas) {
+  const SkIRect clip = canvas.getDeviceClipBounds();
+  SkRect bounds;
+  SkPaint paint;
+  if (op.GetType() == cc::PaintOpType::kSaveLayer) {
+    const auto& save_layer = static_cast<const cc::SaveLayerOp&>(op);
+    bounds = save_layer.bounds;
+    paint = save_layer.flags.ToSkPaint();
+  } else if (op.GetType() == cc::PaintOpType::kSaveLayerAlpha) {
+    bounds = static_cast<const cc::SaveLayerAlphaOp&>(op).bounds;
+  } else {
+    return clip;
+  }
+  // An unset rect (no bounds) is infinite.
+  if (!bounds.isFinite() || !paint.canComputeFastBounds()) {
+    return clip;
+  }
+  SkRect storage;
+  const SkRect device = canvas.getTotalMatrix().mapRect(
+      paint.computeFastBounds(bounds, &storage));
+  if (!device.isFinite()) {
+    return clip;
+  }
+  SkIRect area = device.roundOut().makeOutset(1, 1);
+  return area.intersect(clip) ? area : SkIRect::MakeEmpty();
+}
+
+// Whether a layer's composite changes no pixel: a saveLayerAlpha at alpha 0
+// (an SVG image drawn at globalAlpha 0), or a saveLayer whose paint draws
+// nothing. A layer with an image or colour filter may paint from nothing (a
+// flood), so nothingToDraw() never counts it; nor does a saveLayerFilters.
+bool CamouLayerDrawsNothing(const cc::PaintOp& op) {
+  switch (op.GetType()) {
+    case cc::PaintOpType::kSaveLayerAlpha:
+      return static_cast<const cc::SaveLayerAlphaOp&>(op).alpha == 0;
+    case cc::PaintOpType::kSaveLayer:
+      return static_cast<const cc::SaveLayerOp&>(op).flags.nothingToDraw();
+    default:
+      return false;
+  }
+}
+
+// A canvas shadow's layer (a drawImage of a non-opaque image with a
+// shadow): a saveLayer whose only effect is a drop-shadow image filter with
+// no input, composited src-over. It casts the shadow of what is drawn inside
+// it, so an op inside that draws nothing adds nothing. Any other layer filter
+// keeps marking: a drop shadow with an input (a url() filter's feDropShadow
+// over an feFlood) or a filter of another type can paint from nothing.
+bool CamouIsShadowLayer(const cc::PaintOp& op) {
+  if (op.GetType() != cc::PaintOpType::kSaveLayer) {
+    return false;
+  }
+  const cc::PaintFlags& flags = static_cast<const cc::SaveLayerOp&>(op).flags;
+  const cc::PaintFilter* filter = flags.getImageFilter().get();
+  return filter && filter->type() == cc::PaintFilter::Type::kDropShadow &&
+         !static_cast<const cc::DropShadowPaintFilter*>(filter)->input() &&
+         !flags.getColorFilter() && !flags.getLooper() &&
+         flags.getBlendMode() == SkBlendMode::kSrcOver;
+}
+
+// What an op of the walk does to the matrix and clip of `canvas`: a layer is
+// a plain save (the ops inside are marked, never composited), a nested
+// record played with local_ctm restores what it changes, a draw changes
+// nothing, and any other op is played.
+void CamouApplyState(const cc::PaintOp& op,
+                     SkCanvas& canvas,
+                     const cc::PlaybackParams& params) {
+  switch (op.GetType()) {
+    case cc::PaintOpType::kSaveLayer:
+    case cc::PaintOpType::kSaveLayerAlpha:
+    case cc::PaintOpType::kSaveLayerFilters:
+      canvas.save();
+      return;
+    case cc::PaintOpType::kDrawRecord:
+      if (!static_cast<const cc::DrawRecordOp&>(op).local_ctm) {
+        op.Raster(&canvas, params);
+      }
+      return;
+    default:
+      if (!op.IsDrawOp()) {
+        op.Raster(&canvas, params);
+      }
+      return;
+  }
+}
+
+}  // namespace
+
+// The walk's A8 coverage bitmap, the canvas's size, and the canvas that
+// rasters into it, made at the walk's first op that needs the clip: a flush
+// of text, or of draws that change nothing, allocates nothing, and none
+// outlives its walk. The canvas replays the matrix and clip of the ops the
+// walk has passed (`done`), so it stands where the walk is.
+struct Canvas2DRecorderContext::CamouCoverage {
+  int width;
+  int height;
+  size_t done = 0;
+  bool failed = false;
+  SkBitmap bitmap;
+  std::optional<SkCanvas> canvas;
+
+  // The raster canvas for the walk of `record`, or null when the bitmap
+  // cannot be allocated.
+  SkCanvas* Get(const cc::PaintRecord& record,
+                const cc::PlaybackParams& params) {
+    if (canvas) {
+      return &*canvas;
+    }
+    if (failed || !bitmap.tryAllocPixels(SkImageInfo::MakeA8(width, height))) {
+      failed = true;
+      return nullptr;
+    }
+    canvas.emplace(bitmap);
+    size_t i = 0;
+    for (const cc::PaintOp& op : record.buffer()) {
+      if (i++ == done) {
+        break;
+      }
+      CamouApplyState(op, *canvas, params);
+    }
+    return &*canvas;
+  }
+};
+
+void Canvas2DRecorderContext::CamouMarkRecord(const cc::PaintRecord& record) {
+  const int w = Width();
+  const int h = Height();
+  if (record.empty() || w <= 0 || h <= 0) {
+    return;
+  }
+  CamouEnsureMask();
+  const cc::PlaybackParams params;
+  // The walk keeps no matrix or clip of its own until an op needs the clip
+  // (a layer's area, a nested record's mark, a draw that may change pixels):
+  // the coverage canvas, made then, replays the ops passed so far. Nothing
+  // is measured on a pixel-less canvas, whose clip bounds for a path clip
+  // need not match a raster canvas's.
+  CamouCoverage cover{w, h};
+  // A composited draw in progress: the save count it began at (0: none),
+  // its clip, whether that clip is marked yet, whether the layer composites
+  // nothing at all, and whether it is a canvas shadow's layer.
+  struct {
+    int depth = 0;
+    SkIRect clip = SkIRect::MakeEmpty();
+    bool marked = false;
+    bool inert = false;
+    bool shadow = false;
+  } layer;
+  // Inside a composited draw, the first op that may set pixels marks the
+  // layer's clip imported, unless the layer composites nothing. Text marks
+  // nothing unless its style is a pattern, as in S2b, so shadowed or
+  // filtered text leaves the clip's noise alone. In a shadow's layer, an op
+  // that draws nothing casts nothing.
+  auto mark_layer = [&](const cc::PaintOp& op) {
+    if (layer.marked || layer.inert) {
+      return;
+    }
+    if (op.GetType() == cc::PaintOpType::kDrawTextBlob ||
+        op.GetType() == cc::PaintOpType::kDrawSlug) {
+      if (!CamouIsPattern(static_cast<const cc::PaintOpWithFlags&>(op).flags)) {
+        return;
+      }
+    }
+    if (layer.shadow && op.IsPaintOpWithFlags() &&
+        static_cast<const cc::PaintOpWithFlags&>(op).flags.nothingToDraw()) {
+      return;
+    }
+    CamouMarkRect(layer.clip, CamouKind::kImported);
+    layer.marked = true;
+  };
+  for (const cc::PaintOp& op : record.buffer()) {
+    switch (op.GetType()) {
+      case cc::PaintOpType::kSaveLayer:
+      case cc::PaintOpType::kSaveLayerAlpha:
+      case cc::PaintOpType::kSaveLayerFilters:
+        // A composited draw (a filter, a composited shadow, a full-canvas
+        // composite mode) may set any pixel of its area (CamouLayerArea)
+        // unpredictably and may leave exact pixels as they were: that area is
+        // marked imported (by its first non-text op) and the ops inside are
+        // skipped. A layer whose own paint draws nothing marks nothing; a
+        // shadow's layer marks only for an op that draws something.
+        if (layer.depth == 0) {
+          if (SkCanvas* canvas = cover.Get(record, params)) {
+            layer.depth = canvas->getSaveCount() + 1;
+            layer.clip = CamouLayerArea(op, *canvas);
+            layer.marked = false;
+            layer.inert = CamouLayerDrawsNothing(op);
+            layer.shadow = CamouIsShadowLayer(op);
+          }
+        }
+        break;
+      case cc::PaintOpType::kDrawRecord:
+        // A nested record (with Canvas2D layers off, an SVG image's
+        // picture): imported over the clip. Its ops are not rastered: what
+        // they draw is never merged (every op clears its own area first),
+        // and an SVG's images would be decoded for nothing. Played with
+        // local_ctm (drawPicture's default), it restores the matrix and clip
+        // it changes; otherwise it is played whole for the matrix it leaves
+        // (CamouApplyState).
+        if (layer.depth != 0) {
+          mark_layer(op);
+        } else if (SkCanvas* canvas = cover.Get(record, params)) {
+          CamouMarkRect(canvas->getDeviceClipBounds(), CamouKind::kImported);
+        }
+        break;
+      default:
+        if (op.IsDrawOp()) {
+          if (layer.depth == 0) {
+            CamouMarkOp(op, record, cover, params);
+          } else {
+            mark_layer(op);
+          }
+        }
+        break;
+    }
+    if (cover.failed) {
+      // No memory for the coverage pass: no noise anywhere (imported, never
+      // a clear). Nothing of this record was marked yet: every mark needs
+      // the coverage canvas. The allocation is retried at the next flush.
+      CamouMarkRect(SkIRect::MakeWH(w, h), CamouKind::kImported);
+      return;
+    }
+    if (cover.canvas) {
+      CamouApplyState(op, *cover.canvas, params);
+      if (layer.depth != 0 && cover.canvas->getSaveCount() < layer.depth) {
+        layer.depth = 0;
+      }
+    }
+    ++cover.done;
+  }
+}
+
+void Canvas2DRecorderContext::CamouMarkOp(const cc::PaintOp& op,
+                                          const cc::PaintRecord& record,
+                                          CamouCoverage& cover,
+                                          const cc::PlaybackParams& params) {
+  const cc::PaintFlags* flags =
+      op.IsPaintOpWithFlags()
+          ? &static_cast<const cc::PaintOpWithFlags&>(op).flags
+          : nullptr;
+  // A draw that changes no pixel (transparent, globalAlpha 0) marks none,
+  // whatever it draws: a shape, an image or pattern text.
+  if (flags && flags->nothingToDraw()) {
+    return;
+  }
+  // nothingToDraw() is false while a looper is set. A canvas shadow follows
+  // its draw's alpha, so a draw that paints nothing casts nothing: tested
+  // without the looper, for shapes, images and pattern text alike.
+  if (flags && flags->getLooper()) {
+    cc::PaintFlags unshadowed = *flags;
+    unshadowed.setLooper(nullptr);
+    if (unshadowed.nothingToDraw()) {
+      return;
+    }
+  }
+  // Text whose style is not a pattern marks nothing (below) and needs no
+  // coverage canvas.
+  if ((op.GetType() == cc::PaintOpType::kDrawTextBlob ||
+       op.GetType() == cc::PaintOpType::kDrawSlug) &&
+      !CamouIsPattern(*flags)) {
+    return;
+  }
+  // The coverage canvas, made now if no op before needed it. On failure the
+  // walk marks the whole canvas imported.
+  SkCanvas* const coverage_canvas = cover.Get(record, params);
+  if (!coverage_canvas) {
+    return;
+  }
+  SkCanvas& canvas = *coverage_canvas;
+  SkBitmap& bitmap = cover.bitmap;
+  // Clears `area` of the coverage bitmap, rasters into it, and merges it.
+  auto merge = [&](const SkIRect& area, CamouKind kind, auto&& raster) {
+    if (area.isEmpty()) {
+      return;
+    }
+    bitmap.erase(SkColors::kTransparent, area);
+    raster();
+    camou_mask_->Merge(bitmap.getAddr8(area.x(), area.y()), bitmap.rowBytes(),
+                       area.x(), area.y(), static_cast<size_t>(area.width()),
+                       static_cast<size_t>(area.height()), kind);
+  };
+  // Page-supplied pixels over the op's area. Under a looper (a shadow) a
+  // rect of the op's bounds is rastered with the looper and merged, so the
+  // shadow marks its own pixels, not the clip.
+  auto mark_imported = [&] {
+    SkRect local;
+    if (flags && flags->getLooper() && cc::PaintOp::GetBounds(op, &local)) {
+      const cc::PaintFlags coverage =
+          CamouCoverageFlags(*flags, CamouKind::kImported);
+      merge(CamouOpArea(op, &coverage, canvas), CamouKind::kImported, [&] {
+        coverage.DrawToSk(&canvas, [&](SkCanvas* c, const SkPaint& paint) {
+          // The rect is filled, grown by what a stroke adds to the bounds.
+          SkPaint stroke;
+          stroke.setStyle(paint.getStyle());
+          stroke.setStrokeWidth(paint.getStrokeWidth());
+          stroke.setStrokeMiter(paint.getStrokeMiter());
+          stroke.setStrokeJoin(paint.getStrokeJoin());
+          stroke.setStrokeCap(paint.getStrokeCap());
+          SkPaint fill(paint);
+          fill.setStyle(SkPaint::kFill_Style);
+          fill.setPathEffect(nullptr);
+          fill.setAntiAlias(true);
+          SkRect storage;
+          c->drawRect(stroke.computeFastBounds(local, &storage), fill);
+        });
+      });
+      return;
+    }
+    CamouMarkRect(CamouOpArea(op, flags, canvas), CamouKind::kImported);
+  };
+  switch (op.GetType()) {
+    case cc::PaintOpType::kDrawTextBlob:
+    case cc::PaintOpType::kDrawSlug:
+      // Text marks nothing (its draw-time offset varies it), unless its style
+      // is a pattern: then its pixels are page-supplied.
+      if (CamouIsPattern(*flags)) {
+        mark_imported();
+      }
+      return;
+    case cc::PaintOpType::kDrawImage:
+    case cc::PaintOpType::kDrawImageRect:
+    case cc::PaintOpType::kDrawVertices:
+    case cc::PaintOpType::kDrawSkottie:
+    case cc::PaintOpType::kDrawScrollingContents:
+      // Page-supplied pixels. A texture-backed image cannot be rastered on a
+      // CPU bitmap, and its area contains its coverage.
+      mark_imported();
+      return;
+    case cc::PaintOpType::kDrawColor: {
+      // clear(), the 'copy' pre-clear and drawColor cover the whole clip.
+      const auto& color = static_cast<const cc::DrawColorOp&>(op);
+      const bool exact =
+          color.mode == SkBlendMode::kSrc ||
+          color.mode == SkBlendMode::kClear ||
+          (color.mode == SkBlendMode::kSrcOver && color.color.fA >= 1.0f);
+      if (!exact && color.color.fA <= 0.0f) {
+        return;
+      }
+      SkPaint white;
+      white.setColor(SK_ColorWHITE);
+      merge(canvas.getDeviceClipBounds(),
+            exact ? CamouKind::kClear : CamouKind::kSolid,
+            [&] { canvas.drawPaint(white); });
+      return;
+    }
+    case cc::PaintOpType::kDrawLineLite:
+    case cc::PaintOpType::kDrawArcLite: {
+      const bool line = op.GetType() == cc::PaintOpType::kDrawLineLite;
+      const cc::PaintFlags lite_flags(
+          line ? static_cast<const cc::DrawLineLiteOp&>(op).core_paint_flags
+               : static_cast<const cc::DrawArcLiteOp&>(op).core_paint_flags);
+      if (lite_flags.nothingToDraw()) {
+        return;
+      }
+      const CamouKind kind = CamouKindOf(lite_flags);
+      const cc::CorePaintFlags core =
+          CamouCoverageFlags(lite_flags, kind).ToCorePaintFlags();
+      merge(CamouOpArea(op, &lite_flags, canvas), kind, [&] {
+        if (line) {
+          const auto& l = static_cast<const cc::DrawLineLiteOp&>(op);
+          const cc::DrawLineLiteOp lite(l.x0, l.y0, l.x1, l.y1, core);
+          cc::DrawLineLiteOp::Raster(&lite, &canvas, params);
+        } else {
+          const auto& a = static_cast<const cc::DrawArcLiteOp&>(op);
+          const cc::DrawArcLiteOp lite(a.oval, a.start_angle_degrees,
+                                       a.sweep_angle_degrees, core);
+          cc::DrawArcLiteOp::Raster(&lite, &canvas, params);
+        }
+      });
+      return;
+    }
+    default:
+      break;
+  }
+  if (!flags) {
