+scoped_refptr<StaticBitmapImage> CanvasRenderingContext::CamouNoised(
+    scoped_refptr<StaticBitmapImage> image) {
+  if (!image || !Host() || !CamouNoiseEligible()) {
+    return image;
+  }
+  const camoucfg::ConfigScope& scope =
+      camoucfg::ScopeFor(Host()->GetTopExecutionContext());
+  if (!camoucfg::CanvasSeed(scope)) {
+    return image;  // spoof off -> byte-identical to stock (rule 5)
+  }
+  // One entry, checked before any readback: a page that reads or copies one
+  // unchanged canvas again (getImageData(x, y, 1, 1) in a loop, drawImage of
+  // a sprite canvas every frame) gets the cached field without another GPU
+  // readback or noise pass. The source is held, so a new image cannot reuse
+  // its identity.
+  if (camou_noised_ && camou_noised_source_ == image) {
+    return UnacceleratedStaticBitmapImage::Create(camou_noised_,
+                                                  image->Orientation());
+  }
+  sk_sp<SkImage> sk_image = image->PaintImageForCurrentFrame().GetSwSkImage();
+  if (!sk_image) {
+    return image;
+  }
+  // A new wrapper around the same raster snapshot (a CPU canvas) keeps the
+  // same field.
+  if (!camou_noised_ || camou_noised_from_ != sk_image->uniqueID()) {
+    sk_sp<SkImage> noised = camoucfg::NoisedCanvasImage(*sk_image, scope);
+    if (!noised) {
+      return image;
+    }
+    camou_noised_from_ = sk_image->uniqueID();
+    camou_noised_ = std::move(noised);
+  }
+  camou_noised_source_ = image;
+  // A fresh wrapper per call, as stock hands out per snapshot:
+  // ImageBitmap::Transfer() may detach the one it receives.
+  return UnacceleratedStaticBitmapImage::Create(camou_noised_,
+                                                image->Orientation());
+}
