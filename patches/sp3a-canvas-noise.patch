+const camoucfg::ConfigScope* CanvasRenderingContext::CamouNoiseScope(
+    StaticBitmapImage& image) {
+  if (!Host() || !CamouNoiseEligible()) {
+    return nullptr;
+  }
+  const camoucfg::ConfigScope& scope =
+      camoucfg::ScopeFor(Host()->GetTopExecutionContext());
+  if (!camoucfg::CanvasSeed(scope)) {
+    return nullptr;  // spoof off -> byte-identical to stock (rule 5)
+  }
+  // A snapshot the noise cannot carry (float16, a WebGL RGBA16F buffer) is
+  // turned away before any readback, which would read a GPU one back for
+  // nothing. The readback keeps this colour type.
+  const SkColorType color_type =
+      image.PaintImageForCurrentFrame().GetColorType();
+  if (color_type != kRGBA_8888_SkColorType &&
+      color_type != kBGRA_8888_SkColorType) {
+    return nullptr;
+  }
+  return &scope;
+}
+
+bool CanvasRenderingContext::CamouNoisedCached(
+    const scoped_refptr<StaticBitmapImage>& image) const {
+  return camou_noised_ && camou_noised_source_ == image &&
+         camou_noised_generation_ == CamouNoiseMaskGeneration();
+}
+
+scoped_refptr<StaticBitmapImage> CanvasRenderingContext::CamouNoised(
+    scoped_refptr<StaticBitmapImage> image) {
+  const camoucfg::ConfigScope* scope =
+      image ? CamouNoiseScope(*image) : nullptr;
+  if (!scope) {
+    return image;
+  }
+  // One entry, checked before any readback: a page that reads or copies one
+  // unchanged canvas again (getImageData(x, y, 1, 1) in a loop, drawImage of
+  // a sprite canvas every frame) gets the cached field without another GPU
+  // readback or noise pass. The source is held, so a new image cannot reuse
+  // its identity.
+  if (CamouNoisedCached(image)) {
+    return UnacceleratedStaticBitmapImage::Create(camou_noised_,
+                                                  image->Orientation());
+  }
+  sk_sp<SkImage> sk_image = image->PaintImageForCurrentFrame().GetSwSkImage();
+  if (!sk_image) {
+    return image;
+  }
+  // A new wrapper around the same raster snapshot (a CPU canvas) keeps the
+  // same field.
+  // A mask change without a raster change (a transparent arc, clearRect
+  // over clear pixels) still misses: the generation is part of the key.
+  const uint64_t generation = CamouNoiseMaskGeneration();
+  if (!camou_noised_ || camou_noised_from_ != sk_image->uniqueID() ||
+      camou_noised_generation_ != generation) {
+    sk_sp<SkImage> noised = camoucfg::NoisedCanvasImage(
+        *sk_image, *scope, CamouNoiseMinAlpha(), CamouNoiseMask(),
+        image->Orientation() == ImageOrientationEnum::kOriginBottomLeft);
+    if (!noised) {
+      return image;
+    }
+    camou_noised_from_ = sk_image->uniqueID();
+    camou_noised_generation_ = generation;
+    camou_noised_ = std::move(noised);
+  }
+  camou_noised_source_ = image;
+  // A fresh wrapper per call, as stock hands out per snapshot:
+  // ImageBitmap::Transfer() may detach the one it receives.
+  return UnacceleratedStaticBitmapImage::Create(camou_noised_,
+                                                image->Orientation());
+}
+
+SkBitmap CanvasRenderingContext::CamouNoisedRegion(
+    const scoped_refptr<StaticBitmapImage>& image,
+    const SkIRect& rect) {
+  // A bottom-up snapshot keeps the whole-snapshot route.
+  if (!image ||
+      image->Orientation() == ImageOrientationEnum::kOriginBottomLeft) {
+    return SkBitmap();
+  }
+  const camoucfg::ConfigScope* scope = CamouNoiseScope(*image);
+  if (!scope || CamouNoisedCached(image)) {
+    return SkBitmap();  // no noise, or the whole field is cached
+  }
+  // A CPU canvas hands out a new wrapper per GetImage(): one around the
+  // raster the cache already noised is served from the cache too. Never
+  // asked of a texture-backed snapshot, whose GetSwSkImage() is a readback.
+  if (camou_noised_ && !image->IsTextureBacked() &&
+      camou_noised_generation_ == CamouNoiseMaskGeneration()) {
+    const sk_sp<SkImage> sk_image =
+        image->PaintImageForCurrentFrame().GetSwSkImage();
+    if (sk_image && sk_image->uniqueID() == camou_noised_from_) {
+      return SkBitmap();
+    }
+  }
+  // A rect over half the canvas takes the whole-snapshot route too: its
+  // field is cached, so a page that reads most of an unchanged canvas again
+  // does not pay for the noise again.
+  SkIRect r = rect;
+  if (!r.intersect(
+          SkIRect::MakeWH(image->Size().width(), image->Size().height())) ||
+      2 * int64_t{r.width()} * r.height() >
+          int64_t{image->Size().width()} * image->Size().height()) {
+    return SkBitmap();
+  }
+  // The rect plus its margin are read through the PaintImage, which reads a
+  // texture-backed (GPU) snapshot too: only that part leaves the GPU.
+  const cc::PaintImage paint_image = image->PaintImageForCurrentFrame();
+  return camoucfg::NoisedCanvasRegion(
+      paint_image.GetSkImageInfo(),
+      [&paint_image](const SkPixmap& dst, int src_x, int src_y) {
+        // `dst` is a tight bitmap: a texture-backed snapshot's readPixels
+        // (MailboxTextureBacking) ignores dst_row_bytes and writes rows
+        // minRowBytes() apart.
+        return paint_image.readPixels(dst.info(), dst.writable_addr(),
+                                      dst.rowBytes(), src_x, src_y);
+      },
+      rect, *scope, CamouNoiseMinAlpha(), CamouNoiseMask());
+}
+
 }  // namespace blink
