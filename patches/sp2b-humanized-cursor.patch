+// static
+void InputHandler::ForwardSyntheticMouseMove(
+    base::WeakPtr<InputHandler> handler,
+    base::WeakPtr<RenderWidgetHostImpl> widget,
+    blink::WebMouseEvent synthetic_event) {
+  if (!handler || !widget) {
+    return;
+  }
+  if (!handler->PointIsWithinContents(synthetic_event.PositionInWidget())) {
+    return;
+  }
+  // Stamped with the real time it actually fires, not a value computed at
+  // schedule time: with a real posted delay (see InputInjector::
+  // SchedulePath's own comment on why), "now" already carries the
+  // non-uniform spacing HumanizeTrajectory generated.
+  synthetic_event.SetTimeStamp(base::TimeTicks::Now());
+  widget->ForwardMouseEvent(synthetic_event);
+}
+
+// static
+void InputHandler::ForwardHumanizedMouseEventCompletion(
+    base::WeakPtr<InputHandler> handler,
+    base::WeakPtr<RenderWidgetHostImpl> widget,
+    std::unique_ptr<blink::WebMouseEvent> mouse_event,
+    std::unique_ptr<DispatchMouseEventCallback> callback) {
+  if (!handler || !widget) {
+    callback->sendFailure(Response::InternalError());
+    return;
+  }
+  // EnsureInjector may return a fresh InputInjector: the one that scheduled
+  // this path self-destructed once it queued no callback of its own (see
+  // InputInjector::InjectMouseEvent). ForwardMouseEventNow is the same
+  // stock delivery path a non-humanized move takes -- callback resolves on
+  // this event's ack, exactly like today.
+  // Re-stamped like the synthetic moves before it: the event still carries
+  // its dispatch-time stamp, which is older than every interior point, so the
+  // page would see the final mousemove's timeStamp go backwards.
+  mouse_event->SetTimeStamp(base::TimeTicks::Now());
+  handler->EnsureInjector(widget.get())
+      ->ForwardMouseEventNow(*mouse_event, std::move(callback));
+}
