+  // Schedules a humanized path from owner_->last_move_position_ to
+  // mouse_event's own destination: one delayed synthetic ForwardMouseEvent
+  // per interior point, spaced by HumanizeTrajectory's offsets, and a
+  // final delayed task -- at the path's full duration -- that forwards
+  // mouse_event itself UNCHANGED and completes `callback`.
+  //
+  // Real delay, not just a stamped timestamp: Chromium's input router
+  // coalesces mousemoves the renderer hasn't yet consumed, so a
+  // synchronous burst of ForwardMouseEvent calls collapses to whatever the
+  // renderer drains on its next turn regardless of what timestamp each one
+  // carries (observed: 24 forwarded, 2 delivered to the page). Spacing the
+  // POSTS in real time, not just the timestamps, is what makes the
+  // renderer actually consume each one before the next arrives.
+  //
+  // The command completes at the path's end, not now. Deferring the
+  // callback is what serializes back-to-back moves: if this completed
+  // early, Playwright -- which awaits each command before sending the next
+  // -- would dispatch the next move while this path's tasks are still in
+  // flight; that move would read last_move_position_ already at THIS
+  // move's target and start its own path, and the two paths' synthetic
+  // events would interleave out of order on the widget.
+  void SchedulePath(const blink::WebMouseEvent& mouse_event,
+                    std::unique_ptr<DispatchMouseEventCallback> callback) {
+    constexpr int kHumanizeSteps = 24;
+    constexpr int kDefaultMinTimeMs = 40;
+    constexpr int kDefaultMaxTimeMs = 120;
+    int min_ms = camoucfg::GetInt32(camoucfg::GlobalScope(),
+                                    camoucfg::keys::kHumanizeMinTime)
+                    .value_or(kDefaultMinTimeMs);
+    int max_ms = camoucfg::GetInt32(camoucfg::GlobalScope(),
+                                    camoucfg::keys::kHumanizeMaxTime)
+                    .value_or(kDefaultMaxTimeMs);
+    std::vector<camoucfg::TrajectoryPoint> path = camoucfg::HumanizeTrajectory(
+        owner_->last_move_position_, mouse_event.PositionInWidget(),
+        kHumanizeSteps, min_ms, max_ms, base::RandUint64());
+
+    gfx::Vector2dF screen_offset =
+        mouse_event.PositionInScreen() - mouse_event.PositionInWidget();
+    base::WeakPtr<InputHandler> handler = owner_->weak_factory_.GetWeakPtr();
+    scoped_refptr<base::SingleThreadTaskRunner> task_runner =
+        base::SingleThreadTaskRunner::GetCurrentDefault();
+
+    // path[0] is owner_->last_move_position_, already delivered by the
+    // previous move; path.back() is mouse_event's own destination, posted
+    // separately below via the real, unmodified event. Only the interior
+    // points are synthetic.
+    for (size_t i = 1; i + 1 < path.size(); ++i) {
+      blink::WebMouseEvent synthetic(mouse_event);
+      synthetic.SetPositionInWidget(path[i].x, path[i].y);
+      synthetic.SetPositionInScreen(gfx::PointF(path[i].x, path[i].y) +
+                                    screen_offset);
+      // Not from the debugger: OnInputEventAck only pops
+      // pending_mouse_callbacks_ for events carrying kFromDebugger, and
+      // this path's only queued callback belongs to the FINAL real event
+      // below -- a synthetic point that kept the bit would race that
+      // callback against whichever ack happens to arrive first.
+      synthetic.SetModifiers(mouse_event.GetModifiers() &
+                             ~blink::WebInputEvent::kFromDebugger);
+      task_runner->PostDelayedTask(
+          FROM_HERE,
+          base::BindOnce(&InputHandler::ForwardSyntheticMouseMove, handler,
+                         widget_host_, synthetic),
+          path[i].offset);
+    }
+
+    task_runner->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(&InputHandler::ForwardHumanizedMouseEventCompletion,
+                       handler, widget_host_,
+                       std::make_unique<blink::WebMouseEvent>(mouse_event),
+                       std::move(callback)),
+        path.back().offset);
+
+    owner_->last_move_widget_ = widget_host_;
+    owner_->last_move_position_ = mouse_event.PositionInWidget();
+  }
