+// FNV-1a 64. Folds are over launch-stable *content* (font family name, size /
+// weight / slope bits, text code units) -- never pointers -- so the jitter index
+// is reproducible across process launches (J3).
+constexpr uint64_t kFnvOffset = 0xcbf29ce484222325ULL;
+constexpr uint64_t kFnvPrime = 0x100000001b3ULL;
+
+inline uint64_t FnvByte(uint64_t h, uint8_t b) {
+  return (h ^ b) * kFnvPrime;
+}
+
+inline uint64_t FnvU32(uint64_t h, uint32_t v) {
+  for (int i = 0; i < 4; ++i) {
+    h = FnvByte(h, static_cast<uint8_t>(v & 0xffu));
+    v >>= 8;
+  }
+  return h;
+}
+
+// operator[] widens LChar to UChar, so the hash is identical whether the backing
+// store is 8- or 16-bit -- representation-independent, hence launch-stable.
+inline uint64_t FnvString(uint64_t h, const String& s) {
+  for (unsigned i = 0; i < s.length(); ++i) {
+    const UChar c = s[i];
+    h = FnvByte(h, static_cast<uint8_t>(c & 0xffu));
+    h = FnvByte(h, static_cast<uint8_t>((c >> 8) & 0xffu));
+  }
+  return h;
+}
+
+// Reproduces GetFontBaseline's switch on the jittered metric set M' so that the
+// single baseline_y' used by the y-block stays coherent with the (jittered)
+// font metrics. Kept byte-for-byte in step with GetFontBaseline, INCLUDING the
+// /100.0 (double) here vs the /100.0f (float) in the setHanging fallback below;
+// stock's tb=hanging residual depends on that asymmetry and J11 checks it.
+float MirroredBaseline(V8CanvasTextBaseline::Enum tb, float fa, float fd,
+                       float nta, float ntd, std::optional<float> hb,
+                       std::optional<float> ib, std::optional<float> ab) {
+  switch (tb) {
+    case V8CanvasTextBaseline::Enum::kTop:
+      return nta;
+    case V8CanvasTextBaseline::Enum::kHanging:
+      return hb ? *hb : fa * kHangingAsPercentOfAscent / 100.0;
+    case V8CanvasTextBaseline::Enum::kIdeographic:
+      return ib ? *ib : -fd;
+    case V8CanvasTextBaseline::Enum::kBottom:
+      return -ntd;
+    case V8CanvasTextBaseline::Enum::kMiddle:
+      return (nta - ntd) / 2.0f;
+    case V8CanvasTextBaseline::Enum::kAlphabetic:
+      return ab ? *ab : 0;
+    default:
+      return 0;
+  }
+}
