+                  std::move(audio_input_capabilities[j]));
+            }
+            transformed.push_back(input_device_info);
+          } else {
+            transformed.push_back(MakeGarbageCollected<MediaDeviceInfo>(
+                device_id, device_label, group_id, device_type));
+          }
+        }
+      }
+      media_devices = std::move(transformed);
+    }
+  }
