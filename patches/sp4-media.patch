@@ -14,6 +14,10 @@
 #include "base/strings/stringprintf.h"
 #include "base/uuid.h"
 #include "build/build_config.h"
+#include "components/camoucfg/blink_scope.h"
+#include "components/camoucfg/device_ids.h"
