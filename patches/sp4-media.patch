+  // SP4-media / media-ii: rewrite enumerateDevices() when configured.
+  //  - Pre-grant (real input ids empty): configured counts of empty-field
+  //    devices per kind (the original sp4-media spoof, unchanged).
+  //  - Post-grant (any non-empty id): each device keeps Chrome's ids, which
+  //    the browser already folds the seed into (S3b, media_devices_util.cc),
+  //    and shows the configured generic per-kind label, keeping the real
+  //    count.
+  // Active only with mediaDevices enabled AND a non-zero seed
+  // (camoucfg::ActiveMediaDevicesSeed), the same rule as the browser and the
+  // track getters; otherwise the real list is untouched.
+  const camoucfg::ConfigScope& camou_scope =
+      camoucfg::ScopeFor(GetExecutionContext());
+  if (camoucfg::ActiveMediaDevicesSeed(camou_scope) != 0) {
+    // S3: a grant shows as ANY non-empty id. A real audiooutput id proves a
+    // mic or speaker-selection grant (media_devices_permission_checker.cc),
+    // so a host with speakers and no inputs is post-grant too; before S3 it
+    // fell in here and lost its real speaker id.
+    bool camou_any_device_id = false;
+    for (const auto& kind_list : enumeration) {
+      for (const auto& d : kind_list) {
+        camou_any_device_id |= !d.device_id.empty();
+      }
+    }
+    if (!camou_any_device_id) {
+      const uint32_t micros =
+          camoucfg::GetUint32(camou_scope, camoucfg::keys::kMediaDevicesMicros)
+              .value_or(3);
+      const uint32_t webcams =
+          camoucfg::GetUint32(camou_scope, camoucfg::keys::kMediaDevicesWebcams)
+              .value_or(1);
+      const uint32_t speakers =
+          camoucfg::GetUint32(camou_scope,
+                              camoucfg::keys::kMediaDevicesSpeakers)
+              .value_or(1);
+      // Before a grant, Chrome lists at most ONE blank entry per kind
+      // (the spec's pre-permission exposure limit), however many devices
+      // exist: a count above one here is a shape stock never produces, so a
+      // count only decides whether the kind is present.
+      MediaDeviceInfoVector spoofed;
+      for (uint32_t k = 0; k < std::min(micros, 1u); ++k) {
+        spoofed.push_back(MakeGarbageCollected<InputDeviceInfo>(
+            g_empty_string, g_empty_string, g_empty_string,
+            mojom::blink::MediaDeviceType::kMediaAudioInput));
+      }
+      for (uint32_t k = 0; k < std::min(webcams, 1u); ++k) {
+        spoofed.push_back(MakeGarbageCollected<InputDeviceInfo>(
+            g_empty_string, g_empty_string, g_empty_string,
+            mojom::blink::MediaDeviceType::kMediaVideoInput));
+      }
+      for (uint32_t k = 0; k < std::min(speakers, 1u); ++k) {
+        spoofed.push_back(MakeGarbageCollected<MediaDeviceInfo>(
+            g_empty_string, g_empty_string, g_empty_string,
+            mojom::blink::MediaDeviceType::kMediaAudioOutput));
+      }
+      media_devices = std::move(spoofed);
+    } else {
+      const String camera_label = String::FromUtf8(
+          camoucfg::GetString(camou_scope,
+                              camoucfg::keys::kMediaDevicesCameraLabel)
+              .value_or(camoucfg::kDefaultCameraLabel));
+      const String microphone_label = String::FromUtf8(
+          camoucfg::GetString(camou_scope,
+                              camoucfg::keys::kMediaDevicesMicrophoneLabel)
+              .value_or(camoucfg::kDefaultMicrophoneLabel));
+      const String speaker_label = String::FromUtf8(
+          camoucfg::GetString(camou_scope,
+                              camoucfg::keys::kMediaDevicesSpeakerLabel)
+              .value_or(camoucfg::kDefaultSpeakerLabel));
+      MediaDeviceInfoVector transformed;
+      for (wtf_size_t i = 0;
+           i < static_cast<wtf_size_t>(
+                   mojom::blink::MediaDeviceType::kNumMediaDeviceTypes);
+           ++i) {
+        for (wtf_size_t j = 0; j < enumeration[i].size(); ++j) {
+          const mojom::blink::MediaDeviceType device_type =
+              static_cast<mojom::blink::MediaDeviceType>(i);
+          const WebMediaDeviceInfo& device_info = enumeration[i][j];
+          String label;
+          switch (device_type) {
+            case mojom::blink::MediaDeviceType::kMediaVideoInput:
+              label = camera_label;
+              break;
+            case mojom::blink::MediaDeviceType::kMediaAudioOutput:
+              label = speaker_label;
+              break;
+            default:
+              label = microphone_label;
+              break;
+          }
+          // S3b: Chrome's own ids; the browser folds the seed into them, so
+          // they round-trip through setSinkId, getUserMedia and the track.
+          const String device_id = String::FromUtf8(device_info.device_id);
+          const String group_id = String::FromUtf8(device_info.group_id);
+          // An ungranted-kind placeholder (empty real device_id, emitted for a
