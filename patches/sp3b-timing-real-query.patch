+// Backlog 4c: a page can time getParameter. These pnames' real queries are a
+// round trip to the GPU process (measured 190-220 us on SwiftShader against
+// under 1 us for the cached ones), so a configured value returned without the
+// query is a timing tell whatever the value. The configured value is returned
+// after the real query has run and its result been dropped.
+namespace {
+constinit thread_local bool g_camou_in_real_query = false;
+}  // namespace
+
+bool CamoucromeInRealQuery() {
+  return g_camou_in_real_query;
+}
+
+static bool CamoucromeIsGpuRoundTripParam(GLenum pname) {
+  switch (pname) {
+    case GL_SUBPIXEL_BITS:
+    case GL_RED_BITS:
+    case GL_GREEN_BITS:
+    case GL_BLUE_BITS:
+    case GL_ALPHA_BITS:
+    case GL_DEPTH_BITS:
+    case GL_SAMPLE_BUFFERS:
+    case GL_SAMPLES:
+    case GL_ALIASED_POINT_SIZE_RANGE:
+    case GL_ALIASED_LINE_WIDTH_RANGE:
+    case GL_VERSION:
+    case GL_SHADING_LANGUAGE_VERSION:
+    case GL_IMPLEMENTATION_COLOR_READ_TYPE:
+    case GL_IMPLEMENTATION_COLOR_READ_FORMAT:
+      return true;
+    default:
+      return false;
+  }
+}
+
+void CamoucromeTouchRealGLParam(WebGLRenderingContextBase* context,
+                                ScriptState* script_state,
+                                GLenum pname) {
+  if (g_camou_in_real_query || !CamoucromeIsGpuRoundTripParam(pname))
+    return;
+  g_camou_in_real_query = true;
+  context->getParameter(script_state, pname);  // result dropped
+  g_camou_in_real_query = false;
+}
