+namespace {
+
+// D gaps (docs/superpowers/measurements/2026-09-11-d-gaps.md): under
+// --ozone-platform=headless the host has no pointing device, so every pointer
+// and hover media query answers `none` while the UA claims a desktop. The
+// answer is derived from the claimed OS family and the configured
+// navigator.maxTouchPoints -- no key of its own, because an independent
+// override would only let `pointer` disagree with the OS. No claim
+// (OsFamily::kUnknown): the host's real value, untouched.
+struct ClaimedPointerHoverTypes {
+  int available_pointer_types;
+  mojom::blink::PointerType primary_pointer_type;
+  int available_hover_types;
+  mojom::blink::HoverType primary_hover_type;
+};
+
+std::optional<ClaimedPointerHoverTypes> ClaimedPointerHover(LocalFrame* frame) {
+  const camoucfg::ConfigScope& scope = camoucfg::ScopeFor(frame->DomWindow());
+  const camoucfg::OsFamily os = camoucfg::ClaimedOs(scope);
+  if (os == camoucfg::OsFamily::kUnknown) {
+    return std::nullopt;
+  }
+  using mojom::blink::HoverType;
+  using mojom::blink::PointerType;
+  if (os == camoucfg::OsFamily::kAndroid) {
+    return ClaimedPointerHoverTypes{
+        static_cast<int>(PointerType::kPointerCoarseType),
+        PointerType::kPointerCoarseType, static_cast<int>(HoverType::kHoverNone),
+        HoverType::kHoverNone};
+  }
+  int pointer_types = static_cast<int>(PointerType::kPointerFineType);
+  if (camoucfg::GetUint32(scope, camoucfg::keys::kNavigatorMaxTouchPoints)
+          .value_or(0) > 0) {
+    pointer_types |= static_cast<int>(PointerType::kPointerCoarseType);
+  }
+  return ClaimedPointerHoverTypes{
+      pointer_types, PointerType::kPointerFineType,
+      static_cast<int>(HoverType::kHoverHoverType), HoverType::kHoverHoverType};
+}
+
+}  // namespace
+
 mojom::blink::PointerType MediaValues::CalculatePrimaryPointerType(
     LocalFrame* frame) {
   DCHECK(frame);
   DCHECK(frame->GetSettings());
+  if (std::optional<ClaimedPointerHoverTypes> claimed =
+          ClaimedPointerHover(frame)) {
+    return claimed->primary_pointer_type;
+  }
   return frame->GetSettings()->GetPrimaryPointerType();
 }
 
 int MediaValues::CalculateAvailablePointerTypes(LocalFrame* frame) {
   DCHECK(frame);
   DCHECK(frame->GetSettings());
+  if (std::optional<ClaimedPointerHoverTypes> claimed =
+          ClaimedPointerHover(frame)) {
+    return claimed->available_pointer_types;
+  }
   return frame->GetSettings()->GetAvailablePointerTypes();
 }
 
