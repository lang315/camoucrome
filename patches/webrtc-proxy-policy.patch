 namespace renderer_preferences_util {
 
+namespace {
+
+// A proxy is configured when the command line names one or the proxy pref
+// (set by the profile, an enterprise policy, or the command-line pref store)
+// is fixed_servers or pac_script. Not covered: the system proxy (Linux
+// environment variables, gsettings), which is resolved later by the network
+// service and is not reachable from here.
+bool CamoucromeProxyConfigured(const PrefService* pref_service,
+                               const base::CommandLine& command_line) {
+  if (command_line.HasSwitch(::switches::kProxyServer) ||
+      command_line.HasSwitch(::switches::kProxyPacUrl)) {
+    return true;
+  }
+  ProxyConfigDictionary dict(
+      pref_service->GetDict(proxy_config::prefs::kProxy).Clone());
+  ProxyPrefs::ProxyMode mode;
+  return dict.GetMode(&mode) &&
+         (mode == ProxyPrefs::MODE_FIXED_SERVERS ||
+          mode == ProxyPrefs::MODE_PAC_SCRIPT);
+}
