 void NavigatorLanguage::EnsureUpdatedLanguage() {
+  // Camoucrome: a configured navigator.languages list is authoritative over the
+  // real Accept-Languages AND any DevTools Accept-Language override, so an
+  // automation client cannot desync this leaf from the chosen fingerprint. The
+  // list is written into the cached member, so languages() returns a stable
+  // reference across calls and language() stays its first element. No-op when
+  // the key is absent. Coherence with SP1a's Accept-Language header is the
+  // profile generator's job (a different key), not enforced here.
+  std::vector<std::string> configured_languages = camoucfg::GetStringList(
+      camoucfg::ScopeFor(execution_context_),
+      camoucfg::keys::kNavigatorLanguages);
+  if (!configured_languages.empty()) {
+    languages_.clear();
+    for (const std::string& lang : configured_languages) {
+      languages_.push_back(String::FromUtf8(lang));
+    }
+    languages_dirty_ = false;
+    return;
+  }
