+// An OS pointer sits on whole device pixels of the root window: in the content
+// view's DIP a position is k / dsf - origin, `origin` being the view's integer
+// DIP origin in its root window (ViewOriginInRootWindow). CDP gives fractional
+// CSS px, which no real mouse can show, so with `input:deviceGrid` set the
+// position of a mouse event is snapped here, once, at the CDP entry (absent:
+// the stock event, unchanged). Pen and touch are left as sent. `dsf` is the
+// view's hardware display scale, the one devicePixelRatio derives from. The
+// lattice formula is camoucfg::SnapToDeviceGrid.
+void SnapMouseToDeviceGrid(blink::WebMouseEvent& event,
+                           float dsf,
+                           const gfx::Vector2dF& origin,
+                           const gfx::Size& extent) {
+  if (event.pointer_type != blink::WebPointerProperties::PointerType::kMouse) {
+    return;
+  }
+  gfx::PointF p = event.PositionInWidget();
+  p.SetPoint(static_cast<float>(camoucfg::SnapToDeviceGrid(
+                 p.x(), dsf, origin.x(), extent.width())),
+             static_cast<float>(camoucfg::SnapToDeviceGrid(
+                 p.y(), dsf, origin.y(), extent.height())));
+  event.SetPositionInWidget(p);
+  event.SetPositionInScreen(p);
+}
+
+// The content view's origin in its root window, in whole DIP: the point the
+// OS pointer's own origin is measured from. Aura only; 0 elsewhere.
+gfx::Vector2dF ViewOriginInRootWindow(RenderWidgetHostViewBase* view) {
+#if defined(USE_AURA)
+  if (aura::Window* window = view->GetNativeView()) {
+    const gfx::Point origin = window->GetBoundsInRootWindow().origin();
+    return gfx::Vector2dF(origin.x(), origin.y());
+  }
+#endif
+  return gfx::Vector2dF();
+}
+
 gfx::Vector2dF CssPixelsToVector2dF(double x, double y, float scale_factor) {
   return gfx::Vector2dF(x * scale_factor, y * scale_factor);
 }
