+// A public (not internal-only) config: DefaultInternalWebUIConfig shows the
+// "debug pages disabled" stub while kInternalOnlyUisEnabled is off. The host is
+// not in ChromeURLHosts(), so chrome://chrome-urls matches stock.
+class ObserverUIConfig : public content::DefaultWebUIConfig<ObserverUI> {
+ public:
+  ObserverUIConfig()
+      : DefaultWebUIConfig(content::kChromeUIScheme,
+                           chrome::kChromeUIObserverHost) {}
+};
+
+// chrome://observer: records what a chosen tab reads and sends.
+class ObserverUI : public ui::MojoWebUIController {
+ public:
+  explicit ObserverUI(content::WebUI* web_ui);
+  ObserverUI(const ObserverUI&) = delete;
+  ObserverUI& operator=(const ObserverUI&) = delete;
+  ~ObserverUI() override;
+
+  void BindInterface(
+      mojo::PendingReceiver<observer::mojom::PageHandler> receiver);
+
+ private:
+  std::unique_ptr<ObserverPageHandler> handler_;
+
+  WEB_UI_CONTROLLER_TYPE_DECL();
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_OBSERVER_OBSERVER_UI_H_
