+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/webui/observer/observer_page_handler.h"
+#include "chrome/grit/observer_resources.h"
+#include "chrome/grit/observer_resources_map.h"
+#include "content/public/browser/web_ui_data_source.h"
+#include "ui/webui/webui_util.h"
+
+ObserverUI::ObserverUI(content::WebUI* web_ui)
+    : ui::MojoWebUIController(web_ui) {
+  content::WebUIDataSource* source = content::WebUIDataSource::CreateAndAdd(
+      Profile::FromWebUI(web_ui), chrome::kChromeUIObserverHost);
+  webui::SetupWebUIDataSource(source, kObserverResources,
+                              IDR_OBSERVER_OBSERVER_HTML);
+}
+
+ObserverUI::~ObserverUI() = default;
+
+WEB_UI_CONTROLLER_TYPE_IMPL(ObserverUI)
+
+void ObserverUI::BindInterface(
+    mojo::PendingReceiver<observer::mojom::PageHandler> receiver) {
+  handler_ = std::make_unique<ObserverPageHandler>(std::move(receiver));
+}
