+
+#ifndef CHROME_BROWSER_UI_WEBUI_OBSERVER_OBSERVER_PAGE_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_OBSERVER_OBSERVER_PAGE_HANDLER_H_
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/ui/webui/observer/observer.mojom.h"
+#include "mojo/public/cpp/bindings/pending_receiver.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "services/data_decoder/public/cpp/data_decoder.h"
+#include "services/data_decoder/public/mojom/camou_observe_decoder.mojom.h"
+#include "third_party/perfetto/include/perfetto/tracing/tracing.h"
+
+// Browser-process side of chrome://observer. Records the tracing categories the
+// observer hooks emit and hands the raw trace to the sandboxed decoder. It
+// parses nothing it captured. The recorded tab is a key (top site and top frame
+// id), never a frame pointer, so a closed or navigated tab keeps its recording.
+// Every perfetto callback runs on a perfetto thread and hops to the UI thread
+// through a WeakPtr, so a closed page drops it.
+class ObserverPageHandler : public observer::mojom::PageHandler {
+ public:
+  static constexpr size_t kMaxTraceBytes = size_t{64} << 20;
+
+  explicit ObserverPageHandler(
+      mojo::PendingReceiver<observer::mojom::PageHandler> receiver);
+  ObserverPageHandler(const ObserverPageHandler&) = delete;
+  ObserverPageHandler& operator=(const ObserverPageHandler&) = delete;
+  ~ObserverPageHandler() override;
+
+  // observer::mojom::PageHandler:
+  void GetTabs(GetTabsCallback callback) override;
+  void Start(int32_t child_id,
+             int32_t frame_routing_id,
+             const std::string& truth_json,
+             StartCallback callback) override;
+  void Refresh(RefreshCallback callback) override;
+  void Stop(StopCallback callback) override;
+
+ private:
+  // The first argument is the session_gen_ the callback was bound under; a
+  // callback from an earlier session is ignored.
+  void OnStarted(uint32_t gen);
+  void OnStartFailed(uint32_t gen, const std::string& message);
+  void OnCloned(uint32_t gen, bool success, const std::string& error);
+  void OnTraceChunk(uint32_t gen, std::vector<uint8_t> chunk, bool has_more);
+  void OnStats(uint32_t gen, bool success, std::vector<uint8_t> stats);
+  void Decode(std::vector<uint8_t> stats);
+  void OnDecoded(const std::string& tables_json);
+  void FinishRefresh(const std::string& tables_json, const std::string& error);
+  void OnDecoderDisconnected();
+  void AbortPending(const std::string& error);
+  void BindDecoder();
+  void StopSession();
+
+  std::unique_ptr<perfetto::TracingSession> session_;
+  // The snapshot session of one refresh (see Refresh()), and the name its
+  // CloneTrace() finds the recording by.
+  std::unique_ptr<perfetto::TracingSession> clone_;
+  std::string session_name_;
+  std::vector<uint8_t> trace_;
+  std::string truth_json_;
+  data_decoder::mojom::CamouObserveTabKeyPtr tab_;
+  std::unique_ptr<data_decoder::DataDecoder> decoder_;
+  mojo::Remote<data_decoder::mojom::CamouObserveDecoder> remote_;
+  bool buffer_full_ = false;
+  uint32_t session_gen_ = 0;
+  StartCallback start_callback_;
+  RefreshCallback refresh_callback_;
+
+  mojo::Receiver<observer::mojom::PageHandler> receiver_;
+  base::WeakPtrFactory<ObserverPageHandler> weak_factory_{this};
+};
+
+#endif  // CHROME_BROWSER_UI_WEBUI_OBSERVER_OBSERVER_PAGE_HANDLER_H_
