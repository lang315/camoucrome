+#include "chrome/browser/ui/webui/observer/observer_page_handler.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/byte_size.h"
+#include "base/compiler_specific.h"
+#include "base/environment.h"
+#include "base/containers/span.h"
+#include "base/functional/bind.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/trace_event/trace_config.h"
+#include "base/unguessable_token.h"
+#include "chrome/browser/ui/tab_contents/tab_contents_iterator.h"
+#include "chrome/common/webui_url_constants.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/browser_thread.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "mojo/public/cpp/base/big_buffer.h"
+#include "net/base/schemeful_site.h"
+#include "services/tracing/public/cpp/perfetto/perfetto_config.h"
+#include "third_party/blink/public/common/tokens/tokens.h"
+
+namespace {
+
+constexpr char kDefaultFilter[] =
+    "-*,disabled-by-default-camou.observe,disabled-by-default-camou.observe."
+    "send";
+// Verify-only override (Task 12's blind row), like OBSERVE_DISPATCH_EXACT.
+constexpr char kFilterEnv[] = "OBSERVER_PAGE_FILTER";
+
+}  // namespace
+
+ObserverPageHandler::ObserverPageHandler(
+    mojo::PendingReceiver<observer::mojom::PageHandler> receiver)
+    : receiver_(this, std::move(receiver)) {}
+
+ObserverPageHandler::~ObserverPageHandler() {
+  AbortPending("page closed");
+  StopSession();
+}
+
+void ObserverPageHandler::GetTabs(GetTabsCallback callback) {
+  std::vector<observer::mojom::TabPtr> tabs;
+  tabs::ForEachTabInterface([&tabs](tabs::TabInterface* tab) {
+    content::WebContents* contents = tab->GetContents();
+    if (!contents) {
+      return true;
+    }
+    const GURL& url = contents->GetVisibleURL();
+    if (url.SchemeIs(content::kChromeUIScheme) &&
+        url.host() == chrome::kChromeUIObserverHost) {
+      return true;
+    }
+    const content::GlobalRenderFrameHostId id =
+        contents->GetPrimaryMainFrame()->GetGlobalId();
+    tabs.push_back(observer::mojom::Tab::New(
+        id.child_id.value(), id.frame_routing_id,
+        base::UTF16ToUTF8(contents->GetTitle()), url.spec()));
+    return true;
+  });
+  std::move(callback).Run(std::move(tabs));
+}
+
+void ObserverPageHandler::Start(int32_t child_id,
+                                int32_t frame_routing_id,
+                                const std::string& truth_json,
+                                StartCallback callback) {
+  AbortPending("restarted");
+  StopSession();
+  ++session_gen_;
+  trace_.clear();
+  trace_.shrink_to_fit();
+  buffer_full_ = false;
+
+  content::RenderFrameHost* rfh =
+      content::RenderFrameHost::FromID(child_id, frame_routing_id);
+  if (!rfh) {
+    std::move(callback).Run("tab gone");
+    return;
+  }
+  // The same token the network service got as top_frame_id
+  // (RenderFrameHostImpl::GetTopFrameToken). The key is stored, never the frame.
+  content::RenderFrameHost* top = rfh;
+  while (top->GetParent()) {
+    top = top->GetParent();
+  }
+  tab_ = data_decoder::mojom::CamouObserveTabKey::New(
+      net::SchemefulSite(rfh->GetLastCommittedOrigin()).Serialize(),
+      top->GetFrameToken().value().ToString());
+  truth_json_ = truth_json;
+  BindDecoder();
+
+  std::string filter = kDefaultFilter;
+  if (std::optional<std::string> env =
+          base::Environment::Create()->GetVar(kFilterEnv)) {
+    filter = *env;
+  }
+  base::trace_event::TraceConfig chrome_config(
+      filter, base::trace_event::RECORD_CONTINUOUSLY);
+  chrome_config.SetTraceBufferSizeInBytes(base::MiB(32));
+  perfetto::TraceConfig config = tracing::GetDefaultPerfettoConfig(
+      chrome_config, /*privacy_filtering_enabled=*/false,
+      /*convert_to_legacy_json=*/false);
+
+  start_callback_ = std::move(callback);
+  session_name_ = base::UnguessableToken::Create().ToString();
+  config.set_unique_session_name(session_name_);
+  session_ = perfetto::Tracing::NewTrace(perfetto::kCustomBackend);
+  session_->Setup(config);
+  base::WeakPtr<ObserverPageHandler> weak = weak_factory_.GetWeakPtr();
+  const uint32_t gen = session_gen_;
+  session_->SetOnStartCallback([weak, gen] {
+    content::GetUIThreadTaskRunner({})->PostTask(
+        FROM_HERE, base::BindOnce(&ObserverPageHandler::OnStarted, weak, gen));
+  });
+  session_->SetOnErrorCallback([weak, gen](perfetto::TracingError error) {
+    content::GetUIThreadTaskRunner({})->PostTask(
+        FROM_HERE, base::BindOnce(&ObserverPageHandler::OnStartFailed, weak,
+                                  gen, error.message));
+  });
+  session_->Start();
+}
+
+void ObserverPageHandler::OnStarted(uint32_t gen) {
+  if (gen == session_gen_ && start_callback_) {
+    std::move(start_callback_).Run(std::string());
+  }
+}
+
+void ObserverPageHandler::OnStartFailed(uint32_t gen,
+                                        const std::string& message) {
+  if (gen != session_gen_) {
+    return;
+  }
+  session_.reset();
+  if (start_callback_) {
+    std::move(start_callback_).Run("recording could not start: " + message);
+  }
+  if (refresh_callback_) {
+    FinishRefresh(std::string(), "recording stopped: " + message);
+  }
+}
+
+void ObserverPageHandler::Refresh(RefreshCallback callback) {
+  if (refresh_callback_) {
+    std::move(callback).Run(
+        observer::mojom::RefreshResult::New("", buffer_full_, "busy"));
+    return;
+  }
+  if (!session_ && !buffer_full_) {
+    std::move(callback).Run(
+        observer::mojom::RefreshResult::New("", false, "not recording"));
+    return;
+  }
+  refresh_callback_ = std::move(callback);
+  if (!session_) {
+    // The buffer filled and the session was stopped: decode what was kept.
+    Decode({});
+    return;
+  }
+  // The custom backend's consumer endpoint does not implement Flush() (it is a
+  // NOTREACHED, a browser abort), and the producers commit a chunk only when it
+  // is full. CloneTrace() flushes every producer and snapshots the whole buffer
+  // (as chrome://traces does), so each refresh reads the full recording again.
+  clone_ = perfetto::Tracing::NewTrace(perfetto::kCustomBackend);
+  base::WeakPtr<ObserverPageHandler> weak = weak_factory_.GetWeakPtr();
+  const uint32_t gen = session_gen_;
+  perfetto::TracingSession::CloneTraceArgs args{
+      .unique_session_name = session_name_};
+  clone_->CloneTrace(
+      args, [weak, gen](perfetto::TracingSession::CloneTraceCallbackArgs args) {
+        content::GetUIThreadTaskRunner({})->PostTask(
+            FROM_HERE, base::BindOnce(&ObserverPageHandler::OnCloned, weak, gen,
+                                      args.success, args.error));
+      });
+}
+
+void ObserverPageHandler::OnCloned(uint32_t gen,
+                                   bool success,
+                                   const std::string& error) {
+  if (gen != session_gen_ || !refresh_callback_) {
+    return;
+  }
+  if (!success || !clone_) {
+    clone_.reset();
+    FinishRefresh(std::string(), "recording could not be read: " + error);
+    return;
+  }
+  trace_.clear();  // the snapshot holds the whole recording
+  base::WeakPtr<ObserverPageHandler> weak = weak_factory_.GetWeakPtr();
+  clone_->ReadTrace(
+      [weak, gen](perfetto::TracingSession::ReadTraceCallbackArgs args) {
+        // args.data is valid only inside this callback: copy it.
+        std::vector<uint8_t> chunk;
+        if (args.data && args.size) {
+          base::span<const uint8_t> bytes = UNSAFE_BUFFERS(base::span(
+              reinterpret_cast<const uint8_t*>(args.data), args.size));
+          chunk.assign(bytes.begin(), bytes.end());
+        }
+        content::GetUIThreadTaskRunner({})->PostTask(
+            FROM_HERE, base::BindOnce(&ObserverPageHandler::OnTraceChunk, weak,
+                                      gen, std::move(chunk), args.has_more));
+      });
+}
+
+void ObserverPageHandler::OnTraceChunk(uint32_t gen,
+                                       std::vector<uint8_t> chunk,
+                                       bool has_more) {
+  if (gen != session_gen_ || !refresh_callback_) {
+    return;
+  }
+  if (!buffer_full_) {
+    if (trace_.size() + chunk.size() > kMaxTraceBytes) {
+      // Drop the chunk and every later one: the kept trace is a clean prefix.
+      buffer_full_ = true;
+    } else {
+      trace_.insert(trace_.end(), chunk.begin(), chunk.end());
+    }
+  }
+  if (has_more) {
+    return;
+  }
+  clone_.reset();
+  if (buffer_full_ || !session_) {
+    StopSession();
+    Decode({});
+    return;
+  }
+  base::WeakPtr<ObserverPageHandler> weak = weak_factory_.GetWeakPtr();
+  session_->GetTraceStats(
+      [weak, gen](perfetto::TracingSession::GetTraceStatsCallbackArgs args) {
+        content::GetUIThreadTaskRunner({})->PostTask(
+            FROM_HERE,
+            base::BindOnce(&ObserverPageHandler::OnStats, weak, gen,
+                           args.success, std::move(args.trace_stats_data)));
+      });
+}
+
+void ObserverPageHandler::OnStats(uint32_t gen,
+                                  bool success,
+                                  std::vector<uint8_t> stats) {
+  if (gen != session_gen_ || !refresh_callback_) {
+    return;
+  }
+  Decode(success ? std::move(stats) : std::vector<uint8_t>());
+}
+
+void ObserverPageHandler::Decode(std::vector<uint8_t> stats) {
+  if (!remote_.is_bound()) {
+    BindDecoder();
+  }
+  remote_->Decode(
+      mojo_base::BigBuffer(trace_), mojo_base::BigBuffer(stats), truth_json_,
+      tab_.Clone(),
+      base::BindOnce(&ObserverPageHandler::OnDecoded,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void ObserverPageHandler::OnDecoded(const std::string& tables_json) {
+  FinishRefresh(tables_json, std::string());
+}
+
+void ObserverPageHandler::FinishRefresh(const std::string& tables_json,
+                                        const std::string& error) {
+  if (refresh_callback_) {
+    std::move(refresh_callback_)
+        .Run(observer::mojom::RefreshResult::New(tables_json, buffer_full_,
+                                                 error));
+  }
+}
+
+void ObserverPageHandler::BindDecoder() {
+  remote_.reset();
+  decoder_ = std::make_unique<data_decoder::DataDecoder>();
+  decoder_->GetService()->BindCamouObserveDecoder(
+      remote_.BindNewPipeAndPassReceiver());
+  remote_.set_disconnect_handler(base::BindOnce(
+      &ObserverPageHandler::OnDecoderDisconnected, base::Unretained(this)));
+}
+
+void ObserverPageHandler::OnDecoderDisconnected() {
+  // Rebound by the next Refresh.
+  remote_.reset();
+  decoder_.reset();
+  FinishRefresh(std::string(), "decoder stopped");
+}
+
+void ObserverPageHandler::Stop(StopCallback callback) {
+  AbortPending("stopped");
+  StopSession();
+  ++session_gen_;
+  trace_.clear();
+  trace_.shrink_to_fit();
+  truth_json_.clear();
+  tab_.reset();
+  buffer_full_ = false;
+  remote_.reset();
+  decoder_.reset();
+  std::move(callback).Run();
+}
+
+void ObserverPageHandler::AbortPending(const std::string& error) {
+  if (start_callback_) {
+    std::move(start_callback_).Run(error);
+  }
+  FinishRefresh(std::string(), error);
+}
+
+void ObserverPageHandler::StopSession() {
+  // Destroying the session stops it and drops in-flight perfetto callbacks;
+  // the ones already posted to the UI thread find their WeakPtr or state gone.
+  session_.reset();
+  clone_.reset();
+}
