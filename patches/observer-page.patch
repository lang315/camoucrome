+// Copyright 2026 The Camoucrome Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+module observer.mojom;
+
+struct Tab {
+  int32 child_id;
+  int32 frame_routing_id;
+  string title;
+  string url;
+};
+
+struct RefreshResult {
+  string tables_json;  // from the sandboxed decoder, unparsed here
+  bool buffer_full;
+  string error;        // empty on success
+};
+
+interface PageHandler {
+  GetTabs() => (array<Tab> tabs);
+  // truth_json: the page's own reads. error is empty once recording runs,
+  // else "recording could not start: <perfetto's error>" or "tab gone".
+  Start(int32 child_id, int32 frame_routing_id, string truth_json)
+      => (string error);
+  Refresh() => (RefreshResult result);
+  Stop() => ();
+};
