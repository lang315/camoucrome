diff --git a/chrome/browser/resources/observer/observer.ts b/chrome/browser/resources/observer/observer.ts
new file mode 100644
index 0000000000..dd9ed93954
--- /dev/null
+++ b/chrome/browser/resources/observer/observer.ts
@@ -0,0 +1,280 @@
+// Copyright 2026 The Camoucrome Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {getRequiredElement} from 'chrome://resources/js/util.js';
+
+import {PageHandler} from './observer.mojom-webui.js';
+
+const REFRESH_MS = 5000;
+
+const handler = PageHandler.getRemote();
+const tabSelect = getRequiredElement<HTMLSelectElement>('tab');
+const recordButton = getRequiredElement<HTMLButtonElement>('record');
+const stopButton = getRequiredElement<HTMLButtonElement>('stop');
+const statusEl = getRequiredElement('status');
+const readsTable = getRequiredElement<HTMLTableElement>('reads');
+const sendsTable = getRequiredElement<HTMLTableElement>('sends');
+const rawEl = getRequiredElement('raw');
+
+let timer: number|undefined;
+let refreshes = 0;
+let busy = false;
+let lastStatus: Tables['status']|undefined;
+
+// Everything below renders with textContent only: the values are strings a
+// page chose.
+function setStatus(
+    label: string, st?: {events?: number, lost?: number, cut?: number, missing?: number}) {
+  const s = st || {};
+  statusEl.textContent = `${label} events ${s.events || 0} lost ${s.lost || 0} ` +
+      `cut ${s.cut || 0} missing ${s.missing || 0}`;
+}
+
+function render(
+    table: HTMLTableElement, headers: string[], rows: string[][],
+    fieldRows: Set<number> = new Set()) {
+  table.textContent = '';
+  const head = table.createTHead().insertRow();
+  for (const h of headers) {
+    const th = document.createElement('th');
+    th.textContent = h;
+    head.appendChild(th);
+  }
+  const body = table.createTBody();
+  rows.forEach((cells, i) => {
+    const tr = body.insertRow();
+    if (fieldRows.has(i)) {
+      tr.className = 'field';
+    }
+    for (const c of cells) {
+      tr.insertCell().textContent = c;
+    }
+  });
+}
+
+function map(m: unknown): string {
+  return Object.entries((m || {}) as Record<string, unknown>)
+      .map(([k, v]) => `${k}:${v}`)
+      .join(' ');
+}
+
+function hits(l: unknown): string {
+  return ((l || []) as Array<{surface: string, encoding: string, count: number}>)
+      .map(h => `${h.surface}/${h.encoding}:${h.count}`)
+      .join(' ');
+}
+
+interface Tables {
+  status?: {events?: number, lost?: number, cut?: number, missing?: number, self_reads?: number};
+  reads?: Array<Record<string, unknown>>;
+  sends?: Array<Record<string, unknown>>;
+}
+
+function renderTables(t: Tables) {
+  render(
+      readsTable, ['site', 'member', 'count', 'origin', 'script', 'by'],
+      (t.reads || []).map(
+          r => [r['site'], r['member'], r['count'], r['origin'], r['script'], r['by']].map(String)));
+  const rows: string[][] = [];
+  const fieldRows = new Set<number>();
+  for (const s of t.sends || []) {
+    rows.push(
+        [s['via'], s['endpoint'], s['topic'], s['by'], s['count'], map(s['kinds']), s['cut'], s['missing'], '', '', '', '', '', '']
+            .map(String));
+    type Field = {path: string, classes: unknown, samples: string[], strong: unknown, weak: unknown, bool: Array<{surface: string, count: number}>};
+    for (const f of (s['fields'] || []) as Field[]) {
+      fieldRows.add(rows.length);
+      rows.push([
+        '', '', '', '', '', '', '', '', f.path, map(f.classes), (f.samples || []).join(' | '),
+        hits(f.strong), hits(f.weak), (f.bool || []).map(b => `${b.surface}:${b.count}`).join(' '),
+      ]);
+    }
+  }
+  render(
+      sendsTable,
+      ['via', 'endpoint', 'topic', 'by', 'count', 'kinds', 'cut', 'missing', 'path', 'classes', 'samples', 'strong', 'weak', 'bool'],
+      rows, fieldRows);
+}
+
+function clearTables() {
+  readsTable.textContent = '';
+  sendsTable.textContent = '';
+  rawEl.textContent = '';
+}
+
+// A port of observe_drive.TRUTH_JS: same keys, same fallbacks.
+async function readTruth(): Promise<Record<string, unknown>> {
+  /* eslint-disable @typescript-eslint/no-explicit-any */
+  const n = navigator as any;
+  const s = screen;
+  const c = n.connection || {};
+  const ua = n.userAgentData;
+  let gl: {vendor?: unknown, renderer?: unknown, version?: unknown} = {};
+  let f16: boolean|null = null;
+  try {  // null where there is no WebGL or no adapter
+    const cv = document.createElement('canvas');
+    const ctx = (cv.getContext('webgl') || cv.getContext('experimental-webgl')) as WebGLRenderingContext | null;
+    if (ctx) {
+      const e = ctx.getExtension('WEBGL_debug_renderer_info');
+      gl = {
+        vendor: e ? ctx.getParameter(e.UNMASKED_VENDOR_WEBGL) : null,
+        renderer: e ? ctx.getParameter(e.UNMASKED_RENDERER_WEBGL) : null,
+        version: ctx.getParameter(ctx.VERSION),
+      };
+    }
+  } catch (_) {
+  }
+  try {
+    if (n.gpu) {
+      const ad = await Promise.race([
+        n.gpu.requestAdapter(),
+        new Promise(r => setTimeout(() => r(null), 2000)),
+      ]);
+      f16 = ad ? ad.features.has('shader-f16') : null;
+    }
+  } catch (_) {
+  }
+  const pm = (performance as any).memory;  // Chromium only; absent: keys omitted
+  const he = ua ?
+      await ua.getHighEntropyValues(['architecture', 'bitness', 'model', 'platformVersion', 'fullVersionList']) :
+      {};
+  const brands = (l: Array<{brand: string, version: string}>) => l.map(b => ({brand: b.brand, version: b.version}));
+  return {
+    'navigator.userAgent': n.userAgent,
+    'navigator.platform': n.platform,
+    'navigator.vendor': n.vendor,
+    'navigator.language': n.language,
+    'navigator.languages': [...n.languages],
+    'navigator.hardwareConcurrency': n.hardwareConcurrency,
+    'navigator.deviceMemory': n.deviceMemory,
+    'navigator.maxTouchPoints': n.maxTouchPoints,
+    'screen.width': s.width,
+    'screen.height': s.height,
+    'screen.availWidth': s.availWidth,
+    'screen.availHeight': s.availHeight,
+    'screen.colorDepth': s.colorDepth,
+    'window.devicePixelRatio': devicePixelRatio,
+    'window.innerWidth': innerWidth,
+    'window.innerHeight': innerHeight,
+    'window.outerWidth': outerWidth,
+    'window.outerHeight': outerHeight,
+    'timezone': Intl.DateTimeFormat().resolvedOptions().timeZone,
+    'timezoneOffset': new Date().getTimezoneOffset(),
+    'connection.effectiveType': c.effectiveType,
+    'connection.rtt': c.rtt,
+    'connection.downlink': c.downlink,
+    'uaData.platform': ua ? ua.platform : null,
+    'uaData.mobile': ua ? ua.mobile : null,
+    'uaData.brands': ua ? brands(ua.brands) : null,
+    'uaData.architecture': he.architecture || null,
+    'uaData.bitness': he.bitness || null,
+    'uaData.model': he.model || null,
+    'uaData.platformVersion': he.platformVersion || null,
+    'uaData.fullVersionList': he.fullVersionList ? brands(he.fullVersionList) : null,
+    'webgl.vendor': gl.vendor || null,
+    'webgl.renderer': gl.renderer || null,
+    'webgl.version': gl.version || null,
+    'media.dynamicRangeHigh': matchMedia('(dynamic-range: high)').matches,
+    'navigator.gpu.present': !!n.gpu,
+    'webgpu.shaderF16': f16,
+    'navigator.ml.present': 'ml' in n,
+    ...(pm ? {
+      'performance.memory.jsHeapSizeLimit': pm.jsHeapSizeLimit,
+      'performance.memory.totalJSHeapSize': pm.totalJSHeapSize,
+      'performance.memory.usedJSHeapSize': pm.usedJSHeapSize,
+    } : {}),
+  };
+}
+
+async function loadTabs() {
+  const {tabs} = await handler.getTabs();
+  tabSelect.textContent = '';
+  for (const t of tabs) {
+    const o = document.createElement('option');
+    o.value = `${t.childId},${t.frameRoutingId}`;
+    o.textContent = `${t.title} - ${t.url}`;
+    tabSelect.appendChild(o);
+  }
+}
+
+async function refresh() {
+  if (busy) {
+    return;
+  }
+  busy = true;
+  try {
+    // The canary: the page's own read, origin chrome://observer. Its event
+    // proves the hooks report; self_reads == 0 after a refresh means blind.
+    void navigator.hardwareConcurrency;
+    const {result} = await handler.refresh();
+    if (timer === undefined) {
+      return;  // stopped meanwhile
+    }
+    if (result.error) {
+      setStatus(result.error, lastStatus);
+      return;
+    }
+    rawEl.textContent = result.tablesJson;
+    let t: Tables = {};
+    try {
+      t = JSON.parse(result.tablesJson) as Tables;
+    } catch (_) {
+      setStatus('bad tables');
+      return;
+    }
+    refreshes++;
+    lastStatus = t.status;
+    renderTables(t);
+    const blind = refreshes > 1 && (t.status?.self_reads || 0) === 0;
+    setStatus(result.bufferFull ? 'buffer full' : blind ? 'blind' : 'recording', t.status);
+  } finally {
+    busy = false;
+  }
+}
+
+async function record() {
+  recordButton.disabled = true;
+  const [childId, frameRoutingId] = tabSelect.value.split(',').map(Number);
+  if (childId === undefined || frameRoutingId === undefined || Number.isNaN(childId)) {
+    recordButton.disabled = false;
+    setStatus('tab gone');
+    return;
+  }
+  let error = '';
+  try {
+    const truth = await readTruth();
+    ({error} = await handler.start(childId, frameRoutingId, JSON.stringify(truth)));
+  } catch (e) {
+    error = String(e);
+  }
+  if (error) {
+    setStatus(error);
+    recordButton.disabled = false;
+    return;
+  }
+  refreshes = 0;
+  lastStatus = undefined;
+  stopButton.disabled = false;
+  tabSelect.disabled = true;
+  setStatus('recording');
+  timer = window.setInterval(() => void refresh(), REFRESH_MS);
+}
+
+async function stop() {
+  window.clearInterval(timer);
+  timer = undefined;
+  await handler.stop();
+  clearTables();
+  setStatus('off');
+  stopButton.disabled = true;
+  recordButton.disabled = false;
+  tabSelect.disabled = false;
+  void loadTabs();
+}
+
+recordButton.addEventListener('click', () => void record());
+stopButton.addEventListener('click', () => void stop());
+tabSelect.addEventListener('focus', () => void loadTabs());
+void loadTabs();
+setStatus('off');
