+// Camoucrome media-ii: a granted track's label matches its enumerate entry.
+// Its ids need no change: the browser folds the seed into Chrome's own device
+// and group ids (S3b, media_devices_util.cc), so getSettings() and
+// getCapabilities() already equal the enumerate list.
+// Configured generic label for a real *device* track's kind, or the real
+// source name when spoofing is off. Non-device tracks (empty device_id) keep
+// their real source name so a screen/canvas track is not mislabelled as a
+// camera. Matches the label media_devices.cc writes for the same kind.
+String CamouMaskLabel(ExecutionContext* ec,
+                      MediaStreamSource::StreamType source_type,
+                      const String& real_device_id,
+                      const String& real_label) {
+  const camoucfg::ConfigScope& scope = camoucfg::ScopeFor(ec);
+  if (real_device_id.empty() || ec == nullptr ||
+      camoucfg::ActiveMediaDevicesSeed(scope) == 0) {
+    return real_label;
+  }
+  // S3: the same MaskedDeviceLabel as the enumerate list, so a "default" or
+  // "communications" track keeps Chrome's "<prefix> - " exactly as its
+  // enumerate entry does (track label == enumerate label, media-ii M4).
+  const std::string configured =
+      source_type == MediaStreamSource::kTypeVideo
+          ? camoucfg::GetString(scope, camoucfg::keys::kMediaDevicesCameraLabel)
+                .value_or(camoucfg::kDefaultCameraLabel)
+          : camoucfg::GetString(scope,
+                                camoucfg::keys::kMediaDevicesMicrophoneLabel)
+                .value_or(camoucfg::kDefaultMicrophoneLabel);
+  return String::FromUtf8(camoucfg::MaskedDeviceLabel(
+      real_device_id.Utf8(), real_label.Utf8(), configured));
+}
+
