+// Camoucrome media-ii: make a granted track's ids/label coherent with the
+// sp4-media-spoofed enumerateDevices(). The device-id fold uses the SAME
+// camoucfg::SyntheticDeviceId (over the SAME real id, kind, origin and seed)
+// that media_devices.cc's post-grant enumerate transform uses, so a track and
+// its enumerate entry agree by construction. Active only when mediaDevices
+// spoofing is enabled AND a non-zero seed is configured; otherwise the real
+// value is returned unchanged.
+bool CamouMediaSpoofActive(ExecutionContext* ec, uint32_t& seed) {
+  const camoucfg::ConfigScope& scope = camoucfg::ScopeFor(ec);
+  seed = camoucfg::GetUint32(scope, camoucfg::keys::kMediaDevicesSeed)
+             .value_or(0);
+  return ec != nullptr &&
+         camoucfg::GetBool(scope, camoucfg::keys::kMediaDevicesEnabled)
+             .value_or(false) &&
+         seed != 0;
+}
+
+// Origin-salted synthetic form of a real device/group id, or the real id
+// unchanged when spoofing is off. Empty real ids (non-device tracks such as
+// canvas.captureStream()/getDisplayMedia()) pass through untouched, and
+// SyntheticDeviceId preserves the "default" audio sentinel. `group` selects
+// the "group" kind fold; otherwise the track's audioinput/videoinput kind --
+// the kind strings are shared VERBATIM with media_devices.cc.
+String CamouMaskDeviceId(ExecutionContext* ec,
+                         MediaStreamSource::StreamType source_type,
+                         const String& real_id,
+                         bool group) {
+  uint32_t seed = 0;
+  if (real_id.empty() || !CamouMediaSpoofActive(ec, seed)) {
+    return real_id;
+  }
+  const std::string origin = ec->GetSecurityOrigin()->ToString().Utf8();
+  const std::string_view kind =
+      group ? std::string_view("group")
+            : (source_type == MediaStreamSource::kTypeVideo
+                   ? std::string_view("videoinput")
+                   : std::string_view("audioinput"));
+  return String::FromUtf8(
+      camoucfg::SyntheticDeviceId(seed, kind, real_id.Utf8(), origin));
+}
+
+// Configured generic label for a real *device* track's kind, or the real
+// source name when spoofing is off. Non-device tracks (empty device_id) keep
+// their real source name so a screen/canvas track is not mislabelled as a
+// camera. Matches the label media_devices.cc writes for the same kind.
+String CamouMaskLabel(ExecutionContext* ec,
+                      MediaStreamSource::StreamType source_type,
+                      const String& real_device_id,
+                      const String& real_label) {
+  uint32_t seed = 0;
+  if (real_device_id.empty() || !CamouMediaSpoofActive(ec, seed)) {
+    return real_label;
+  }
+  const camoucfg::ConfigScope& scope = camoucfg::ScopeFor(ec);
+  if (source_type == MediaStreamSource::kTypeVideo) {
+    return String::FromUtf8(
+        camoucfg::GetString(scope, camoucfg::keys::kMediaDevicesCameraLabel)
+            .value_or("Integrated Camera"));
+  }
+  return String::FromUtf8(
+      camoucfg::GetString(scope, camoucfg::keys::kMediaDevicesMicrophoneLabel)
+          .value_or("Microphone (Realtek Audio)"));
+}
+
