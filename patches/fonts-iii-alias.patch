     AlternateFontName alternate_font_name) {
   TRACE_EVENT0("fonts", "FontCache::GetFontPlatformData");
 
+  // Camoucrome (fonts-iii): a configured alias (fonts:alias) replaces the
+  // requested family before any lookup, system-ui included, so a claimed
+  // family the host lacks renders in the bundled font it maps to. Skia's
+  // fontconfig path only accepts a match whose family equals the request,
+  // which is why a fontconfig alias alone cannot do this. The allowlist
+  // (fonts:list, FontFallbackList) has already judged the requested name;
+  // pages observe widths, never the resolved name. No key: the real lookup.
+  if (creation_params.CreationType() == kCreateFontByFamily &&
+      !creation_params.Family().empty()) {
+    // A src:local() lookup names a face (full or PostScript name) and lands on
+    // a face's full name (fonts:aliasLocal); a CSS request names a family and
+    // lands on a family (fonts:alias). One map cannot serve both.
+    const bool unique_name =
+        alternate_font_name == AlternateFontName::kLocalUniqueFace;
+    if (std::optional<std::string> target = camoucfg::FontAlias(
+            camoucfg::ScopeFor(nullptr), creation_params.Family().Utf8(),
+            unique_name)) {
+      const AtomicString aliased =
+          AtomicString::FromUtf8(base::as_byte_span(*target));
+      // One hop only: a target that is itself a key of the map (a chain or a
+      // cycle in hand-written config) is not followed, so the recursive call
+      // below never aliases again. Bad config must not crash a renderer.
+      if (aliased != creation_params.Family() &&
+          !camoucfg::FontAlias(camoucfg::ScopeFor(nullptr), *target,
+                               unique_name)) {
+        return GetFontPlatformData(font_description,
+                                   FontFaceCreationParams(aliased),
+                                   alternate_font_name);
+      }
+    }
+  }
