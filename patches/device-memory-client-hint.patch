@@ -8,6 +8,8 @@
 #include "base/check_op.h"
 #include "base/feature_list.h"
 #include "base/system/sys_info.h"
+#include "components/camoucfg/hot_config.h"
+#include "components/camoucfg/mask_config.h"
 #include "third_party/blink/public/common/features.h"
 
 namespace blink {
@@ -27,6 +29,17 @@ void ApproximatedDeviceMemory::Initialize() {
 
 // static
 float ApproximatedDeviceMemory::GetApproximatedDeviceMemory() {
+  // Camoucrome: the configured navigator.deviceMemory, so the Device-Memory
+  // client hints (browser: navigations; renderer: subresources) and
+  // navigator.deviceMemory, which reads this too, report one value. Hot()
+  // already dropped a value stock never reports (not a power of two in
+  // [2, 32]); then, and with no config, the real value as stock.
+  // GlobalScope(): there is no ExecutionContext here, and ScopeFor() returns
+  // it anyway.
+  if (const std::optional<double>& configured =
+          camoucfg::Hot(camoucfg::GlobalScope()).navigator_device_memory) {
+    return static_cast<float>(*configured);
+  }
   return approximated_device_memory_gb_;
 }
 
