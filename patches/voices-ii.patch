+void SpeechSynthesis::ApplyCamouVoices() {
+  std::vector<camoucfg::VoiceConfig> voices =
+      camoucfg::GetVoices(camoucfg::ScopeFor(nullptr));
+  if (voices.empty()) {
+    return;  // rule 5: no config -> leave the real list
+  }
+  voice_list_.clear();
+  for (const camoucfg::VoiceConfig& v : voices) {
+    auto mojom_voice = mojom::blink::SpeechSynthesisVoice::New();
+    mojom_voice->voice_uri = String::FromUtf8(v.voice_uri);
+    mojom_voice->name = String::FromUtf8(v.name);
+    mojom_voice->lang = String::FromUtf8(v.lang);
+    mojom_voice->is_local_service = v.is_local_service;
+    mojom_voice->is_default = v.is_default;
+    voice_list_.push_back(
+        MakeGarbageCollected<SpeechSynthesisVoice>(std::move(mojom_voice)));
+  }
+  camou_voices_applied_ = true;
+}
