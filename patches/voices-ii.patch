+namespace {
+// voices-ii: interval a deferred fake task waits before re-checking is_paused_.
+// Pause/resume timing is not a measured surface, so this is coarse on purpose --
+// larger keeps the pathological case (kMaxBoundaryEvents tasks all polling
+// during an indefinite pause) cheaper without any observable cost.
+constexpr base::TimeDelta kFakePausePollInterval = base::Milliseconds(100);
+}  // namespace
+
+void SpeechSynthesis::MaybeFireFakeBoundary(SpeechSynthesisUtterance* u,
+                                            uint64_t generation,
+                                            unsigned char_index,
+                                            unsigned char_length) {
+  // Same staleness guard the inline lambda used: a cancel()'d speak bumps the
+  // generation and/or changes CurrentSpeechUtterance, retiring this task.
+  if (!u || camou_fake_generation_ != generation ||
+      u != CurrentSpeechUtterance()) {
+    return;
+  }
+  if (is_paused_) {
+    // Defer past the pause rather than drop: re-post self and re-check shortly.
+    // The guard above still retires it if the speak is cancelled while paused.
+    // ponytail: 50 ms poll is coarse, but pause/resume timing is not a measured
+    // surface, so a finer poll buys nothing.
+    GetSupplementable()
+        ->GetTaskRunner(TaskType::kMiscPlatformAPI)
+        ->PostDelayedTask(FROM_HERE,
+                          BindOnce(&SpeechSynthesis::MaybeFireFakeBoundary,
+                                   WrapWeakPersistent(this),
+                                   WrapWeakPersistent(u), generation, char_index,
+                                   char_length),
+                          kFakePausePollInterval);
+    return;
+  }
+  WordBoundaryEventOccurred(u, char_index, char_length);
+  // Decremented only on the actual fire (not on the stale-guard or paused-defer
+  // paths above), so it counts boundaries still owed for THIS speak.
+  if (camou_pending_boundaries_) {
+    --camou_pending_boundaries_;
+  }
+}
+
+void SpeechSynthesis::MaybeFinishFakeSpeak(SpeechSynthesisUtterance* u,
+                                           uint64_t generation) {
+  if (!u || camou_fake_generation_ != generation ||
+      u != CurrentSpeechUtterance()) {
+    return;
+  }
+  // Defer while paused, AND while boundary events are still owed: a pause/resume
+  // reorders the delayed tasks, so 'end' could otherwise fire first, remove the
+  // utterance from the queue, and retire the still-pending boundaries (they see
+  // u != CurrentSpeechUtterance()). Waiting for the count keeps 'end' last, as a
+  // real backend does. Must defer, never drop -- a dropped 'end' leaves
+  // speechSynthesis.speaking true forever, a worse tell than the one this closes.
+  if (is_paused_ || camou_pending_boundaries_ > 0) {
+    GetSupplementable()
+        ->GetTaskRunner(TaskType::kMiscPlatformAPI)
+        ->PostDelayedTask(FROM_HERE,
+                          BindOnce(&SpeechSynthesis::MaybeFinishFakeSpeak,
+                                   WrapWeakPersistent(this),
+                                   WrapWeakPersistent(u), generation),
+                          kFakePausePollInterval);
+    return;
+  }
+  DidFinishSpeaking(u, mojom::blink::SpeechSynthesisErrorCode::kNoError);
+}
